{
  "name": "talia-ui",
  "private": true,
  "version": "0.4.0",
  "description": "Talia Platform - Frontend UI (Alpha)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "build:staging": "bash ../scripts/build-ui-staging.sh",
    "build:mvp": "bash ../scripts/build-ui-mvp.sh",
    "lint": "eslint .",
    "check:standards": "node ./scripts/check-component-standards.mjs && node ./scripts/check-data-boundary.mjs",
    "check:standards:strict": "node ./scripts/check-component-standards.mjs --strict && node ./scripts/check-data-boundary.mjs --strict",
    "build:field-usage": "node ./scripts/build-tabulator-field-usage.mjs",
    "build:lineage-tables": "node ./scripts/build-data-lineage-panel-tables.mjs",
    "verify:arcade": "node ./scripts/verify-arcade-panels.mjs",
    "verify:theme-pack": "node ./scripts/verify-theme-export-pack.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^4.0.3",
    "@supabase/ssr": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "4.5.0",
    "dockview": "4.9.0",
    "graphql": "^16.11.0",
    "leaflet": "^1.9.4",
    "mermaid": "^12.2.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "tabulator-tables": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@supabase/supabase-js": "^2.85.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
