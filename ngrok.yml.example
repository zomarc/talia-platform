version: "3"

# ngrok configuration for Talia Platform
# Copy this file to ngrok.yml and configure with your settings
# DO NOT commit ngrok.yml with credentials to version control

tunnels:
  celestyal:
    proto: http
    addr: 5173
    domain: taliahub.com
    # Basic HTTP Authentication (username:password)
    # Add your credentials here - DO NOT commit real passwords
    basic_auth:
      - "username:password"
      # Add more users as needed:
      # - "client1:password123"
      # - "client2:password456"
    
    # IP Whitelisting - Only allow specific IP addresses or CIDR ranges
    # Uncomment and add IP addresses to enable:
    # ip_restriction:
    #   allow_cidrs:
    #     - "203.0.113.0/24"  # Example: Allow entire subnet
    #     - "198.51.100.1/32"  # Example: Allow single IP
    #   deny_cidrs:
    #     - "0.0.0.0/0"  # Example: Deny all others (only allow_cidrs will work)
    
    # Request headers - Add custom headers to all requests
    # request_header:
    #   add:
    #     - "X-Custom-Header: value"
    
    # Response headers - Add custom headers to all responses
    # response_header:
    #   add:
    #     - "X-Frame-Options: DENY"
    #     - "X-Content-Type-Options: nosniff"

