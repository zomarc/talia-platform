# Shared target/environment configuration for ops scripts.
# Override any value by exporting it before running a script.

# Local development target
LOCAL_UI_HOST=127.0.0.1
LOCAL_UI_PORT=5173
# Public presenter for local (ngrok → vite preview). Vite-dev :5173 is edit/HMR only —
# tunneling the module graph over ngrok routinely stalls the HTML boot screen.
LOCAL_PUBLIC_UI_PORT=4173
LOCAL_GRAPHQL_HOST=127.0.0.1
LOCAL_GRAPHQL_PORT=4000

# Azure staging VM (optional — for scripts/deploy-to-azure-staging.sh)
# AZURE_STAGING_USER=azureuser
# AZURE_STAGING_HOST=
# AZURE_STAGING_DIR=/home/azureuser/talia-docker

# MVP / Celestyal Azure instance. Deploy from laptop: ./scripts/deploy-to-mvp.sh --full (local tar + dist over SSH only).
# SSH alias: celestyal-talia (IdentityFile ~/.ssh/id_ed25519_client_tunnel)
MVP_VALIDATE=1
MVP_LABEL="Celestyal Azure"
MVP_SSH_USER=talia-dev
MVP_SSH_HOST=57.153.122.125
MVP_APP_DIR=/home/talia-dev/talia-docker
# MVP_DOCKER_COMPOSE="sudo docker compose"   # default; matches deploy-to-mvp.sh on Azure
MVP_UI_HOST=57.153.122.125
MVP_UI_PORT=5173
MVP_GRAPHQL_PORT=4000
# Supabase Kong: compose maps host 8000 and 54321 to the same gateway. Azure NSG may block both from the internet;
# ./scripts/validate then probes via SSH on the VM and/or GraphQL supabaseConnectionStatus.
MVP_KONG_PORT=54321
# Optional laptop SSH tunnels when NSG blocks public ports (ssh -L … celestyal-talia).
# validate check/status probes these when listening locally.
MVP_TUNNEL_UI_PORT=25173
MVP_TUNNEL_GRAPHQL_PORT=24000
MVP_TUNNEL_KONG_PORT=25432
MVP_DATA_MOUNT=/mnt/talia-data
# PostgREST / theme+focus sync from laptop: export these locally before running scripts.
# Never commit Supabase JWTs here, especially service-role tokens.
MVP_SUPABASE_SERVICE_ROLE_KEY=
MVP_SUPABASE_ANON_KEY=

# Previous personal Azure MVP (retired / unreachable) — kept for reference only:
# MVP_SSH_USER=azureuser
# MVP_SSH_HOST=20.3.116.22
# MVP_APP_DIR=/home/azureuser/talia-docker
# MVP_UI_HOST=20.3.116.22

# Staging target (MiniPC)
STAGING_SSH_USER=zomarc
STAGING_SSH_HOST=192.168.1.120
STAGING_APP_DIR=/home/zomarc/talia-docker
# STAGING_REMOTE_DOCKER_COMPOSE="docker compose"   # default for SSH from laptop (no sudo on MiniPC)
STAGING_UI_HOST=192.168.1.120
STAGING_UI_PORT=5173
STAGING_SUPABASE_KONG_PORT=8000
STAGING_NGROK_SERVICE=ngrok-taliahub

# Public external endpoints
# PUBLIC_DEV_URL = share with clients (Start Demo / discuss). Prefer this over apex.
# PUBLIC_MAIN_URL = reserved ngrok domain / legacy probes (same tunnel as dev.).
PUBLIC_MAIN_URL=https://taliahub.com
PUBLIC_DEV_URL=https://dev.taliahub.com
PUBLIC_SECONDARY_URL=https://celestyal.taliahub.com
NGROK_BASIC_USER=talia
NGROK_BASIC_PASS=dev2025tal
# 0 = no browser login wall on https://dev.taliahub.com (use for live client demos)
NGROK_BASIC_AUTH=0

# Connectivity expectations (laptop local / Synapse firewall whitelist)
# Proton UK#11 exit — Azure Synapse only allows this static VPN egress IP.
# ./scripts/validate status checks public egress via api.ipify.org and alerts on mismatch.
VPN_EXPECTED_EGRESS_IP=149.40.48.92
