# Shared target/environment configuration for ops scripts.
# Override any value by exporting it before running a script.

# Local development target
LOCAL_UI_HOST=127.0.0.1
LOCAL_UI_PORT=5173
LOCAL_GRAPHQL_HOST=127.0.0.1
LOCAL_GRAPHQL_PORT=4000

# Azure staging VM (optional — for scripts/deploy-to-azure-staging.sh)
# AZURE_STAGING_USER=azureuser
# AZURE_STAGING_HOST=
# AZURE_STAGING_DIR=/home/azureuser/talia-docker

# MVP — personal Azure Docker test instance (name: mvp). Shown in ./scripts/validate when MVP_VALIDATE=1.
MVP_VALIDATE=1
MVP_SSH_USER=azureuser
MVP_SSH_HOST=20.3.116.22
MVP_APP_DIR=/home/azureuser/talia-docker
MVP_UI_HOST=20.3.116.22
MVP_UI_PORT=5173
MVP_GRAPHQL_PORT=4000
MVP_KONG_PORT=54321

# Staging target (MiniPC)
STAGING_SSH_USER=zomarc
STAGING_SSH_HOST=192.168.1.120
STAGING_APP_DIR=/home/zomarc/talia-docker
STAGING_UI_HOST=192.168.1.120
STAGING_UI_PORT=5173
STAGING_SUPABASE_KONG_PORT=8000
STAGING_NGROK_SERVICE=ngrok-taliahub

# Public external endpoints
PUBLIC_MAIN_URL=https://taliahub.com
PUBLIC_SECONDARY_URL=https://celestyal.taliahub.com
NGROK_BASIC_USER=talia
NGROK_BASIC_PASS=dev2025tal

# Connectivity expectations
VPN_EXPECTED_EGRESS_IP=149.40.48.92
