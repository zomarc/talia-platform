    5|ui-hot|hot|hot-sync)
      mode="--ui-hot"
      token="DEPLOY_UI_ONLY"
      timeout_sec="420"
      label="ui-hot-sync"
      ;;
    2|full)
      mode="--full"
      token="DEPLOY_FULL_STACK"
      deploy_xtra="DEPLOY_EXPLICIT_FULL_STACK=1 "
      timeout_sec="1800"
      label="full"
      ;;
    3|scripts|scripts-only|config)
      mode="--scripts-only"
      token="DEPLOY_SCRIPTS_ONLY"
      timeout_sec="300"
      label="scripts+config"
      ;;
    4|themes-db|themes|ui-themes-db|appearance-db)
      deploy_ui_themes_db_to_staging
      return $?
      ;;
    0|back|q|quit|exit)
      return 0
