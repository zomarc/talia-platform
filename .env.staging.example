# Copy to .env.staging on the server (do not commit real secrets).
# Usage from repo root:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
# With Caddy (HTTPS):
#   docker compose --env-file .env.staging -f docker-compose.staging.yml -f infra/azure/docker-compose.caddy.yml up -d
#
# MVP / cloned DB: always set POSTGRES_PASSWORD here (same value PostgREST uses). After a backup restore,
# run scripts/supabase/align-db-role-passwords.sh --from-running-postgrest, then
# scripts/supabase/write-postgres-password-from-postgrest-to-env.sh .env.staging — or use
# scripts/restore-db-to-mvp.sh which does both. Prefer data changes only via backup/restore; keep
# TALIA_SYNAPSE_SYNC_DISABLED=1 unless you intentionally run Synapse sync on this host.

# --- Public URLs (use your Azure FQDN or custom domain; must match what the browser loads) ---
# Plain HTTP (no Caddy): use http://YOUR_IP:54321 and http://YOUR_IP:4000/graphql
# With Caddy on 443: use https://YOUR_DOMAIN (no port); Kong and GraphQL are path-routed on the same host
SUPABASE_PUBLIC_URL=https://talia-staging.example.com
VITE_SUPABASE_URL=https://talia-staging.example.com
# Use /api/graphql so the UI nginx proxies to graphql-server (same origin as the SPA).
VITE_GRAPHQL_ENDPOINT=https://talia-staging.example.com/api/graphql
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me
VITE_ENABLE_DEV_MODE=true

# Caddy (infra/azure/docker-compose.caddy.yml)
TALIA_TLS_DOMAIN=talia-staging.example.com

# --- Supabase stack (rotate for any new environment; must stay consistent across services) ---
POSTGRES_PASSWORD=change-me-long-random
SUPABASE_JWT_SECRET=change-me-at-least-32-chars-random
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GoTrue redirect allowlist (comma-separated origins)
GOTRUE_URI_ALLOW_LIST=https://talia-staging.example.com,http://127.0.0.1:3000,http://localhost:3000

# --- Optional: Synapse (defaults match compose if unset) ---
# AZURE_SYNAPSE_SERVER=
# AZURE_SYNAPSE_PASSWORD=
# Block all Synapse → DB sync (recommended on MVP / public staging unless you are actively syncing):
TALIA_SYNAPSE_SYNC_DISABLED=1
