{
  "defaultDataset": "sept-dec-2025",
  "tables": {
    "ships": {
      "type": "direct",
      "source": "dwh.Dim_Ship",
      "target": "ship",
      "columns": [
        "Ship_Id",
        "Ship_Code",
        "Ship_Name",
        "Ship_Pax_Capacity",
        "Ship_Length",
        "Ship_Tonnage"
      ],
      "transformKey": "ships",
      "defaultReplace": {
        "strategy": "delete-all",
        "column": "id"
      }
    },
    "cabinAvailability": {
      "type": "direct",
      "source": "dwh.Dim_Cabin_Availability",
      "target": "cabin_availability",
      "columns": [
        "[Snapshot_Date]",
        "[Sail_Code]",
        "[Package_Name]",
        "[Sail_Days]",
        "[Cabin_Category]",
        "[Available_Cabins]",
        "[Total_Cabins]",
        "[Available_Absolute]",
        "[Available_Weighted]",
        "[Availability_Result]",
        "[Nested_Cabins]"
      ],
      "transformKey": "cabinAvailability"
    },
    "reservations": {
      "type": "direct",
      "source": "dwh.Fact_Reservation_History",
      "target": "reservation",
      "columns": [
        "[WC_Snapshot_Date]",
        "[Group_ID]",
        "[Res_ID]",
        "[Ship]",
        "[Sail_code]",
        "[Sail_From_Date]",
        "[Sail_To_Date]",
        "[Agency_ID]",
        "[Cabin_Category]",
        "[Guest_Count]",
        "[Pax_Status]",
        "[Group_Status]",
        "[Res_Status]",
        "[GrossSellingFare]",
        "[NetSellingFare]"
      ],
      "transformKey": "reservations",
      "isLargeDataset": true,
      "rowNumberOrder": [
        "[Res_ID]"
      ]
    },
    "publishedRates": {
      "type": "direct",
      "source": "fou.GQL_PUBLISHED_RATES",
      "target": "published_rates",
      "columns": [
        "[SNAPSHOT_DATE]",
        "[SAIL_CODE]",
        "[SHIP_CODE]",
        "[PACKAGE_NAME]",
        "[REGION]",
        "[RATE_TYPE]",
        "[SAIL_DAYS]",
        "[DEPARTURE_DATE]",
        "[CABIN_CATEGORY]",
        "[PROMO_NAME]",
        "[PROMO_TYPE]",
        "[CURRENCY_CODE]",
        "[FARE_PER_PERSON]",
        "[PORT_TAXES_SERVICES]",
        "[EXTRA_ADULT]",
        "[EXTRA_CHILD]",
        "[DISCOUNT]"
      ],
      "transformKey": "publishedRates"
    },
    "sailByCabinOccupancy": {
      "type": "direct",
      "source": "dwh.Dim_Sail_By_Cabin_Occupancy",
      "target": "sail_by_cabin_occupancy",
      "columns": [
        "[Sail_ID]",
        "[Sail_Code]",
        "[Sail_Days]",
        "[Sail_Date_From]",
        "[Master_Voyage]",
        "[Sail_Itinerary_Date]",
        "[Sail_Itinerary_Night]",
        "[Port_Code]",
        "[Ship_Code]",
        "[Ship_name]",
        "[Package_Type]",
        "[Package_Name]",
        "[Geog_Area_Code]",
        "[Season_Code]",
        "[IS_Fake]",
        "[IS_Active]",
        "[IS_Package_Active]",
        "[Cabin_Category]",
        "[Cabin_Capacity]",
        "[Total_Cabins]",
        "[Occupied_Cabins]",
        "[Remaining_Cabins]"
      ],
      "transformKey": "sailByCabinOccupancy"
    },
    "reservationChanges": {
      "type": "derived",
      "handler": "reservationChanges",
      "source": "fou.Fact_Reservation_daily",
      "target": "reservation_changes",
      "columns": [
        "Snapshot_Date",
        "RES_ID",
        "Sail_code",
        "Agency_ID",
        "Group_ID",
        "Guest_Count"
      ],
      "dateColumn": "Snapshot_Date",
      "supabaseDateColumn": "snapshot_date",
      "rowNumberOrder": [
        "[RES_ID]",
        "[Snapshot_Date]"
      ]
    },
    "masterSail": {
      "type": "direct",
      "source": "dwh.Dim_Master_Sail",
      "target": "master_sail",
      "columns": [
        "[Sail_ID]",
        "[Ship_Code]",
        "[Ship_Name]",
        "[Sail_Date_From]",
        "[Port_From]",
        "[Sail_Date_To]",
        "[Port_To]",
        "[Package_ID]",
        "[Package_Type]",
        "[Sail_Code]",
        "[Package_Name]",
        "[Sail_Days]",
        "[Geog_Area_Code]",
        "[Vacation_Date]",
        "[Season_Code]",
        "[IS_Fake]",
        "[IS_Active]",
        "[IS_Package_Active]",
        "[Master_Voyage_Departure_Date]",
        "[Master_Voyage1]",
        "[Master_Voyage1_Length]",
        "[Master_Voyage1_Sail_Days]",
        "[Master_Voyage2]",
        "[Master_Voyage2_Length]",
        "[Master_Voyage2_Sail_Days]",
        "[IS_Main]",
        "[IS_Primary]"
      ],
      "transformKey": "masterSail",
      "defaultReplace": {
        "strategy": "delete-range",
        "column": "sail_date_from"
      }
    }
  },
  "datasets": {
    "sept-dec-2025": {
      "description": "Core sailing, reservation, and change data for September through December 2025",
      "tableSequence": [
        "ships",
        "masterSail",
        "cabinAvailability",
        "sailByCabinOccupancy",
        "reservations",
        "publishedRates",
        "reservationChanges"
      ],
      "tables": {
        "ships": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "cabinAvailability": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "reservations": {
          "filters": [
            {
              "column": "[Sail_From_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_from_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "publishedRates": {
          "filters": [
            {
              "column": "[DEPARTURE_DATE]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "departure_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "sailByCabinOccupancy": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "reservationChanges": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "masterSail": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        }
      }
    }
  }
}

