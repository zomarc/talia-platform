#!/bin/bash
#
# Interactive Talia Validation Menu
# Calls underlying validation scripts based on user selection
#
# Usage:
#   ./scripts/validate                    # Interactive: full probe once at start; cached OPS header each menu (10 = refresh probes)
#   ./scripts/validate set-target local|staging|mvp
#   ./scripts/validate check              # Deep checks for current working target only
#   ./scripts/validate start-core | stop-core
#   ./scripts/validate external-on | external-off
#   ./scripts/validate comprehensive      # Full validate-staging.sh (slow)
#   ./scripts/validate deploy-themes-db   # Upsert UI themes + focus definitions → staging and/or MVP DB (no code deploy)
#   ./scripts/validate deploy-mvp         # Deploy to MVP (Azure); uses scripts/deploy-to-mvp.sh
#   ./scripts/validate executive-overview-pdf   # Regenerate docs/EXECUTIVE-OVERVIEW.pdf from branded HTML
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# Monotonic ops token (not a calendar stamp). Bump when validate menu behavior or Instance & keys cross-check changes.
SCRIPT_VERSION="ops-8"
CONFIG_FILE="${SCRIPT_DIR}/config/targets.env"
if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"
fi

# Colors (ANSI-C quoting so codes are real ESC bytes — printf '%s' does not interpret \033 like echo -e)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

locale_supports_utf8() {
  local lc
  lc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
  [[ "$lc" == *"UTF-8"* || "$lc" == *"utf8"* || "$lc" == *"UTF8"* ]]
}

# Detect environment
HOSTNAME=$(hostname)
IS_ON_STAGING=false
if [[ "$HOSTNAME" == "zomarcsvr" ]] || [[ -f "${STAGING_APP_DIR:-/home/zomarc/talia-docker}/docker-compose.staging.yml" ]]; then
  IS_ON_STAGING=true
fi

# Resolved target variables (configurable for future environments)
STAGING_USER="${STAGING_USER:-${STAGING_SSH_USER:-zomarc}}"
STAGING_HOST="${STAGING_HOST:-${STAGING_SSH_HOST:-192.168.1.120}}"
STAGING_DIR="${STAGING_DIR:-${STAGING_APP_DIR:-/home/${STAGING_USER}/talia-docker}}"
STAGING_NGROK_SERVICE="${STAGING_NGROK_SERVICE:-ngrok-taliahub}"

LOCAL_UI_URL="${LOCAL_UI_URL:-http://${LOCAL_UI_HOST:-127.0.0.1}:${LOCAL_UI_PORT:-5173}}"
LOCAL_PUBLIC_UI_PORT="${LOCAL_PUBLIC_UI_PORT:-4173}"
LOCAL_PUBLIC_UI_URL="${LOCAL_PUBLIC_UI_URL:-http://${LOCAL_UI_HOST:-127.0.0.1}:${LOCAL_PUBLIC_UI_PORT}}"
LOCAL_GRAPHQL_URL="${LOCAL_GRAPHQL_URL:-http://${LOCAL_GRAPHQL_HOST:-127.0.0.1}:${LOCAL_GRAPHQL_PORT:-4000}/graphql}"
LOCAL_SUPABASE_HOST="${LOCAL_SUPABASE_HOST:-127.0.0.1}"
LOCAL_SUPABASE_KONG_PORT="${LOCAL_SUPABASE_KONG_PORT:-54321}"
LOCAL_SUPABASE_URL="${LOCAL_SUPABASE_URL:-http://${LOCAL_SUPABASE_HOST}:${LOCAL_SUPABASE_KONG_PORT}/}"
STAGING_UI_URL="${STAGING_UI_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_UI_PORT:-5173}}"
STAGING_GRAPHQL_URL="${STAGING_GRAPHQL_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_GRAPHQL_PORT:-4000}/graphql}"
if $IS_ON_STAGING; then
  DEFAULT_STAGING_SUPABASE_KONG_PORT=8000
else
  DEFAULT_STAGING_SUPABASE_KONG_PORT=54321
fi
STAGING_SUPABASE_KONG_PORT="${STAGING_SUPABASE_KONG_PORT:-${DEFAULT_STAGING_SUPABASE_KONG_PORT}}"
STAGING_SUPABASE_URL="${STAGING_SUPABASE_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_SUPABASE_KONG_PORT}/}"
STAGING_SUPABASE_ANON_KEY="${STAGING_SUPABASE_ANON_KEY:-${STAGING_UI_SUPABASE_ANON_KEY:-sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH}}"
STAGING_SUPABASE_SERVICE_ROLE_KEY="${STAGING_SUPABASE_SERVICE_ROLE_KEY:-}"

# MVP (Azure test instance — scripts/backup-local-db-for-mvp.sh, restore-db-to-mvp.sh)
MVP_VALIDATE="${MVP_VALIDATE:-0}"
MVP_UI_HOST="${MVP_UI_HOST:-}"
MVP_UI_PORT="${MVP_UI_PORT:-5173}"
MVP_GRAPHQL_PORT="${MVP_GRAPHQL_PORT:-4000}"
MVP_KONG_PORT="${MVP_KONG_PORT:-54321}"
MVP_UI_URL="${MVP_UI_URL:-http://${MVP_UI_HOST}:${MVP_UI_PORT}}"
MVP_GRAPHQL_URL="${MVP_GRAPHQL_URL:-http://${MVP_UI_HOST}:${MVP_GRAPHQL_PORT}/graphql}"
MVP_SUPABASE_URL="${MVP_SUPABASE_URL:-http://${MVP_UI_HOST}:${MVP_KONG_PORT}/}"
# Do not default MVP anon to staging — wrong project and often sb_publishable_* (PostgREST returns 401 / JWSError).
MVP_SUPABASE_ANON_KEY="${MVP_SUPABASE_ANON_KEY:-${MVP_UI_SUPABASE_ANON_KEY:-}}"
MVP_SUPABASE_SERVICE_ROLE_KEY="${MVP_SUPABASE_SERVICE_ROLE_KEY:-}"
# SSH used when Kong is UP on the VM but host ports are not reachable from the validate machine (e.g. Azure NSG).
MVP_SSH_USER="${MVP_SSH_USER:-azureuser}"
MVP_SSH_HOST="${MVP_SSH_HOST:-${MVP_UI_HOST:-}}"
MVP_SSH_BASE_OPTS="${MVP_SSH_BASE_OPTS:--o ConnectTimeout=6 -o ConnectionAttempts=1 -o BatchMode=yes}"
# Same compose file as staging; app dir on MVP VM (override in targets.env if different).
MVP_APP_DIR="${MVP_APP_DIR:-/home/${MVP_SSH_USER}/talia-docker}"
MVP_DOCKER_COMPOSE="${MVP_DOCKER_COMPOSE:-sudo docker compose}"
# Optional: docker compose command when driving staging over SSH from your laptop (no sudo on MiniPC).
STAGING_REMOTE_DOCKER_COMPOSE="${STAGING_REMOTE_DOCKER_COMPOSE:-docker compose}"
# Local Postgres container for disk report (docker-compose.staging service supabase-db).
LOCAL_SUPABASE_DB_CONTAINER="${LOCAL_SUPABASE_DB_CONTAINER:-talia-supabase-db}"

PUBLIC_MAIN_URL="${PUBLIC_MAIN_URL:-https://taliahub.com}"
# Laptop discussion portal (same ngrok tunnel as apex; Worker remaps Host).
PUBLIC_DEV_URL="${PUBLIC_DEV_URL:-https://dev.taliahub.com}"
# Optional: GraphQL URL for public row in "Deployed versions" (defaults to /api/graphql on same host).
PUBLIC_GRAPHQL_PROBE_URL="${PUBLIC_GRAPHQL_PROBE_URL:-${PUBLIC_MAIN_URL%/}/api/graphql}"
PUBLIC_SECONDARY_URL="${PUBLIC_SECONDARY_URL:-https://celestyal.taliahub.com}"
NGROK_BASIC_USER="${NGROK_BASIC_USER:-talia}"
NGROK_BASIC_PASS="${NGROK_BASIC_PASS:-dev2025tal}"
STAGING_SSH_TARGET="${STAGING_USER}@${STAGING_HOST}"
# Keep ConnectTimeout short: remote/VPN runs must fail fast when MiniPC LAN is unreachable.
STAGING_SSH_BASE_OPTS="${STAGING_SSH_BASE_OPTS:--o ConnectTimeout=2 -o ConnectionAttempts=1 -o ServerAliveInterval=2 -o ServerAliveCountMax=1 -o BatchMode=yes}"
STAGING_SSH_READY_ATTEMPTS="${STAGING_SSH_READY_ATTEMPTS:-5}"
STAGING_REMOTE_CMD_RETRIES="${STAGING_REMOTE_CMD_RETRIES:-2}"
# Wall-clock cap for status/presenter SSH probes (separate from deploy/start which use longer budgets).
STAGING_STATUS_SSH_TIMEOUT_SEC="${STAGING_STATUS_SSH_TIMEOUT_SEC:-2}"
LOCAL_NGROK_DOMAIN="${LOCAL_NGROK_DOMAIN:-${PUBLIC_MAIN_URL#https://}}"
LOCAL_NGROK_DOMAIN="${LOCAL_NGROK_DOMAIN#http://}"

# External target memory (persists across runs)
TARGET_STATE_FILE="${TARGET_STATE_FILE:-${HOME}/.talia-validate-last-target}"
# Snapshot of endpoint checks + deployed rows (bash-sourced to redraw with live ▶ markers). Written on full probe.
VALIDATE_SUMMARY_PROBE_STATE_FILE="${VALIDATE_SUMMARY_PROBE_STATE_FILE:-${HOME}/.talia-validate-last-summary.state}}"
# Optional full ANSI transcript (e.g. menu 11 summary notes).
VALIDATE_SUMMARY_CACHE_FILE="${VALIDATE_SUMMARY_CACHE_FILE:-${HOME}/.talia-validate-last-summary.txt}"

get_http_code() {
  local url="$1"
  curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "$url" 2>/dev/null || echo "000"
}

get_ui_version() {
  local base_url="$1"
  python3 - "$base_url" <<'PY'
import json
import re
import sys
import urllib.request

base = sys.argv[1].rstrip("/")


def version_from_html(html: str):
    m = re.search(
        r'<meta\s+name=["\']talia-app-version["\']\s+content=["\'](\d+\.\d+\.\d+)["\']',
        html,
        re.I,
    )
    return m.group(1) if m else None


def version_from_json_blob(raw: str):
    try:
        data = json.loads(raw)
    except Exception:
        return None
    v = data.get("taliaAppVersion") or data.get("version")
    if isinstance(v, str) and re.fullmatch(r"\d+\.\d+\.\d+", v):
        return v
    return None


def best_guess_from_deps_noise(js: str):
    """Last resort only: Talia app line is 0.x / 1.x. Reject IPs (20.3.116…), Node (19.2.4…), etc."""
    cands = set(re.findall(r"\b(\d{1,3}\.\d{1,3}\.\d{1,3})\b", js))
    ok = []
    for s in cands:
        if not re.fullmatch(r"(0|1)\.\d{1,4}\.\d{1,4}", s):
            continue
        parts = [int(x) for x in s.split(".")]
        a, b, c = parts
        if a == 0 and b == 0 and c == 0:
            continue
        ok.append(s)
    if not ok:
        return None
    return sorted(ok, key=lambda x: tuple(int(p) for p in x.split(".")), reverse=True)[0]


try:
    html = urllib.request.urlopen(f"{base}/", timeout=4).read().decode("utf-8", "ignore")
except Exception:
    print("UNREACHABLE")
    raise SystemExit(0)

v = version_from_html(html)
if v:
    print(v)
    raise SystemExit(0)

try:
    jraw = urllib.request.urlopen(f"{base}/talia-app-version.json", timeout=4).read().decode(
        "utf-8", "ignore"
    )
    v = version_from_json_blob(jraw)
    if v:
        print(v)
        raise SystemExit(0)
except Exception:
    pass

asset_match = re.search(r'assets/index-[^"\']+\.js', html)
if not asset_match:
    print("NO_ASSET")
    raise SystemExit(0)

asset = asset_match.group(0)
try:
    js = urllib.request.urlopen(f"{base}/{asset}", timeout=4).read().decode("utf-8", "ignore")
except Exception:
    print("NO_BUNDLE")
    raise SystemExit(0)

guess = best_guess_from_deps_noise(js)
if guess:
    print(guess)
else:
    print("UNKNOWN")
PY
}

collect_ui_port_pids() {
  if ! command -v lsof >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true
}

collect_ui_fallback_port_pids() {
  if ! command -v lsof >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  { lsof -nP -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null; lsof -nP -iTCP:5175 -sTCP:LISTEN -t 2>/dev/null; } | tr '\n' ' ' | xargs || true
}

get_pid_cwd() {
  local pid="$1"
  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
}

stop_port_processes() {
  local pids="$1"
  local description="$2"
  if [[ -n "$pids" ]]; then
    kill $pids 2>/dev/null || true
    sleep 1
    kill -9 $pids 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} Stopped ${description}"
  else
    echo -e "  ${DIM}No processes for ${description}${NC}"
  fi
}

verify_ui_port_owner() {
  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"
  local pids
  pids=$(lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true)
  [[ -z "$pids" ]] && return 0

  local invalid=0
  local pid
  for pid in $pids; do
    local cwd cmd
    cwd=$(get_pid_cwd "$pid")
    cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
    if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
      continue
    fi
    echo -e "  ${RED}✗ Port 5173 is occupied by non-Talia process${NC}"
    echo -e "  ${YELLOW}  PID:${NC} ${pid}"
    echo -e "  ${YELLOW}  CWD:${NC} ${cwd:-unknown}"
    echo -e "  ${YELLOW}  CMD:${NC} ${cmd:-unknown}"
    invalid=1
  done

  if [[ "$invalid" -eq 1 ]]; then
    echo -e "  ${RED}Refusing to start local UI. Port 5173 must be owned by talia-ui only.${NC}"
    return 1
  fi
  return 0
}

get_local_source_version() {
  python3 - "$ROOT_DIR" <<'PY'
import json
import os
import sys

root = sys.argv[1]
path = os.path.join(root, "talia-ui", "package.json")
try:
    with open(path, "r", encoding="utf-8") as f:
        print(json.load(f).get("version", "UNKNOWN"))
except Exception:
    print("UNKNOWN")
PY
}

extract_ui_semver_from_label() {
  local label="$1"
  if [[ "$label" =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo ""
  fi
}

host_port_from_ui_url() {
  python3 - "$1" <<'PY'
import sys, urllib.parse
p = urllib.parse.urlparse(sys.argv[1])
h = p.hostname or "?"
print(f"{h}:{p.port}" if p.port else h)
PY
}

# Prints graphqlServerPackageVersion|nodeRuntimeVersion|nodeEnv or n/a|n/a|n/a
graphql_instance_profile_probe() {
  local gql_url="$1"
  local gql_code="$2"
  case "$gql_code" in
    200|400|405) ;;
    *) echo "n/a|n/a|n/a"; return 0 ;;
  esac
  python3 - "$gql_url" <<'PY'
import json
import sys
import urllib.error
import urllib.request

url = sys.argv[1]

QUERIES = [
    (
        "full",
        "query ValidateInstanceProfile { instanceConnectionProfile { "
        "graphqlServerPackageVersion nodeRuntimeVersion nodeEnv } }",
    ),
    (
        "compat",
        "query ValidateInstanceCompat { instanceConnectionProfile { "
        "graphqlServerPackageVersion nodeEnv } }",
    ),
]


def post(query: str):
    payload = json.dumps({"query": query}).encode()
    req = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=12) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode())
        except Exception:
            return None
    except Exception:
        return None


def emit(prof, include_node: bool):
    if not prof:
        print("n/a|n/a|n/a")
        return

    def f(key):
        v = prof.get(key)
        return str(v).strip() if v is not None else "n/a"

    node = f("nodeRuntimeVersion") if include_node else "n/a"
    print(f"{f('graphqlServerPackageVersion')}|{node}|{f('nodeEnv')}")


for name, q in QUERIES:
    body = post(q)
    if not body or body.get("errors"):
        continue
    prof = (body.get("data") or {}).get("instanceConnectionProfile")
    if not prof:
        continue
    emit(prof, include_node=(name == "full"))
    raise SystemExit(0)

print("n/a|n/a|n/a")
PY
}

get_display_version() {
  local url="$1"
  local version
  version=$(get_ui_version "$url")
  if [[ "$version" == "NO_ASSET" && "$url" == "$LOCAL_UI_URL" ]]; then
    local local_src
    local_src=$(get_local_source_version)
    if [[ "$local_src" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      echo "${local_src} (dev)"
      return 0
    fi
  fi
  echo "$version"
}

is_supported_target() {
  case "$1" in
    local|staging) return 0 ;;
    mvp)
      [[ "$MVP_VALIDATE" == "1" && -n "${MVP_SSH_HOST:-}" ]]
      return $?
      ;;
    *) return 1 ;;
  esac
}

get_target_direct_url() {
  case "$1" in
    local) echo "$LOCAL_UI_URL" ;;
    staging) echo "$STAGING_UI_URL" ;;
    mvp) echo "$MVP_UI_URL" ;;
    *) echo "" ;;
  esac
}

get_target_external_state() {
  local target="$1"
  case "$target" in
    local)
      if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
        echo "active"
      else
        echo "inactive"
      fi
      ;;
    staging)
      if $IS_ON_STAGING; then
        sudo systemctl is-active "$STAGING_NGROK_SERVICE" 2>/dev/null || echo "inactive"
      else
        local status
        # sudo -n avoids a password prompt; short wall-clock cap for remote/VPN fail-fast
        status=$(ssh_staging_with_timeout "${STAGING_STATUS_SSH_TIMEOUT_SEC}" \
          "sudo -n systemctl is-active $STAGING_NGROK_SERVICE 2>/dev/null || echo inactive" | head -n 1)
        [[ -z "$status" ]] && status="unreachable"
        echo "$status"
      fi
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

remember_target() {
  local target="$1"
  if ! is_supported_target "$target"; then
    return 1
  fi
  printf "%s\n" "$target" > "$TARGET_STATE_FILE"
}

get_remembered_target() {
  if [[ ! -f "$TARGET_STATE_FILE" ]]; then
    echo ""
    return 0
  fi
  local saved
  saved=$(tr -d '[:space:]' < "$TARGET_STATE_FILE" 2>/dev/null || true)
  if is_supported_target "$saved"; then
    echo "$saved"
  else
    echo ""
  fi
}

# Probe public demo headers once. Sets PUBLIC_PROBE_CODE and PUBLIC_PROBE_GATEWAY.
probe_public_gateway_headers() {
  local headers
  headers=$(curl -sS -I --connect-timeout 2 --max-time 2 "${PUBLIC_MAIN_URL}/" 2>/dev/null || true)
  PUBLIC_PROBE_CODE=$(echo "$headers" | awk 'BEGIN{c="000"} NR==1{c=$2} END{print c}')
  PUBLIC_PROBE_GATEWAY=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
  # Use if/fi (not [[ ]] &&) — bash 3.2 + set -e treats a failing final [[ as function failure.
  if [[ -z "$PUBLIC_PROBE_CODE" ]]; then
    PUBLIC_PROBE_CODE="000"
  fi
  if [[ -z "$PUBLIC_PROBE_GATEWAY" ]]; then
    PUBLIC_PROBE_GATEWAY="n/a"
  fi
  return 0
}

# Cloudflare holding page: HTTP 503 + X-TaliaHub-Gateway: fallback (see cloudflare-worker/index.js).
public_is_holding_page() {
  local code="${1:-}"
  local gateway="${2:-}"
  if [[ -z "$code" || -z "$gateway" ]]; then
    probe_public_gateway_headers
    code="$PUBLIC_PROBE_CODE"
    gateway="$PUBLIC_PROBE_GATEWAY"
  fi
  if [[ "$gateway" == "fallback" || "$code" == "503" ]]; then
    return 0
  fi
  return 1
}

# True when Cloudflare still proxies a live ngrok origin (app or basic-auth challenge).
public_tunnel_appears_live() {
  local code gateway
  probe_public_gateway_headers
  code="$PUBLIC_PROBE_CODE"
  gateway="$PUBLIC_PROBE_GATEWAY"
  if public_is_holding_page "$code" "$gateway"; then
    return 1
  fi
  if [[ "$gateway" == "proxied" || "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ]]; then
    return 0
  fi
  return 1
}

# Fetch public UI semver using basic-auth from targets.env (401 without auth is normal).
probe_public_ui_semver() {
  local body ver
  body=$(curl -sS -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" --connect-timeout 2 --max-time 3 \
    "${PUBLIC_MAIN_URL%/}/talia-app-version.json" 2>/dev/null | tr -d '\r' | head -c 4000 || true)
  ver=$(extract_talia_app_version "$body")
  if [[ -z "$ver" ]]; then
    body=$(curl -sS -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" --connect-timeout 2 --max-time 3 \
      "${PUBLIC_MAIN_URL%/}/" 2>/dev/null | tr -d '\r' | head -c 4000 || true)
    ver=$(extract_talia_app_version "$body")
  fi
  printf '%s' "$ver"
}

# Deployed-versions Public row: agree with External presenter + show version when probeable.
public_ui_version_label() {
  local presenter="$1"
  local pub_code="$2"
  local gateway="$3"
  local src ver

  case "$presenter" in
    local) src="LOCAL" ;;
    staging) src="STAGING" ;;
    conflict) src="CONFLICT" ;;
    orphan) src="ORPHAN" ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        echo "holding page"
        return 0
      fi
      echo "n/a (DOWN)"
      return 0
      ;;
    *) src="UNKNOWN" ;;
  esac

  if [[ "$gateway" == "proxied" ]] || [[ "$pub_code" == "200" || "$pub_code" == "302" || "$pub_code" == "401" || "$pub_code" == "403" ]]; then
    ver=$(probe_public_ui_semver)
    if [[ -n "$ver" ]]; then
      echo "v${ver} (${src})"
    else
      echo "UP (${src})"
    fi
    return 0
  fi

  if public_is_holding_page "$pub_code" "$gateway"; then
    echo "holding page"
    return 0
  fi
  echo "n/a (${src})"
}

# Extract semver from talia-app-version.json body or HTML meta fallback.
extract_talia_app_version() {
  local body="$1"
  local ver=""
  ver=$(printf '%s' "$body" | python3 -c '
import sys, re, json
s = sys.stdin.read()
try:
    d = json.loads(s)
    if isinstance(d, dict):
        for k in ("taliaAppVersion", "version", "appVersion"):
            if d.get(k):
                print(d[k]); raise SystemExit
    if isinstance(d, str) and d.strip():
        print(d.strip()); raise SystemExit
except Exception:
    pass
m = re.search(r"talia-app-version\"\s+content=\"([^\"]+)\"", s)
if m:
    print(m.group(1)); raise SystemExit
m = re.search(r"\b(\d+\.\d+\.\d+)\b", s)
print(m.group(1) if m else "")
' 2>/dev/null || true)
  printf '%s' "$ver"
}

# Fingerprint public UI version against known hosts (best-effort presenter hint).
infer_public_backend_hint() {
  local pub_body loc_body st_body mvp_body
  local pub_ver loc_ver st_ver mvp_ver
  pub_body=$(curl -sS -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" --connect-timeout 2 --max-time 3 \
    "${PUBLIC_MAIN_URL}/talia-app-version.json" 2>/dev/null | tr -d '\r' | head -c 4000 || true)
  pub_ver=$(extract_talia_app_version "$pub_body")
  if [[ -z "$pub_ver" ]]; then
    pub_body=$(curl -sS -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" --connect-timeout 2 --max-time 3 \
      "${PUBLIC_MAIN_URL}/" 2>/dev/null | tr -d '\r' | head -c 4000 || true)
    pub_ver=$(extract_talia_app_version "$pub_body")
  fi
  [[ -z "$pub_ver" ]] && { echo "unknown"; return 0; }

  loc_body=$(curl -sS --connect-timeout 1 --max-time 2 "${LOCAL_UI_URL%/}/talia-app-version.json" 2>/dev/null | head -c 4000 || true)
  loc_ver=$(extract_talia_app_version "$loc_body")
  if [[ -z "$loc_ver" ]]; then
    loc_body=$(curl -sS --connect-timeout 1 --max-time 2 "${LOCAL_UI_URL%/}/" 2>/dev/null | head -c 4000 || true)
    loc_ver=$(extract_talia_app_version "$loc_body")
  fi
  st_body=$(curl -sS --connect-timeout 1 --max-time 2 "${STAGING_UI_URL%/}/talia-app-version.json" 2>/dev/null | head -c 4000 || true)
  st_ver=$(extract_talia_app_version "$st_body")
  mvp_ver=""
  if [[ "$MVP_VALIDATE" == "1" && -n "${MVP_UI_HOST:-}" ]]; then
    mvp_body=$(curl -sS --connect-timeout 1 --max-time 2 "${MVP_UI_URL%/}/talia-app-version.json" 2>/dev/null | head -c 4000 || true)
    mvp_ver=$(extract_talia_app_version "$mvp_body")
  fi

  if [[ -n "$mvp_ver" && "$pub_ver" == "$mvp_ver" && ( -z "$loc_ver" || "$pub_ver" != "$loc_ver" ) && ( -z "$st_ver" || "$pub_ver" != "$st_ver" ) ]]; then
    echo "matches-mvp-v${pub_ver} (unusual — MVP is not the ngrok path)"
  elif [[ -n "$st_ver" && "$pub_ver" == "$st_ver" && ( -z "$loc_ver" || "$pub_ver" != "$loc_ver" ) ]]; then
    echo "matches-staging-v${pub_ver}"
  elif [[ -n "$loc_ver" && "$pub_ver" == "$loc_ver" && ( -z "$st_ver" || "$pub_ver" != "$st_ver" ) && ( -z "$mvp_ver" || "$pub_ver" != "$mvp_ver" ) ]]; then
    if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
      echo "matches-local-v${pub_ver}"
    else
      echo "public-v${pub_ver} equals local UI build, but local ngrok is off (orphan elsewhere; often MiniPC)"
    fi
  elif [[ -n "$mvp_ver" && "$pub_ver" == "$mvp_ver" ]]; then
    echo "v${pub_ver} also equals MVP (and possibly others) — prefer direct ${MVP_UI_URL}"
  else
    echo "public-v${pub_ver}; local=${loc_ver:-n/a} staging=${st_ver:-n/a} mvp=${mvp_ver:-n/a}"
  fi
}

get_current_target() {
  local local_ngrok
  local staging_ngrok
  local presenter

  local_ngrok=$(get_target_external_state "local")
  staging_ngrok=$(get_target_external_state "staging")

  presenter="unknown"
  if [[ "$local_ngrok" == "active" && "$staging_ngrok" != "active" ]]; then
    presenter="local"
  elif [[ "$local_ngrok" != "active" && "$staging_ngrok" == "active" ]]; then
    presenter="staging"
  elif [[ "$local_ngrok" == "active" && "$staging_ngrok" == "active" ]]; then
    presenter="conflict"
  elif [[ "$local_ngrok" != "active" && "$staging_ngrok" != "active" ]]; then
    # Working-target "local" does not control DNS. If Cloudflare still proxies a live
    # tunnel we cannot see from this host (e.g. MiniPC ngrok while LAN SSH is down),
    # report orphan so ops do not think the public URL is off or is MVP.
    if public_tunnel_appears_live; then
      presenter="orphan"
    else
      presenter="none"
    fi
  fi

  echo "$presenter"
}

get_effective_working_target() {
  local remembered
  remembered=$(get_remembered_target)
  if [[ -n "$remembered" ]]; then
    echo "$remembered"
    return 0
  fi
  if $IS_ON_STAGING; then
    echo "staging"
  else
    echo "local"
  fi
}

get_http_code_quick() {
  local url="$1"
  local max_time="${2:-2}"
  local connect_timeout="${3:-}"
  local out
  # Default connect timeout to max_time so unreachable LAN hosts fail in 1–2s, not hang.
  if [[ -z "$connect_timeout" ]]; then
    connect_timeout="$max_time"
  fi
  out=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout "$connect_timeout" --max-time "$max_time" "$url" 2>/dev/null) || true
  if [[ -z "$out" ]]; then
    echo "000"
  else
    echo "$out"
  fi
}

# docker-compose.staging.yml maps Kong to both 54321 and 8000; some clouds only expose one.
# Sets MVP_SUPABASE_KONG_LIVE_PORT and MVP_SUPABASE_KONG_LIVE_CODE for the summary line.
mvp_supabase_kong_quick_probe() {
  local host="$1"
  local primary="${2:-54321}"
  local p code
  MVP_SUPABASE_KONG_LIVE_PORT=""
  MVP_SUPABASE_KONG_LIVE_CODE="000"
  # Always exit 0: probe result is in MVP_SUPABASE_KONG_LIVE_* (set -e would abort callers on return 1).
  [[ -z "$host" ]] && return 0
  local try_order=("$primary")
  for p in 8000 54321; do
    [[ "$p" == "$primary" ]] && continue
    try_order+=("$p")
  done
  for p in "${try_order[@]}"; do
    code=$(get_http_code_quick "http://${host}:${p}/" 1)
    if [[ "$code" != "000" ]]; then
      MVP_SUPABASE_KONG_LIVE_PORT="$p"
      MVP_SUPABASE_KONG_LIVE_CODE="$code"
      return 0
    fi
  done
  MVP_SUPABASE_KONG_LIVE_PORT="$primary"
  MVP_SUPABASE_KONG_LIVE_CODE="000"
  return 0
}

# If direct curls to MVP public IP failed, Kong may still be healthy on the VM (firewall/NSG).
# Sets MVP_SUPABASE_KONG_LIVE_* and MVP_SUPABASE_KONG_NOTE when a fallback succeeds.
mvp_supabase_kong_mvp_fallbacks() {
  MVP_SUPABASE_KONG_NOTE=""
  [[ "${MVP_SUPABASE_KONG_LIVE_CODE:-000}" != "000" ]] && return 0
  [[ "$MVP_VALIDATE" != "1" || -z "${MVP_UI_HOST:-}" ]] && return 0

  if [[ -n "${MVP_SSH_HOST:-}" ]]; then
    local out u
    u="${MVP_SSH_USER}@${MVP_SSH_HOST}"
    out=$(ssh ${MVP_SSH_BASE_OPTS} "$u" \
      'for p in 8000 54321; do c=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 2 "http://127.0.0.1:${p}/" 2>/dev/null || echo 000); if [[ "$c" != "000" && -n "$c" ]]; then echo "$p $c"; exit 0; fi; done; exit 1' \
      2>/dev/null) || true
    if [[ -n "$out" ]]; then
      MVP_SUPABASE_KONG_LIVE_PORT="${out%% *}"
      MVP_SUPABASE_KONG_LIVE_CODE="${out#* }"
      MVP_SUPABASE_KONG_NOTE="(Kong UP on VM :${MVP_SUPABASE_KONG_LIVE_PORT}; not reachable from this host — open NSG or use SSH tunnel)"
      return 0
    fi
  fi

  local body
  body=$(curl -sS --max-time 4 -X POST "${MVP_GRAPHQL_URL}" -H 'Content-Type: application/json' \
    -d '{"query":"{ supabaseConnectionStatus { online } }"}' 2>/dev/null) || true
  if echo "$body" | grep -q '"online"[[:space:]]*:[[:space:]]*true'; then
    MVP_SUPABASE_KONG_LIVE_CODE="404"
    MVP_SUPABASE_KONG_LIVE_PORT="${MVP_KONG_PORT:-54321}"
    MVP_SUPABASE_KONG_NOTE="(Supabase OK via GraphQL; direct Kong from this host failed)"
    return 0
  fi
  return 0
}

# Typed confirmation before any ngrok / public tunnel start. Non-TTY: set TALIA_CONFIRM_NGROK=ENABLE_NGROK_EXTERNAL.
confirm_ngrok_external_start() {
  local summary="${1:-Start ngrok / external presenter}"
  if [[ "${TALIA_CONFIRM_NGROK:-}" == "ENABLE_NGROK_EXTERNAL" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo -e "${RED}Refusing ngrok: ${summary}${NC}" >&2
    echo -e "${YELLOW}Not a TTY. To proceed: export TALIA_CONFIRM_NGROK=ENABLE_NGROK_EXTERNAL${NC}" >&2
    return 1
  fi
  echo ""
  echo -e "${YELLOW}${BOLD}External presenter (ngrok)${NC}"
  echo -e "  ${summary}"
  echo -e "  ${DIM}Maps ${PUBLIC_MAIN_URL} to your stack. Only continue if you intend that.${NC}"
  echo ""
  echo -n "Type ENABLE_NGROK_EXTERNAL to confirm: "
  read -r typed
  if [[ "$typed" != "ENABLE_NGROK_EXTERNAL" ]]; then
    echo -e "${YELLOW}Cancelled — ngrok not started.${NC}"
    return 1
  fi
  return 0
}

# Lighter gate for Start Demo (menu D / start-demo). Choosing Demo is the intent.
confirm_start_demo() {
  if [[ "${TALIA_CONFIRM_DEMO:-}" == "1" || "${TALIA_CONFIRM_NGROK:-}" == "ENABLE_NGROK_EXTERNAL" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo -e "${RED}Refusing Start Demo (not a TTY).${NC}" >&2
    echo -e "${YELLOW}To proceed: export TALIA_CONFIRM_DEMO=1${NC}" >&2
    return 1
  fi
  echo ""
  echo -e "${BOLD}Start Demo${NC} — publish this laptop to ${GREEN}${PUBLIC_DEV_URL}${NC}"
  echo -e "  ${DIM}Rebuilds vite preview :${LOCAL_PUBLIC_UI_PORT:-4173} and points ngrok at it (not Vite-dev).${NC}"
  echo -e "  ${DIM}Apex ${PUBLIC_MAIN_URL} shares the same tunnel.${NC}"
  echo ""
  echo -n "Press Enter to publish (or n to cancel): "
  read -r ans
  if [[ "$ans" == "n" || "$ans" == "N" || "$ans" == "no" || "$ans" == "NO" ]]; then
    echo -e "${YELLOW}Cancelled — demo not started.${NC}"
    return 1
  fi
  return 0
}

# One-shot: local discuss portal. Prefer this over generic external-on for client demos.
start_demo_local() {
  if ! confirm_start_demo; then
    return 1
  fi

  remember_target "local" || true

  echo ""
  echo -e "${CYAN}${BOLD}Start Demo${NC}${CYAN} — laptop → ${PUBLIC_DEV_URL}${NC}"

  local gql_url="http://${LOCAL_GRAPHQL_HOST:-127.0.0.1}:${LOCAL_GRAPHQL_PORT:-4000}/graphql"
  local gql_code
  gql_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 \
    -H 'Content-Type: application/json' \
    -d '{"query":"{ __typename }"}' \
    "$gql_url" 2>/dev/null || echo "000")
  if [[ "$gql_code" != "200" ]]; then
    echo -e "  ${YELLOW}GraphQL not healthy on :${LOCAL_GRAPHQL_PORT:-4000} (HTTP ${gql_code}).${NC}"
    echo -e "  ${DIM}UI can still publish; API calls may fail until you run start-core.${NC}"
  else
    echo -e "  ${GREEN}✓${NC} GraphQL OK (:${LOCAL_GRAPHQL_PORT:-4000})"
  fi

  apply_target_external "local" || return 1

  echo ""
  echo -e "${BOLD}Demo URL:${NC} ${GREEN}${PUBLIC_DEV_URL}${NC}"
  echo -e "  ${DIM}Auth: ${NGROK_BASIC_USER:-talia} / (see NGROK_BASIC_PASS)${NC}"
  echo -e "  ${DIM}Edit stays on http://127.0.0.1:${LOCAL_UI_PORT:-5173} — re-run Start Demo after UI changes.${NC}"

  local headers code gateway
  headers=$(curl -sSI --max-time 10 -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" "${PUBLIC_DEV_URL%/}/" 2>/dev/null || true)
  code=$(echo "$headers" | awk 'NR==1{print $2}')
  gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
  [[ -z "$code" ]] && code="000"
  if [[ "$gateway" == "proxied" && ( "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ) ]]; then
    echo -e "  ${GREEN}✓${NC} ${PUBLIC_DEV_URL} reachable (HTTP ${code}, gateway=${gateway})"
  else
    echo -e "  ${YELLOW}Probe ${PUBLIC_DEV_URL}: HTTP ${code}, gateway=${gateway:-n/a}${NC}"
    echo -e "  ${DIM}If holding/orphan: stop other ngrok claimers, then re-run Start Demo.${NC}"
  fi
}

# Run SSH remote command with a hard wall-clock limit (avoids rare hangs).
ssh_staging_with_timeout() {
  local sec="$1"
  shift
  local outf pidf killer
  outf=$(mktemp "${TMPDIR:-/tmp}/talia-ssh-out.XXXXXX")
  pidf=$(mktemp "${TMPDIR:-/tmp}/talia-ssh-pid.XXXXXX")
  ssh $STAGING_SSH_BASE_OPTS "$STAGING_SSH_TARGET" "$@" >"$outf" 2>/dev/null &
  echo $! >"$pidf"
  ( sleep "$sec"; kill "$(cat "$pidf" 2>/dev/null)" 2>/dev/null || true ) &
  killer=$!
  wait "$(cat "$pidf")" 2>/dev/null || true
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
  cat "$outf" 2>/dev/null || true
  rm -f "$outf" "$pidf"
}

check_staging_ssh_ready() {
  if $IS_ON_STAGING; then
    return 0
  fi

  local attempt out cleaned last_error attempts
  attempts="${STAGING_SSH_READY_ATTEMPTS}"
  echo -e "  Checking SSH reachability to ${STAGING_SSH_TARGET}..."
  for ((attempt=1; attempt<=attempts; attempt++)); do
    out=$(ssh_staging_with_timeout 8 "echo ok")
    cleaned=$(echo "$out" | tr -d '\r' | awk 'NF{print; exit}')
    if [[ "$cleaned" == "ok" ]]; then
      echo -e "  ${GREEN}✓${NC} SSH reachable (attempt ${attempt}/${attempts})"
      return 0
    fi
    if [[ -n "$cleaned" ]]; then
      last_error="$cleaned"
      echo -e "  ${DIM}Attempt ${attempt}/${attempts} failed: ${cleaned}${NC}"
    else
      last_error="timeout/no response"
      echo -e "  ${DIM}Attempt ${attempt}/${attempts} failed: timeout/no response${NC}"
    fi
    sleep 1
  done

  echo -e "  ${RED}✗ Cannot reach staging over SSH (${STAGING_SSH_TARGET})${NC}"
  echo -e "  ${YELLOW}Last error:${NC} ${last_error}"
  echo -e "  ${YELLOW}Check VPN/LAN path and SSH service on ${STAGING_HOST}:${NC}22"
  return 1
}

run_staging_ssh_command() {
  local remote_cmd="$1"
  local desc="$2"
  local timeout_sec="${3:-60}"
  local attempt rc retries

  retries="${STAGING_REMOTE_CMD_RETRIES}"
  for ((attempt=1; attempt<=retries; attempt++)); do
    check_staging_ssh_ready || return 1
    echo -e "  ${DIM}Remote attempt ${attempt}/${retries}${NC}"
    run_command "ssh ${STAGING_SSH_BASE_OPTS} ${STAGING_SSH_TARGET} \"$remote_cmd\"" "$desc" "$timeout_sec"
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      return 0
    fi
    if [[ "$attempt" -lt "$retries" ]]; then
      echo -e "  ${YELLOW}Retrying remote command after failure (exit ${rc})...${NC}"
      sleep 2
    fi
  done
  return "$rc"
}

check_mvp_ssh_ready() {
  [[ -n "${MVP_SSH_HOST:-}" ]] || return 1
  local out
  out=$(ssh ${MVP_SSH_BASE_OPTS} "${MVP_SSH_USER}@${MVP_SSH_HOST}" "echo ok" 2>/dev/null | tr -d '\r' | awk 'NF{print; exit}')
  [[ "$out" == "ok" ]]
}

run_mvp_ssh_command() {
  local remote_cmd="$1"
  local desc="$2"
  local timeout_sec="${3:-90}"

  if ! check_mvp_ssh_ready; then
    echo -e "  ${RED}✗ Cannot reach MVP over SSH (${MVP_SSH_USER}@${MVP_SSH_HOST})${NC}"
    return 1
  fi
  run_command "ssh ${MVP_SSH_BASE_OPTS} ${MVP_SSH_USER}@${MVP_SSH_HOST} \"$remote_cmd\"" "$desc" "$timeout_sec"
}

is_quick_up() {
  local code="$1"
  local kind="$2"
  if [[ "$kind" == "gql" ]]; then
    [[ "$code" == "200" || "$code" == "400" ]]
    return $?
  fi
  if [[ "$kind" == "kong" ]]; then
    case "$code" in
      200|301|302|401|403|404) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [[ "$code" == "200" || "$code" == "302" ]]
}

target_status_label() {
  local target="$1"
  local loc_ui="$2" loc_gql="$3" loc_sb="$4"
  local st_ui="$5" st_gql="$6" st_sb="$7"
  if [[ "$target" == "local" ]]; then
    if is_quick_up "$loc_ui" "ui" && is_quick_up "$loc_gql" "gql" && is_quick_up "$loc_sb" "kong" && is_docker_ready; then
      echo -e "${GREEN}UP${NC}"
    else
      echo -e "${YELLOW}DOWN${NC}"
    fi
    return 0
  fi
  if [[ "$target" == "staging" ]]; then
    if is_quick_up "$st_ui" "ui" && is_quick_up "$st_gql" "gql" && is_quick_up "$st_sb" "kong"; then
      echo -e "${GREEN}UP${NC}"
    else
      echo -e "${YELLOW}DOWN${NC}"
    fi
    return 0
  fi
  echo -e "${DIM}UNKNOWN${NC}"
}

target_status_plain() {
  local target="$1"
  local loc_ui="$2" loc_gql="$3" loc_sb="$4"
  local st_ui="$5" st_gql="$6" st_sb="$7"
  if [[ "$target" == "local" ]]; then
    if is_quick_up "$loc_ui" "ui" && is_quick_up "$loc_gql" "gql" && is_quick_up "$loc_sb" "kong" && is_docker_ready; then
      echo "UP"
    else
      echo "DOWN"
    fi
    return 0
  fi
  if [[ "$target" == "staging" ]]; then
    if is_quick_up "$st_ui" "ui" && is_quick_up "$st_gql" "gql" && is_quick_up "$st_sb" "kong"; then
      echo "UP"
    else
      echo "DOWN"
    fi
    return 0
  fi
  echo "UNKNOWN"
}

external_status_label() {
  local presenter="$1"
  local pub_code="$2"
  local gateway="$3"
  local src

  case "$presenter" in
    local|staging) src=$(echo "$presenter" | tr '[:lower:]' '[:upper:]') ;;
    conflict) src="CONFLICT" ;;
    orphan) src="ORPHAN" ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        echo -e "${YELLOW}OFF${NC} (HOLDING)"
        return 0
      fi
      src="NONE"
      ;;
    *) src="UNKNOWN" ;;
  esac

  if [[ "$presenter" == "local" || "$presenter" == "staging" || "$presenter" == "orphan" ]]; then
    if [[ "$gateway" == "proxied" ]] || [[ "$pub_code" == "200" || "$pub_code" == "302" || "$pub_code" == "401" || "$pub_code" == "403" ]]; then
      echo -e "${GREEN}UP${NC} (${src})"
      return 0
    fi
  fi
  echo -e "${YELLOW}DOWN${NC} (${src})"
}

external_status_plain() {
  local presenter="$1"
  local pub_code="$2"
  local gateway="$3"
  local src status="DOWN"

  case "$presenter" in
    local|staging) src=$(echo "$presenter" | tr '[:lower:]' '[:upper:]') ;;
    conflict) src="CONFLICT" ;;
    orphan) src="ORPHAN" ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        echo "OFF (HOLDING)"
        return 0
      fi
      src="NONE"
      ;;
    *) src="UNKNOWN" ;;
  esac

  if [[ "$presenter" == "local" || "$presenter" == "staging" || "$presenter" == "orphan" ]]; then
    if [[ "$gateway" == "proxied" ]] || [[ "$pub_code" == "200" || "$pub_code" == "302" || "$pub_code" == "401" || "$pub_code" == "403" ]]; then
      status="UP"
    fi
  fi
  echo "${status} (${src})"
}

deployed_versions_print_row() {
  local marker="$1" title="$2" hostport="$3" talia_ui="$4" prof="$5"
  local pkg node env
  IFS='|' read -r pkg node env <<< "$prof"
  printf "  %s %-9s  %-24s  %-14s  %-12s  %-16s  %s\n" "$marker" "$title" "$hostport" "$talia_ui" \
    "${pkg:-n/a}" "${node:-n/a}" "${env:-n/a}"
}

_validate_summary_ms_now() {
  python3 -c "import time; print(int(time.time() * 1000))"
}

validate_summary_timing_reset() {
  local now
  now=$(_validate_summary_ms_now)
  _VALIDATE_SUMMARY_T0="$now"
  _VALIDATE_SUMMARY_LAST="$now"
}

# Log elapsed ms since previous step (or reset), then advance the interval marker.
validate_summary_log_step() {
  local label="$1"
  local now elapsed
  now=$(_validate_summary_ms_now)
  elapsed=$((now - _VALIDATE_SUMMARY_LAST))
  printf '  %b%7d ms%b\t%s\n' "$DIM" "$elapsed" "$NC" "$label"
  _VALIDATE_SUMMARY_LAST=$now
}

validate_summary_log_total() {
  local now total
  now=$(_validate_summary_ms_now)
  total=$((now - _VALIDATE_SUMMARY_T0))
  printf '  %b%7d ms%b\t%b%s%b\n' "$DIM" "$total" "$NC" "$BOLD" "total (quick summary)" "$NC"
  echo ""
}

# Persist endpoint codes + deployed rows for menu redraw (live working-target ▶ markers).
validate_summary_snapshot_write_v1() {
  local tmp="${VALIDATE_SUMMARY_PROBE_STATE_FILE}.new.$$"
  umask 077
  {
    echo '# talia-validate summary snapshot v1'
    printf 'loc_ui=%q\n' "$1"
    printf 'loc_gql=%q\n' "$2"
    printf 'loc_sb=%q\n' "$3"
    printf 'st_ui=%q\n' "$4"
    printf 'st_gql=%q\n' "$5"
    printf 'st_sb=%q\n' "$6"
    printf 'mvp_ui=%q\n' "$7"
    printf 'mvp_gql=%q\n' "$8"
    printf 'mvp_sb=%q\n' "$9"
    printf 'mvp_kong_line_suffix=%q\n' "${10}"
    printf 'mvp_kong_hostport=%q\n' "${11}"
    printf 'pub_code=%q\n' "${12}"
    printf 'gateway=%q\n' "${13}"
    printf 'loc_hp=%q\n' "${14}"
    printf 'st_hp=%q\n' "${15}"
    printf 'pub_hp=%q\n' "${16}"
    printf 'mvp_hp=%q\n' "${17}"
    printf 'loc_ui_version=%q\n' "${18}"
    printf 'st_ui_version=%q\n' "${19}"
    printf 'pub_ui_version=%q\n' "${20}"
    printf 'mvp_ui_version=%q\n' "${21}"
    printf 'loc_gql_prof=%q\n' "${22}"
    printf 'st_gql_prof=%q\n' "${23}"
    printf 'pub_gql_prof=%q\n' "${24}"
    printf 'mvp_gql_prof=%q\n' "${25}"
    printf 'mvp_section=%q\n' "${26}"
  } >"$tmp" && mv "$tmp" "${VALIDATE_SUMMARY_PROBE_STATE_FILE}"
}

_emit_validate_summary_endpoints() {
  local local_marker="$1" staging_marker="$2"
  echo ""
  echo -e "${BOLD}Endpoints${NC}"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "Local" "${LOCAL_UI_HOST}:${LOCAL_UI_PORT} UI" "$(quick_up_label "$loc_ui" "200")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "${LOCAL_GRAPHQL_HOST}:${LOCAL_GRAPHQL_PORT} GraphQL" "$(quick_up_label "$loc_gql" "gql")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "${LOCAL_SUPABASE_HOST}:${LOCAL_SUPABASE_KONG_PORT} Supabase Kong" "$(quick_up_label "$loc_sb" "kong")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "Docker daemon (local)" "$(docker_status_label)"
  echo ""
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "Staging" "${STAGING_UI_HOST:-?}:${STAGING_UI_PORT} UI" "$(quick_up_label "$st_ui" "200")"
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "" "${STAGING_UI_HOST:-?}:${STAGING_GRAPHQL_PORT:-4000} GraphQL" "$(quick_up_label "$st_gql" "gql")"
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "" "${STAGING_UI_HOST:-?}:${STAGING_SUPABASE_KONG_PORT} Kong" "$(quick_up_label "$st_sb" "kong")"
  if [[ "${mvp_section}" == "1" ]]; then
    echo ""
    printf "  %s %-9s  %-36s  %s\n" " " "MVP" "${MVP_UI_HOST}:${MVP_UI_PORT} UI (Azure)" "$(quick_up_label "$mvp_ui" "200")"
    printf "  %s %-9s  %-36s  %s\n" " " "" "${MVP_UI_HOST}:${MVP_GRAPHQL_PORT} GraphQL" "$(quick_up_label "$mvp_gql" "gql")"
    printf "  %s %-9s  %-36s  %s%s\n" " " "" "${mvp_kong_hostport:-${MVP_UI_HOST}:${MVP_SUPABASE_KONG_LIVE_PORT:-${MVP_KONG_PORT:-54321}}} Supabase Kong" "$(quick_up_label "$mvp_sb" "kong")" "${mvp_kong_line_suffix:-}"
  fi
  echo ""
  printf "  %-10s  %-36s  HTTP %s  gateway=%s\n" "Discuss" "${PUBLIC_DEV_URL}" "${pub_code}" "${gateway}"
  printf "  %-10s  %-36s  %s\n" "Apex" "${PUBLIC_MAIN_URL}" "${DIM}same tunnel / legacy${NC}"
  echo -e "  ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod${NC}"
  echo ""
}

_emit_validate_summary_deployed_canonical() {
  local local_marker="$1" staging_marker="$2"
  echo -e "${BOLD}Deployed versions (per target)${NC}"
  echo -e "  ${DIM}Talia UI = static app release · GQL package = talia-server package.json · Node = GraphQL process runtime${NC}"
  echo ""
  printf "  %s %-9s  %-24s  %-14s  %-12s  %-16s  %s\n" "" "Target" "UI host:port" "Talia UI" "GQL package" "Node runtime" "NODE_ENV"
  echo -e "  ${DIM}$(printf '%-12s %-24s %-14s %-12s %-16s %-12s' '----------' '------------------------' '--------------' '------------' '----------------' '------------')${NC}"
  deployed_versions_print_row "$local_marker" "Local" "$loc_hp" "$loc_ui_version" "$loc_gql_prof"
  deployed_versions_print_row "$staging_marker" "Staging" "$st_hp" "$st_ui_version" "$st_gql_prof"
  if [[ "${mvp_section}" == "1" ]]; then
    deployed_versions_print_row " " "MVP" "$mvp_hp" "$mvp_ui_version" "$mvp_gql_prof"
  fi
  deployed_versions_print_row " " "Public" "$pub_hp" "$pub_ui_version" "$pub_gql_prof"

  local canonical_ui canon_sem loc_sem st_sem mvp_sem pub_sem
  canonical_ui=$(get_local_source_version)
  canon_sem=""
  [[ "$canonical_ui" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && canon_sem="$canonical_ui"
  if [[ -n "$canon_sem" ]]; then
    echo -e "  ${DIM}Canonical Talia app version (talia-ui/package.json → build meta + talia-app-version.json)${NC}  v${canon_sem}"
    loc_sem=$(extract_ui_semver_from_label "$loc_ui_version")
    st_sem=$(extract_ui_semver_from_label "$st_ui_version")
    pub_sem=$(extract_ui_semver_from_label "$pub_ui_version")
    mvp_sem=""
    if [[ "${mvp_section}" == "1" ]]; then
      mvp_sem=$(extract_ui_semver_from_label "$mvp_ui_version")
    fi
    local mismatch_lines=()
    [[ -n "$loc_sem" && "$loc_sem" != "$canon_sem" ]] && mismatch_lines+=("Local ${loc_ui_version} (expected v${canon_sem})")
    [[ -n "$st_sem" && "$st_sem" != "$canon_sem" ]] && mismatch_lines+=("Staging ${st_ui_version} (expected v${canon_sem})")
    if [[ "${mvp_section}" == "1" && -n "$mvp_sem" && "$mvp_sem" != "$canon_sem" ]]; then
      mismatch_lines+=("MVP ${mvp_ui_version} (expected v${canon_sem})")
    fi
    [[ -n "$pub_sem" && "$pub_sem" != "$canon_sem" ]] && mismatch_lines+=("Public ${pub_ui_version} (expected v${canon_sem})")
    if ((${#mismatch_lines[@]} > 0)); then
      echo -e "  ${YELLOW}⚠ Deployed UI bundles differ from repo canonical version.${NC}"
      local line
      for line in "${mismatch_lines[@]}"; do
        echo -e "    ${YELLOW}-${NC} ${line}"
      done
      echo -e "  ${DIM}Redeploy UI (e.g. deploy-to-staging.sh / deploy-to-mvp.sh) so hosts serve v${canon_sem}.${NC}"
    fi
  elif [[ "$canonical_ui" != "UNKNOWN" ]]; then
    echo -e "  ${YELLOW}⚠ Could not read canonical version from talia-ui/package.json (${canonical_ui}).${NC}"
  fi
  echo ""
}

print_validate_summary_body_from_state() {
  local f="${VALIDATE_SUMMARY_PROBE_STATE_FILE}"
  [[ -s "$f" ]] || return 1
  (
    # shellcheck disable=SC1090
    source "$f"
    local work local_marker staging_marker
    work=$(get_effective_working_target)
    local_marker=" "
    staging_marker=" "
    [[ "$work" == "local" ]] && local_marker="▶"
    [[ "$work" == "staging" ]] && staging_marker="▶"
    _emit_validate_summary_endpoints "$local_marker" "$staging_marker"
    _emit_validate_summary_deployed_canonical "$local_marker" "$staging_marker"
  )
}

# Live OPS banner (working target, presenter, light HTTP — no GraphQL instanceConnectionProfile).
_print_ops_summary_live_header() {
  local work presenter top_level_version ext_line
  local loc_ui loc_gql loc_sb st_ui st_gql st_sb pub_code gateway
  local loc_ui_version st_ui_version pub_ui_version mvp_ui mvp_ui_version
  local target_status_plain_text ext_status_plain_text work_u header_sep
  local validate_run_iso validate_run_local rem_disp

  work=$(get_effective_working_target)
  presenter=$(get_current_target)

  loc_ui=$(get_http_code_quick "${LOCAL_UI_URL}/" 1)
  loc_gql=$(get_http_code_quick "${LOCAL_GRAPHQL_URL%/}" 1)
  loc_sb=$(get_http_code_quick "${LOCAL_SUPABASE_URL}" 1)
  # Staging LAN probes: 1s connect+total — fail fast when MiniPC unreachable (remote/VPN).
  local st_ui_f st_gql_f st_sb_f
  st_ui_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-ui.XXXXXX")
  st_gql_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-gql.XXXXXX")
  st_sb_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-sb.XXXXXX")
  ( get_http_code_quick "${STAGING_UI_URL}/" 1 1 >"$st_ui_f" ) &
  ( get_http_code_quick "${STAGING_GRAPHQL_URL%/}" 1 1 >"$st_gql_f" ) &
  ( get_http_code_quick "${STAGING_SUPABASE_URL}" 1 1 >"$st_sb_f" ) &
  wait || true
  st_ui=$(cat "$st_ui_f" 2>/dev/null || echo 000)
  st_gql=$(cat "$st_gql_f" 2>/dev/null || echo 000)
  st_sb=$(cat "$st_sb_f" 2>/dev/null || echo 000)
  rm -f "$st_ui_f" "$st_gql_f" "$st_sb_f"

  probe_public_gateway_headers
  pub_code="$PUBLIC_PROBE_CODE"
  gateway="$PUBLIC_PROBE_GATEWAY"

  loc_ui_version=$(quick_ui_version_label "${LOCAL_UI_URL}" "${loc_ui}" "true")
  st_ui_version=$(quick_ui_version_label "${STAGING_UI_URL}" "${st_ui}" "false")
  pub_ui_version=$(public_ui_version_label "$presenter" "$pub_code" "$gateway")

  mvp_ui="000"
  mvp_ui_version="n/a"
  if [[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]]; then
    mvp_ui=$(get_http_code_quick "${MVP_UI_URL}/" 1)
    mvp_ui_version=$(quick_ui_version_label "${MVP_UI_URL}" "${mvp_ui}" "false")
  fi

  case "$presenter" in
    local)
      top_level_version="${loc_ui_version} (via local presenter)"
      ;;
    staging)
      top_level_version="${st_ui_version} (via staging presenter)"
      ;;
    conflict)
      top_level_version="CONFLICT (both local and staging presenters active)"
      ;;
    orphan)
      top_level_version="${pub_ui_version} (public tunnel live; not local/staging ngrok on this host)"
      ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        top_level_version="HOLDING PAGE (Cloudflare fallback · HTTP ${pub_code})"
      elif [[ "$pub_ui_version" == "n/a (DOWN)" ]]; then
        top_level_version="UNAVAILABLE (public gateway fallback/inactive)"
      else
        top_level_version="${pub_ui_version} (public)"
      fi
      ;;
    *)
      if [[ "$pub_ui_version" == "n/a (DOWN)" ]]; then
        top_level_version="UNAVAILABLE (public gateway fallback/inactive)"
      else
        top_level_version="${pub_ui_version} (public)"
      fi
      ;;
  esac

  case "$presenter" in
    local) ext_line="${GREEN}active → local${NC}" ;;
    staging) ext_line="${BLUE}active → staging${NC}" ;;
    conflict) ext_line="${RED}CONFLICT (local + staging both on)${NC}" ;;
    orphan) ext_line="${YELLOW}ORPHAN tunnel${NC} (live public; stop needs the host that owns ngrok)" ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        ext_line="${YELLOW}holding page${NC} (HTTP 503 · gateway=fallback)"
      else
        ext_line="${YELLOW}inactive${NC} (Cloudflare / holding page expected)"
      fi
      ;;
    *) ext_line="${DIM}unknown${NC}" ;;
  esac

  work_u=$(echo "$work" | tr '[:lower:]' '[:upper:]')
  target_status_plain_text=$(target_status_plain "$work" "$loc_ui" "$loc_gql" "$loc_sb" "$st_ui" "$st_gql" "$st_sb")
  ext_status_plain_text=$(external_status_plain "$presenter" "$pub_code" "$gateway")

  header_sep=$(printf '%*s' 96 '' | tr ' ' '-')
  validate_run_iso="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%d %H:%M:%S UTC')"
  validate_run_local="$(date '+%Y-%m-%d %H:%M:%S %Z (UTC%z)' 2>/dev/null || date)"
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${BOLD}TALIA OPS - ${work_u}${NC}"
  echo -e "Version: ${top_level_version}"
  echo -e "Target: ${target_status_plain_text}   External: ${ext_status_plain_text}"
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${DIM}Validate script: ${SCRIPT_VERSION}${NC}"
  echo -e "${DIM}Run at (UTC):   ${validate_run_iso}${NC}"
  echo -e "${DIM}Run at (local): ${validate_run_local} · host: ${HOSTNAME}${NC}"
  echo -e "  ${BOLD}Discuss portal${NC}: ${PUBLIC_DEV_URL} (${ext_line})"
  echo -e "  ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod · apex ${PUBLIC_MAIN_URL} = same tunnel${NC}"
  rem_disp=$(get_remembered_target)
  [[ -z "$rem_disp" ]] && rem_disp="(default by host)"
  echo -e "  ${DIM}Remembered target: ${rem_disp} (${TARGET_STATE_FILE/#$HOME/~})${NC}"
  if [[ "$presenter" == "orphan" ]]; then
    echo -e "  ${YELLOW}Hint:${NC} ${DIM}$(infer_public_backend_hint)${NC}"
  fi
  echo ""
}

_print_quick_targets_summary_impl() {
  local work presenter top_level_version
  local loc_ui loc_gql loc_sb st_ui st_gql st_sb pub_code gateway ext_line
  local loc_ui_version st_ui_version pub_ui_version
  local target_status_plain_text ext_status_plain_text
  local local_marker staging_marker
  local header_sep
  local mvp_ui mvp_gql mvp_sb mvp_ui_version

  echo -e "${DIM}Quick summary · startup sequence:${NC}"
  validate_summary_timing_reset

  work=$(get_effective_working_target)
  validate_summary_log_step "Working target (file / hostname default)"

  presenter=$(get_current_target)
  validate_summary_log_step "External presenter (ngrok state; may SSH to staging)"

  loc_ui=$(get_http_code_quick "${LOCAL_UI_URL}/" 1)
  loc_gql=$(get_http_code_quick "${LOCAL_GRAPHQL_URL%/}" 1)
  loc_sb=$(get_http_code_quick "${LOCAL_SUPABASE_URL}" 1)
  validate_summary_log_step "HTTP · local UI, GraphQL, Supabase Kong"

  # Staging LAN: 1s fail-fast when MiniPC is off-network (e.g. remote VPN).
  # Parallel probes so three unreachable ports cost ~1s wall-clock, not ~3s.
  local st_ui_f st_gql_f st_sb_f
  st_ui_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-ui.XXXXXX")
  st_gql_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-gql.XXXXXX")
  st_sb_f=$(mktemp "${TMPDIR:-/tmp}/talia-st-sb.XXXXXX")
  ( get_http_code_quick "${STAGING_UI_URL}/" 1 1 >"$st_ui_f" ) &
  ( get_http_code_quick "${STAGING_GRAPHQL_URL%/}" 1 1 >"$st_gql_f" ) &
  ( get_http_code_quick "${STAGING_SUPABASE_URL}" 1 1 >"$st_sb_f" ) &
  wait || true
  st_ui=$(cat "$st_ui_f" 2>/dev/null || echo 000)
  st_gql=$(cat "$st_gql_f" 2>/dev/null || echo 000)
  st_sb=$(cat "$st_sb_f" 2>/dev/null || echo 000)
  rm -f "$st_ui_f" "$st_gql_f" "$st_sb_f"
  validate_summary_log_step "HTTP · staging UI, GraphQL, Kong"

  mvp_ui="000"
  mvp_gql="000"
  mvp_sb="000"
  mvp_kong_line_suffix=""
  mvp_ui_version="n/a"
  if [[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]]; then
    mvp_ui=$(get_http_code_quick "${MVP_UI_URL}/" 1)
    mvp_gql=$(get_http_code_quick "${MVP_GRAPHQL_URL%/}" 1)
    mvp_supabase_kong_quick_probe "${MVP_UI_HOST}" "${MVP_KONG_PORT:-54321}"
    mvp_sb="${MVP_SUPABASE_KONG_LIVE_CODE}"
    mvp_supabase_kong_mvp_fallbacks
    mvp_sb="${MVP_SUPABASE_KONG_LIVE_CODE}"
    mvp_kong_line_suffix=""
    if [[ -n "${MVP_SUPABASE_KONG_NOTE:-}" ]]; then
      mvp_kong_line_suffix=" ${DIM}${MVP_SUPABASE_KONG_NOTE}${NC}"
    elif [[ -n "${MVP_SUPABASE_KONG_LIVE_PORT:-}" && "${MVP_SUPABASE_KONG_LIVE_PORT}" != "${MVP_KONG_PORT:-54321}" && "${mvp_sb}" != "000" ]]; then
      mvp_kong_line_suffix=" ${DIM}(reachable on :${MVP_SUPABASE_KONG_LIVE_PORT}; targets.env MVP_KONG_PORT=${MVP_KONG_PORT:-54321})${NC}"
    fi
    mvp_ui_version=$(quick_ui_version_label "${MVP_UI_URL}" "${mvp_ui}" "false")
    validate_summary_log_step "HTTP · MVP UI/GraphQL/Kong (+ SSH Kong fallback if needed)"
  fi

  local pub_headers
  probe_public_gateway_headers
  pub_code="$PUBLIC_PROBE_CODE"
  gateway="$PUBLIC_PROBE_GATEWAY"
  validate_summary_log_step "Public demo URL headers + X-Taliahub-Gateway"

  loc_ui_version=$(quick_ui_version_label "${LOCAL_UI_URL}" "${loc_ui}" "true")
  st_ui_version=$(quick_ui_version_label "${STAGING_UI_URL}" "${st_ui}" "false")
  pub_ui_version=$(public_ui_version_label "$presenter" "$pub_code" "$gateway")
  validate_summary_log_step "Deployed Talia UI version (meta / JSON / bundle per host)"

  local loc_hp st_hp pub_hp pub_gql pub_gql_prof
  local loc_gql_prof st_gql_prof mvp_gql_prof mvp_hp
  loc_hp=$(host_port_from_ui_url "${LOCAL_UI_URL}")
  st_hp=$(host_port_from_ui_url "${STAGING_UI_URL}")
  pub_hp=$(host_port_from_ui_url "${PUBLIC_MAIN_URL}")
  pub_gql=$(get_http_code_quick "${PUBLIC_GRAPHQL_PROBE_URL%/}" 1)
  validate_summary_log_step "UI host:port labels + public GraphQL route HTTP code"

  loc_gql_prof=$(graphql_instance_profile_probe "${LOCAL_GRAPHQL_URL}" "${loc_gql}")
  validate_summary_log_step "GraphQL instanceConnectionProfile · local"

  st_gql_prof=$(graphql_instance_profile_probe "${STAGING_GRAPHQL_URL}" "${st_gql}")
  validate_summary_log_step "GraphQL instanceConnectionProfile · staging"

  pub_gql_prof=$(graphql_instance_profile_probe "${PUBLIC_GRAPHQL_PROBE_URL}" "${pub_gql}")
  validate_summary_log_step "GraphQL instanceConnectionProfile · public"

  mvp_gql_prof="n/a|n/a|n/a"
  mvp_hp=""
  if [[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]]; then
    mvp_hp=$(host_port_from_ui_url "${MVP_UI_URL}")
    mvp_gql_prof=$(graphql_instance_profile_probe "${MVP_GRAPHQL_URL}" "${mvp_gql}")
    validate_summary_log_step "GraphQL instanceConnectionProfile · MVP"
  fi

  case "$presenter" in
    local)
      top_level_version="${loc_ui_version} (via local presenter)"
      ;;
    staging)
      top_level_version="${st_ui_version} (via staging presenter)"
      ;;
    conflict)
      top_level_version="CONFLICT (both local and staging presenters active)"
      ;;
    orphan)
      top_level_version="${pub_ui_version} (public tunnel live; not local/staging ngrok on this host)"
      ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        top_level_version="HOLDING PAGE (Cloudflare fallback · HTTP ${pub_code})"
      elif [[ "$pub_ui_version" == "n/a (DOWN)" ]]; then
        top_level_version="UNAVAILABLE (public gateway fallback/inactive)"
      else
        top_level_version="${pub_ui_version} (public)"
      fi
      ;;
    *)
      if [[ "$pub_ui_version" == "n/a (DOWN)" ]]; then
        top_level_version="UNAVAILABLE (public gateway fallback/inactive)"
      else
        top_level_version="${pub_ui_version} (public)"
      fi
      ;;
  esac

  case "$presenter" in
    local) ext_line="${GREEN}active → local${NC}" ;;
    staging) ext_line="${BLUE}active → staging${NC}" ;;
    conflict) ext_line="${RED}CONFLICT (local + staging both on)${NC}" ;;
    orphan) ext_line="${YELLOW}ORPHAN tunnel${NC} (live public; stop needs the host that owns ngrok)" ;;
    none)
      if public_is_holding_page "$pub_code" "$gateway"; then
        ext_line="${YELLOW}holding page${NC} (HTTP 503 · gateway=fallback)"
      else
        ext_line="${YELLOW}inactive${NC} (Cloudflare / holding page expected)"
      fi
      ;;
    *) ext_line="${DIM}unknown${NC}" ;;
  esac

  local work_color="$YELLOW"
  local work_u
  work_u=$(echo "$work" | tr '[:lower:]' '[:upper:]')
  [[ "$work" == "local" ]] && work_color="$GREEN"
  [[ "$work" == "staging" ]] && work_color="$BLUE"
  target_status_plain_text=$(target_status_plain "$work" "$loc_ui" "$loc_gql" "$loc_sb" "$st_ui" "$st_gql" "$st_sb")
  ext_status_plain_text=$(external_status_plain "$presenter" "$pub_code" "$gateway")
  local_marker=" "
  staging_marker=" "
  [[ "$work" == "local" ]] && local_marker="▶"
  [[ "$work" == "staging" ]] && staging_marker="▶"

  validate_summary_log_step "Assemble markers + status strings"
  validate_summary_log_total

  header_sep=$(printf '%*s' 96 '' | tr ' ' '-')
  local validate_run_iso validate_run_local
  validate_run_iso="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u '+%Y-%m-%d %H:%M:%S UTC')"
  validate_run_local="$(date '+%Y-%m-%d %H:%M:%S %Z (UTC%z)' 2>/dev/null || date)"
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${BOLD}TALIA OPS - ${work_u}${NC}"
  echo -e "Version: ${top_level_version}"
  echo -e "Target: ${target_status_plain_text}   External: ${ext_status_plain_text}"
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${DIM}Validate script: ${SCRIPT_VERSION}${NC}"
  echo -e "${DIM}Run at (UTC):   ${validate_run_iso}${NC}"
  echo -e "${DIM}Run at (local): ${validate_run_local} · host: ${HOSTNAME}${NC}"
  echo -e "  ${BOLD}Discuss portal${NC}: ${PUBLIC_DEV_URL} (${ext_line})"
  echo -e "  ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod · apex ${PUBLIC_MAIN_URL} = same tunnel${NC}"
  local rem_disp
  rem_disp=$(get_remembered_target)
  [[ -z "$rem_disp" ]] && rem_disp="(default by host)"
  echo -e "  ${DIM}Remembered target: ${rem_disp} (${TARGET_STATE_FILE/#$HOME/~})${NC}"
  if [[ "$presenter" == "orphan" ]]; then
    echo -e "  ${YELLOW}Hint:${NC} ${DIM}$(infer_public_backend_hint)${NC}"
  fi
  echo ""
  local mvp_snap mvp_section
  mvp_snap="$([[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]] && echo 1 || echo 0)"
  mvp_section="$mvp_snap"
  validate_summary_snapshot_write_v1 \
    "$loc_ui" "$loc_gql" "$loc_sb" "$st_ui" "$st_gql" "$st_sb" \
    "$mvp_ui" "$mvp_gql" "$mvp_sb" "$mvp_kong_line_suffix" \
    "${MVP_UI_HOST}:${MVP_SUPABASE_KONG_LIVE_PORT:-${MVP_KONG_PORT:-54321}}" \
    "$pub_code" "$gateway" \
    "$loc_hp" "$st_hp" "$pub_hp" "$mvp_hp" \
    "$loc_ui_version" "$st_ui_version" "$pub_ui_version" "$mvp_ui_version" \
    "$loc_gql_prof" "$st_gql_prof" "$pub_gql_prof" "$mvp_gql_prof" \
    "$mvp_snap"

  _emit_validate_summary_endpoints "$local_marker" "$staging_marker"
  _emit_validate_summary_deployed_canonical "$local_marker" "$staging_marker"
}

print_quick_targets_summary() {
  if [[ "${VALIDATE_SUMMARY_SKIP_CACHE_WRITE:-}" == "1" ]]; then
    _print_quick_targets_summary_impl
    return 0
  fi
  _print_quick_targets_summary_impl | tee "${VALIDATE_SUMMARY_CACHE_FILE}"
}

# Same layout as the menu header, plus paths (live header + snapshot body; optional full transcript file).
print_cached_quick_targets_summary() {
  if [[ -t 1 ]]; then
    clear
  fi
  echo ""
  if [[ ! -s "${VALIDATE_SUMMARY_PROBE_STATE_FILE}" ]]; then
    echo -e "${YELLOW}No snapshot on disk yet.${NC}"
    echo -e "  Run a full probe: menu ${GREEN}10${NC}, or start ./validate, or: ${GREEN}$0 status${NC}"
    return 1
  fi
  _print_ops_summary_live_header
  print_validate_summary_body_from_state || true
  echo ""
  echo -e "${DIM}Endpoint/deployed snapshot: ${VALIDATE_SUMMARY_PROBE_STATE_FILE/#$HOME/~}${NC}"
  if [[ -s "${VALIDATE_SUMMARY_CACHE_FILE}" ]]; then
    echo -e "${DIM}Full last transcript (timing + all): ${VALIDATE_SUMMARY_CACHE_FILE/#$HOME/~}${NC}"
  fi
  echo -e "${DIM}Refresh: ${GREEN}10${NC} or ${GREEN}$0 status${NC}${DIM}.${NC}"
}

quick_up_label() {
  local code="$1"
  local kind="$2"
  if [[ "$kind" == "gql" ]]; then
    if [[ "$code" == "200" || "$code" == "400" ]]; then
      echo -e "${GREEN}UP${NC} (${code})"
    else
      echo -e "${YELLOW}DOWN${NC} (${code})"
    fi
  elif [[ "$kind" == "kong" ]]; then
    case "$code" in
      200|301|302|401|403|404) echo -e "${GREEN}UP${NC} (${code})" ;;
      *) echo -e "${YELLOW}DOWN${NC} (${code})" ;;
    esac
  else
    if [[ "$code" == "200" || "$code" == "302" ]]; then
      echo -e "${GREEN}UP${NC} (${code})"
    else
      echo -e "${YELLOW}DOWN${NC} (${code})"
    fi
  fi
}

docker_status_label() {
  if ! command -v docker >/dev/null 2>&1; then
    echo -e "${YELLOW}MISSING${NC} (docker CLI not found)"
    return 0
  fi
  if docker info >/dev/null 2>&1; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC} (daemon unreachable)"
  fi
}

quick_ui_version_label() {
  local base_url="$1"
  local http_code="$2"
  local use_display="${3:-false}"
  local raw

  case "$http_code" in
    200|302) ;;
    *) echo "n/a (DOWN)"; return 0 ;;
  esac

  if [[ "$use_display" == "true" ]]; then
    raw=$(get_display_version "$base_url")
  else
    raw=$(get_ui_version "$base_url")
  fi

  if [[ "$raw" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "v${raw}"
  else
    echo "$raw"
  fi
}

print_front_page_status() {
  local local_ui_url="$LOCAL_UI_URL"
  local staging_ui_url="$STAGING_UI_URL"
  local public_url="$PUBLIC_MAIN_URL"
  local local_ui_code
  local staging_ui_code
  local public_code
  local local_ui_version
  local staging_ui_version
  local public_version
  local local_ngrok
  local staging_ngrok
  local presenter
  local target_status
  local local_status
  local staging_status
  local headers
  local gateway
  local local_external_label
  local staging_external_label
  local remembered_target
  local mvp_ui_code
  local mvp_status

  local_ui_code=$(get_http_code "${local_ui_url}/")
  staging_ui_code=$(get_http_code "${staging_ui_url}/")
  public_code=$(get_http_code "${public_url}/")

  mvp_ui_code="000"
  mvp_status="n/a"
  if [[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]]; then
    mvp_ui_code=$(get_http_code "${MVP_UI_URL}/")
    if [[ "$mvp_ui_code" == "200" || "$mvp_ui_code" == "302" ]]; then
      mvp_status="UP"
    else
      mvp_status="DOWN"
    fi
  fi

  local_ui_version=$(get_display_version "${local_ui_url}")
  staging_ui_version=$(get_display_version "${staging_ui_url}")
  public_version=$(get_ui_version "${public_url}")

  local_ngrok=$(get_target_external_state "local")
  staging_ngrok=$(get_target_external_state "staging")

  headers=$(curl -sS -I --max-time 6 "${public_url}" 2>/dev/null || true)
  gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
  [[ -z "$gateway" ]] && gateway="n/a"

  presenter=$(get_current_target)
  remembered_target=$(get_remembered_target)

  # Public endpoint may hide/reshape assets; infer version from active presenter when needed.
  if [[ ! "$public_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    if [[ "$presenter" == "local" ]]; then
      public_version="${local_ui_version} (via local)"
    elif [[ "$presenter" == "staging" ]]; then
      public_version="${staging_ui_version} (via staging)"
    fi
  elif [[ "$public_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    public_version="v${public_version}"
  fi

  if [[ "$public_code" == "200" || "$public_code" == "302" ]]; then
    target_status="UP"
  elif [[ "$public_code" == "000" ]]; then
    target_status="DOWN"
  else
    target_status="WARN"
  fi

  if [[ "$local_ui_code" == "200" || "$local_ui_code" == "302" ]]; then
    local_status="UP"
  else
    local_status="DOWN"
  fi

  if [[ "$staging_ui_code" == "200" || "$staging_ui_code" == "302" ]]; then
    staging_status="UP"
  else
    staging_status="DOWN"
  fi

  local_external_label="${PUBLIC_DEV_URL} (inactive; apex ${PUBLIC_MAIN_URL})"
  staging_external_label="${PUBLIC_DEV_URL} (inactive; apex ${PUBLIC_MAIN_URL})"
  if [[ "$presenter" == "local" ]]; then
    local_external_label="${PUBLIC_DEV_URL} (active; apex ${PUBLIC_MAIN_URL})"
  elif [[ "$presenter" == "staging" ]]; then
    staging_external_label="${PUBLIC_DEV_URL} (active; apex ${PUBLIC_MAIN_URL})"
  elif [[ "$presenter" == "conflict" ]]; then
    local_external_label="${PUBLIC_DEV_URL} (conflict; apex ${PUBLIC_MAIN_URL})"
    staging_external_label="${PUBLIC_DEV_URL} (conflict; apex ${PUBLIC_MAIN_URL})"
  fi

  echo -e "  ${BOLD}Front Page Status${NC}"
  echo -e "  1) Discuss ${PUBLIC_DEV_URL} · tunnel owner: ${BOLD}${presenter}${NC} (gateway=${gateway})"
  echo -e "  2) target version: ${public_version}"
  echo -e "  3) target status: ${target_status} (HTTP ${public_code})"
  echo -e "  4) local: ${local_status} (HTTP ${local_ui_code}, v${local_ui_version}) | MiniPC: ${staging_status} (HTTP ${staging_ui_code}, v${staging_ui_version}) | Azure UAT: ${mvp_status} (HTTP ${mvp_ui_code})"
  echo -e "     Remembered target -> ${remembered_target:-none}"
  echo -e "     Local addresses   -> direct: ${local_ui_url} | external: ${local_external_label}"
  echo -e "     MiniPC addresses  -> direct: ${staging_ui_url} | external: ${staging_external_label}"
  if [[ "$MVP_VALIDATE" == "1" && -n "$MVP_UI_HOST" ]]; then
    echo -e "     Azure UAT (MVP)   -> direct: ${MVP_UI_URL}"
  fi
  echo -e "     Public hosts      -> ${PUBLIC_DEV_URL} (prefer) | ${PUBLIC_MAIN_URL} | ${PUBLIC_SECONDARY_URL}"
  echo -e "     ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod${NC}"
  echo ""
}

# Full probe summary (slow): all HTTP + UI versions + GraphQL instanceConnectionProfile calls.
print_full_interactive_header() {
  # Non-TTY (CI, some IDE terminals): `clear` exits 1 and `set -e` would kill the script with no output.
  if [[ -t 1 ]]; then
    clear
  fi
  echo ""
  print_quick_targets_summary
}

# Menu draw: live OPS header (target/presenter/light HTTP) + cached Endpoints / Deployed from last full probe.
print_interactive_header_from_cache() {
  if [[ -t 1 ]]; then
    clear
  fi
  echo ""
  _print_ops_summary_live_header
  if print_validate_summary_body_from_state; then
    echo -e "${DIM}${GREEN}10${NC}${DIM} = re-run probes (refreshes endpoint/deployed snapshot below)${NC}"
    echo ""
  else
    echo -e "${YELLOW}No endpoint snapshot yet.${NC} Choose ${GREEN}10${NC} to run a full probe (or restart; first screen runs probes)."
    echo ""
  fi
}

