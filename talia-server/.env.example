# Talia Server - Environment Variables Example
# Copy this file to .env and update with your actual values

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# Database Configuration (Future)
# ============================================
# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/talia

# Connection pool settings
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ============================================
# API Keys (If Needed)
# ============================================
# External API keys for integrations
# API_KEY=your-api-key-here
# CRUISE_SYSTEM_API_KEY=your-cruise-api-key
# AISSTREAM_API_KEY=your-aisstream-api-key
# AISHUB_USERNAME=your-aishub-username
# VESSELFINDER_API_KEY=your-vesselfinder-api-key
# MARINETRAFFIC_API_KEY=your-marinetraffic-api-key

# ============================================
# Redis Configuration (Future)
# ============================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# Security
# ============================================
# JWT_SECRET=your-jwt-secret-here
# CORS_ORIGIN=https://your-frontend-domain.com

# ============================================
# Synapse integration (kill switch)
# ============================================
# Set to 1 to block all Synapse → Supabase sync (CLI sync-* and GraphQL sync mutations).
# TALIA_SYNAPSE_SYNC_DISABLED=1

# ============================================
# GraphQL / focus (legacy hosts only)
# ============================================
# If this container still uses an older schema whose FocusType enum has no ROLE, set 1 so API can still
# return focuses whose Postgres row has type=role (coerced to STANDARD on the wire only; DB unchanged).
# Remove after graphql-server image matches current schema (ROLE in enum).
# TALIA_GRAPHQL_LEGACY_FOCUS_ENUM=1

# ============================================
# Logging
# ============================================
# LOG_LEVEL=info
# LOG_FORMAT=json
