{
  "name": "talia-server",
  "version": "0.1.1",
  "description": "Talia Platform - GraphQL Server (Alpha)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "npm run clean && tsc && mkdir -p dist/services dist/config && cp src/services/*.js dist/services/ && cp src/config/*.js dist/config/",
    "dev": "npx tsx watch src/index.ts",
    "start": "./start.sh",
    "stop": "pkill -f 'tsx src/index.ts' || pkill -f 'node.*dist/index.js' || echo 'No server running'",
    "restart": "./restart.sh",
    "start:watch": "./restart-server.sh",
    "dev:watch": "npx nodemon --watch src --ext ts --exec \"npx tsx src/index.ts\"",
    "sync-all": "node sync-cli.js sync-all",
    "sync-status": "node sync-cli.js status",
    "sync-test": "node sync-cli.js test-connection",
    "sync-help": "node sync-cli.js help",
    "sync-ships": "node sync-cli.js sync-table ships",
    "sync-cabin": "node sync-cli.js sync-table cabinAvailability",
    "sync-reservations": "node sync-cli.js sync-table reservations",
    "sync-rates": "node sync-cli.js sync-table publishedRates",
    "sync-occupancy": "node sync-cli.js sync-table sailByCabinOccupancy",
    "sync-masterSail": "node sync-cli.js sync-table masterSail",
    "sync-reservationChanges": "node sync-cli.js sync-table reservationChanges",
    "sync-competitor": "node sync-cli.js sync-table competitor",
    "sync-dataset": "node sync-cli.js sync-dataset sept-dec-2025",
    "sync-dataset-2024": "node sync-cli.js sync-dataset sept-dec-2024",
    "explore-stg-res": "node scripts/explore-stg-res-tables.js",
    "db-backup": "./scripts/backup-db.sh",
    "db-restore": "./scripts/restore-db.sh"
  },
  "keywords": [
    "graphql",
    "revenue-management",
    "inventory-management"
  ],
  "author": "Zomarc",
  "license": "UNLICENSED",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-trends-api": "^4.9.2",
    "graphql": "^16.11.0",
    "mssql": "^12.0.0",
    "pg": "^8.16.3",
    "tedious": "^16.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
