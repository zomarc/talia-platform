  "datasets": {
    "sept-dec-2025": {
      "description": "Sail/departure horizon Sep 2025 – Dec 2027 (current bookings + dims). Snapshot-only tables keep a short lookback.",
      "tableSequence": [
        "agency",
        "ships",
        "marketRollUp",
        "cabinCtg",
        "budget",
        "etlTableParameters",
        "shipCabin",
        "shipCabinCtgLink",
        "shipCabinReserve",
        "masterSail",
        "cabinAvailability",
        "sailByCabinOccupancy",
        "reservations",
        "reservationPromotion",
        "shipInventoryAlloc",
        "publishedRates",
        "reservationChanges",
        "factReservationHistory",
        "competitor",
        "competitorBenchmark"
      ],
      "tables": {
        "agency": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "ships": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "marketRollUp": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "cabinCtg": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "etlTableParameters": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "shipCabin": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "shipCabinCtgLink": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "shipCabinReserve": {
          "filters": [
            {
              "column": "[SAIL_DATE_FROM]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "cabinAvailability": {
          "applyIntegrationDateRange": false,
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2026-05-14",
              "to": "2026-08-11"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2026-05-14",
            "to": "2026-08-11"
          }
        },
        "reservations": {
          "filters": [
            {
              "column": "[SAIL_DATE_FROM]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_from_date",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "shipInventoryAlloc": {
          "filters": [
            {
              "column": "[SAIL_DATE_FROM]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "publishedRates": {
          "filters": [
            {
              "column": "[SNAPSHOT_DATE]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ]
        },
        "sailByCabinOccupancy": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "reservationChanges": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "competitor": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "competitorBenchmark": {
          "filters": [
            {
              "column": "[Departure_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-all",
            "column": "id",
            "keepDeleteAll": true
          }
        },
        "reservationPromotion": {
          "filters": [
            {
              "column": "[RES_ID]",
              "operator": "subquery",
              "subquery": "SELECT RES_ID FROM stg.RES_HEADER WHERE SAIL_DATE_FROM >= '{{from}}' AND SAIL_DATE_FROM <= '{{to}}'"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "res_id",
            "joinTable": "reservation",
            "joinColumn": "res_id",
            "dateColumn": "sail_from_date",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        },
        "masterSail": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2027-12-01"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2027-12-01"
          }
        }
      }
    },
    "sept-dec-2024": {
      "description": "Previous year data for year-over-year comparison (September through December 2024)",
      "tableSequence": [
        "agency",
