}

run_script() {
  local script="$1"
  local args="${2:-}"
  
  if [[ -f "${SCRIPT_DIR}/${script}" ]]; then
    echo ""
    echo -e "${CYAN}Running: ${script} ${args}${NC}"
    echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
    echo ""
    "${SCRIPT_DIR}/${script}" $args
    local exit_code=$?
    echo ""
    echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
    return $exit_code
  else
    echo -e "${RED}Error: Script not found: ${script}${NC}"
    return 1
  fi
}

run_command() {
  local cmd="$1"
  local desc="$2"
  local timeout_sec="${3:-180}"
  local start_epoch now elapsed exit_code
  local cmd_pid

  echo ""
  echo -e "${CYAN}${desc}${NC}"
  echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
  echo ""
  echo -e "${DIM}Command:${NC} ${cmd}"
  echo ""

  start_epoch=$(date +%s)
  ( eval "$cmd" ) &
  cmd_pid=$!

  while kill -0 "$cmd_pid" 2>/dev/null; do
    now=$(date +%s)
    elapsed=$((now - start_epoch))
    if [[ "$elapsed" -ge "$timeout_sec" ]]; then
      echo -e "  ${RED}✗ Timed out after ${elapsed}s${NC}"
      kill "$cmd_pid" 2>/dev/null || true
      sleep 1
      kill -9 "$cmd_pid" 2>/dev/null || true
      exit_code=124
      break
    fi
    echo -e "  ${DIM}... running (${elapsed}s elapsed)${NC}"
    sleep 3
  done

  if [[ -z "${exit_code:-}" ]]; then
    wait "$cmd_pid"
    exit_code=$?
    now=$(date +%s)
    elapsed=$((now - start_epoch))
  fi

  if [[ "$exit_code" -eq 0 ]]; then
    echo -e "  ${GREEN}✓ Completed in ${elapsed}s${NC}"
  else
    echo -e "  ${RED}✗ Failed in ${elapsed}s (exit ${exit_code})${NC}"
  fi
  echo ""
  echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
  return "$exit_code"
}

wait_for_key() {
  echo ""
  echo -e "${DIM}Press any key to continue...${NC}"
  read -n 1 -s
}

is_docker_ready() {
  if ! command -v docker >/dev/null 2>&1; then
    return 1
  fi
  docker info >/dev/null 2>&1
}

ensure_docker_runtime_up() {
  local wait_seconds="${1:-60}"
  local elapsed=0
  local startup_attempted=false

  if is_docker_ready; then
    return 0
  fi

  echo -e "  ${YELLOW}Docker daemon is not reachable; attempting to start it...${NC}"

  if [[ "$OSTYPE" == "darwin"* ]]; then
    if command -v open >/dev/null 2>&1; then
      if open -g -a Docker >/dev/null 2>&1; then
        startup_attempted=true
        echo -e "  ${DIM}Requested Docker Desktop startup${NC}"
      elif open -g -a OrbStack >/dev/null 2>&1; then
        startup_attempted=true
        echo -e "  ${DIM}Requested OrbStack startup${NC}"
      fi
    fi
  fi

  if [[ "$startup_attempted" == false ]] && command -v colima >/dev/null 2>&1; then
    if colima start >/dev/null 2>&1; then
      startup_attempted=true
      echo -e "  ${DIM}Requested Colima startup${NC}"
    fi
  fi

  while [[ "$elapsed" -lt "$wait_seconds" ]]; do
    if is_docker_ready; then
      echo -e "  ${GREEN}✓${NC} Docker daemon is ready"
      return 0
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done

  echo -e "  ${RED}✗ Docker daemon did not become ready within ${wait_seconds}s${NC}"
  echo -e "  ${YELLOW}Start Docker Desktop/OrbStack/Colima, then retry.${NC}"
  return 1
}

prompt_target() {
  {
    echo ""
    echo -e "${BOLD}Target:${NC}"
    echo -e "  ${GREEN}1)${NC} Local"
    echo -e "  ${GREEN}2)${NC} Staging"
    echo -e "  ${GREEN}3)${NC} All"
    echo -e "  ${YELLOW}0)${NC} Back"
    echo ""
    echo -n -e "${BOLD}Enter target: ${NC}"
  } >&2
  read -r target
  case "$target" in
    1|local) echo "local" ;;
    2|staging) echo "staging" ;;
    3|all) echo "all" ;;
    0|back|q|quit|exit) echo "back" ;;
    *) echo "invalid" ;;
  esac
}

prompt_service_group() {
  {
    echo ""
    echo -e "${BOLD}Service group:${NC}"
    echo -e "  ${GREEN}1)${NC} Local development (UI + API)"
    echo -e "  ${GREEN}2)${NC} External gateway (ngrok)"
    echo -e "  ${GREEN}3)${NC} Staging services (Docker + ngrok)"
    echo -e "  ${GREEN}4)${NC} All"
    echo -e "  ${YELLOW}0)${NC} Back"
    echo ""
    echo -n -e "${BOLD}Enter group: ${NC}"
  } >&2
  read -r group
  case "$group" in
    1|local) echo "local" ;;
    2|external) echo "external" ;;
    3|staging) echo "staging" ;;
    4|all) echo "all" ;;
    0|back|q|quit|exit) echo "back" ;;
    *) echo "invalid" ;;
  esac
}

check_local_services() {
  local local_ui_health_url="${LOCAL_UI_URL%/}/"
  local local_graphql_health_url="${LOCAL_GRAPHQL_URL%/}"
  local local_ui_graphql_url="${LOCAL_UI_URL%/}/api/graphql"
  echo -e "${BOLD}Local Services:${NC}"
  echo -n "  Docker daemon: "
  if ! command -v docker >/dev/null 2>&1; then
    echo -e "${YELLOW}MISSING${NC} (docker CLI not found)"
  elif docker info >/dev/null 2>&1; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC} (daemon unreachable)"
  fi

  echo -n "  UI (localhost:5173): "
  local ui
  ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_ui_health_url" 2>/dev/null || echo "000")
  [[ "$ui" == "200" ]] && echo -e "${GREEN}UP${NC}" || echo -e "${YELLOW}DOWN${NC} (HTTP $ui)"

  echo -n "  GraphQL (localhost:4000): "
  local gql
  gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_graphql_health_url" 2>/dev/null || echo "000")
  [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}UP${NC} (HTTP $gql)" || echo -e "${YELLOW}DOWN${NC} (HTTP $gql)"

  echo -n "  UI->GraphQL dataflow (master_sail): "
  local master_payload master_ok
  master_payload=$(curl -sS --max-time 10 -X POST "$local_ui_graphql_url" \
    -H 'Content-Type: application/json' \
    -d '{"query":"query V($tableName:String!,$limit:Int,$filters:TableDataFilters){ tableData(tableName:$tableName, limit:$limit, filters:$filters) }","variables":{"tableName":"master_sail","limit":5,"filters":{"include_non_real_sailings":false}}}' 2>/dev/null || true)
  master_ok=0
  if [[ -n "$master_payload" && "$master_payload" == *'"tableData"'* && "$master_payload" != *'"errors"'* ]]; then
    master_ok=1
  fi
  [[ "$master_ok" -eq 1 ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}FAIL${NC} (UI data query failed)"

  echo -n "  UI->GraphQL dataflow (competitorPricing): "
  local comp_payload comp_ok
  comp_payload=$(curl -sS --max-time 15 -X POST "$local_ui_graphql_url" \
    -H 'Content-Type: application/json' \
    -d '{"query":"query C($filters: CompetitorPricingFilters){ competitorPricing(filters:$filters){ id shipCode departureDate } }","variables":{"filters":{"currency":"EUR","isLatest":true}}}' 2>/dev/null || true)
  comp_ok=0
  if [[ -n "$comp_payload" && "$comp_payload" == *'"competitorPricing"'* && "$comp_payload" != *'"errors"'* ]]; then
    comp_ok=1
  fi
  [[ "$comp_ok" -eq 1 ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}FAIL${NC} (competitor query failed)"

  echo -n "  ngrok (local): "
  if [[ "$(get_target_external_state local)" == "active" ]]; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC}"
  fi

  check_local_code_origin false
}

check_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_script "validate-staging-local.sh"
  else
    run_script "validate-staging-connectivity.sh"
  fi
}

print_front_screen_status() {
  print_front_page_status
}

start_local_services() {
  local local_ui_health_url="${LOCAL_UI_URL%/}/"
  local local_graphql_health_url="${LOCAL_GRAPHQL_URL%/}"
  echo -e "${BOLD}Starting local services:${NC}"

  if [[ ! -d "${ROOT_DIR}/talia-ui" ]] || [[ ! -d "${ROOT_DIR}/talia-server" ]]; then
    echo -e "  ${RED}Local project directories not found under ${ROOT_DIR}${NC}"
    return 1
  fi

  if ! verify_ui_port_owner; then
    return 1
  fi

  check_duplicate_dev_servers true
  check_local_code_origin true

  local ui_code
  ui_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_ui_health_url" 2>/dev/null || echo "000")
  if [[ "$ui_code" == "200" ]]; then
    echo -e "  ${GREEN}✓${NC} UI already running (port 5173)"
  else
    echo -e "  Starting UI (talia-ui)..."
    (cd "${ROOT_DIR}/talia-ui" && nohup npm run dev >/tmp/talia-ui.log 2>&1 & echo $! > .dev-server.pid)
  fi

  local gql_code
  gql_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_graphql_health_url" 2>/dev/null || echo "000")
  if [[ "$gql_code" == "200" || "$gql_code" == "400" ]]; then
    echo -e "  ${GREEN}✓${NC} GraphQL already running (port 4000)"
  else
    echo -e "  Starting GraphQL (talia-server)..."
    (cd "${ROOT_DIR}/talia-server" && nohup npm run start >/tmp/talia-server.log 2>&1 & echo $! > .dev-server.pid)
  fi

  sleep 2
  echo -e "  ${DIM}Logs:${NC} /tmp/talia-ui.log, /tmp/talia-server.log"
}

start_local_supabase_if_needed() {
  if ! ensure_docker_runtime_up 90; then
    return 1
  fi

  local code
  code=$(get_http_code_quick "${LOCAL_SUPABASE_URL}" 2)
  case "$code" in
    200|301|302|401|403|404)
      echo -e "  ${GREEN}✓${NC} Supabase Kong already up (${LOCAL_SUPABASE_URL})"
      return 0
      ;;
  esac
  if command -v supabase >/dev/null 2>&1 && [[ -f "${ROOT_DIR}/talia-server/supabase/config.toml" ]]; then
    echo -e "  Starting Supabase (CLI, background → /tmp/talia-supabase.log)..."
    (cd "${ROOT_DIR}/talia-server" && nohup supabase start >>/tmp/talia-supabase.log 2>&1 &)
  else
    echo -e "  ${YELLOW}Supabase not reachable on ${LOCAL_SUPABASE_URL}; install Supabase CLI or run: cd talia-server && supabase start${NC}"
  fi
}

stop_local_supabase_if_available() {
  if command -v supabase >/dev/null 2>&1 && [[ -f "${ROOT_DIR}/talia-server/supabase/config.toml" ]]; then
    echo -e "${BOLD}Stopping local Supabase (CLI):${NC}"
    (cd "${ROOT_DIR}/talia-server" && supabase stop) || true
  else
    echo -e "  ${DIM}Supabase CLI not configured here; skipped${NC}"
  fi
}

start_local_core() {
  echo -e "${BOLD}Start core (local):${NC}"
  start_local_services
  if ! start_local_supabase_if_needed; then
    return 1
  fi
}

stop_local_core() {
  echo -e "${BOLD}Stop core (local):${NC}"
  stop_local_dev_services
  stop_local_supabase_if_available
}

start_core_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${CYAN}Starting core services for target: ${BOLD}${t}${NC}"
  case "$t" in
    local) start_local_core ;;
    staging) start_staging_core_remote ;;
    mvp) start_mvp_core_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
}

stop_core_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${CYAN}Stopping core services for target: ${BOLD}${t}${NC}"
  case "$t" in
    local) stop_local_core ;;
    staging) stop_staging_core_remote ;;
    mvp) stop_mvp_core_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
}

reboot_staging_emergency() {
  local confirm

  echo ""
  echo -e "${RED}${BOLD}Emergency action: reboot staging server${NC}"
  echo -e "${YELLOW}This will immediately restart ${STAGING_HOST} and interrupt all staging sessions.${NC}"
  echo -e "${YELLOW}Use only for recovery from staging issues.${NC}"
  echo ""
  echo -n -e "${BOLD}Type REBOOT_STAGING_NOW to continue: ${NC}"
  read -r confirm
  if [[ "$confirm" != "REBOOT_STAGING_NOW" ]]; then
    echo -e "${YELLOW}Reboot cancelled.${NC}"
    return 1
  fi

  if $IS_ON_STAGING; then
    run_command "sudo nohup bash -lc 'sleep 2; /sbin/reboot' >/tmp/talia-reboot.log 2>&1 < /dev/null & echo REBOOT_SCHEDULED" "Schedule local reboot on staging host" "20"
    return $?
  fi

  check_staging_ssh_ready || return 1
  run_command "ssh ${STAGING_SSH_BASE_OPTS} ${STAGING_SSH_TARGET} \"sudo nohup bash -lc 'sleep 2; /sbin/reboot' >/tmp/talia-reboot.log 2>&1 < /dev/null & echo REBOOT_SCHEDULED\"" "Schedule remote reboot on staging host" "20"
}

# Upserts ui_appearance keys (theme registry + optional per-user rows) and merges public.focuses
# from local Supabase into the chosen remote(s). No application code deploy.
sync_ui_themes_and_focus_definitions_db() {
  if $IS_ON_STAGING; then
    echo -e "${YELLOW}Run this sync from your local dev machine, not on the staging host.${NC}"
    return 1
  fi

  if [[ ! -f "${SCRIPT_DIR}/sync-ui-themes-to-staging.sh" ]]; then
    echo -e "${RED}Missing sync script: ${SCRIPT_DIR}/sync-ui-themes-to-staging.sh${NC}"
    return 1
  fi
  if [[ ! -f "${SCRIPT_DIR}/sync-focus-definitions-to-target.sh" ]]; then
    echo -e "${RED}Missing sync script: ${SCRIPT_DIR}/sync-focus-definitions-to-target.sh${NC}"
    return 1
  fi

  echo ""
  echo -e "${BOLD}Sync UI themes + focus definitions (database only)${NC}"
  echo -e "  ${DIM}Themes:${NC} upserts ${GREEN}theme_registry${NC}, ${GREEN}theme_asset_overrides${NC} (${GREEN}config_setting${NC} ui_appearance)."
  echo -e "  ${DIM}Focuses:${NC} merges all rows in ${GREEN}public.focuses${NC} by id (omits ${DIM}created_by${NC} for cross-env safety)."
  echo -e "  ${DIM}Does not deploy code, run migrations, or touch unrelated tables.${NC}"
  echo ""
  echo -e "${BOLD}Target:${NC}"
  echo -e "  ${GREEN}1)${NC} LAN staging — ${DIM}${STAGING_SUPABASE_URL}${NC}"
  if [[ -n "${MVP_SSH_HOST:-}" && -n "${MVP_UI_HOST:-}" ]]; then
    echo -e "  ${GREEN}2)${NC} MVP (Azure) — ${DIM}${MVP_SUPABASE_URL}${NC}"
    echo -e "  ${GREEN}3)${NC} Both — staging first, then MVP"
  else
    echo -e "  ${DIM}2) MVP — set MVP_SSH_HOST and MVP_UI_HOST in targets.env${NC}"
  fi
  echo -e "  ${YELLOW}0)${NC} Cancel"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r dest_choice

  local targets_list=()
  case "$dest_choice" in
    1|staging)
      targets_list=("staging")
      ;;
    2|mvp)
      if [[ -z "${MVP_SSH_HOST:-}" || -z "${MVP_UI_HOST:-}" ]]; then
        echo -e "${RED}MVP is not configured (need MVP_SSH_HOST and MVP_UI_HOST).${NC}"
        return 1
      fi
      targets_list=("mvp")
      ;;
    3|both)
      if [[ -z "${MVP_SSH_HOST:-}" || -z "${MVP_UI_HOST:-}" ]]; then
        echo -e "${RED}MVP is not configured; use option 1 for staging only.${NC}"
        return 1
      fi
      targets_list=("staging" "mvp")
      ;;
    0|q|cancel|"") return 0 ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac

  echo ""
  echo -n -e "Also sync saved appearance for default dev Talia id ${GREEN}1000${NC} (settings + profiles + active profile id)? [y/N]: "
  read -r sync_u1
  local sync_ids=""
  case "$sync_u1" in
    y|Y|yes|YES) sync_ids="1000" ;;
  esac

  export SOURCE_SUPABASE_URL="${SOURCE_SUPABASE_URL:-$LOCAL_SUPABASE_URL}"
  export SYNC_APPEARANCE_USER_IDS="${sync_ids}"

  local t
  for t in "${targets_list[@]}"; do
    local tgt_url tgt_key label
    if [[ "$t" == "staging" ]]; then
      tgt_url="${STAGING_SUPABASE_URL}"
      tgt_key="${STAGING_SUPABASE_SERVICE_ROLE_KEY:-$STAGING_SUPABASE_ANON_KEY}"
      label="staging"
    else
      tgt_url="${MVP_SUPABASE_URL}"
      tgt_key="${MVP_SUPABASE_SERVICE_ROLE_KEY:-}"
      if [[ -z "$tgt_key" ]]; then
        tgt_key="${MVP_SUPABASE_ANON_KEY:-}"
      fi
      if [[ -z "$tgt_key" ]]; then
        echo -e "${RED}MVP database sync needs a Supabase API key from the MVP stack (not staging).${NC}"
        echo -e "${YELLOW}Set ${BOLD}MVP_SUPABASE_SERVICE_ROLE_KEY${NC} in ${CONFIG_FILE/#$HOME/~} (recommended).${NC}"
        echo "  On the MVP host, copy SUPABASE_SERVICE_ROLE_KEY from the compose env file (JWT, usually starts with eyJ), e.g.:"
        echo "    ssh ${MVP_SSH_USER}@${MVP_SSH_HOST} \"grep '^SUPABASE_SERVICE_ROLE_KEY=' ${MVP_APP_DIR:-/home/${MVP_SSH_USER}/talia-docker}/.env.staging\""
        return 1
      fi
      if [[ "$tgt_key" == sb_publishable_* ]]; then
        echo -e "${RED}MVP sync cannot use a publishable browser key (sb_publishable_*). PostgREST expects a JWT (service_role or anon from the MVP .env).${NC}"
        echo -e "${YELLOW}Add MVP_SUPABASE_SERVICE_ROLE_KEY to targets.env — see comments above MVP_KONG_PORT in that file.${NC}"
        return 1
      fi
      label="mvp"
    fi
    export TARGET_SUPABASE_URL="${tgt_url}"
    export TARGET_SUPABASE_KEY="${tgt_key}"

    echo ""
    echo -e "${BOLD}── ${label}${NC} ${DIM}(themes + focuses)${NC}"
    echo -e "${DIM}Source: ${SOURCE_SUPABASE_URL}${NC}"
    echo -e "${DIM}Target: ${TARGET_SUPABASE_URL}${NC}"
    echo ""

    bash "${SCRIPT_DIR}/sync-ui-themes-to-staging.sh" || return $?
    bash "${SCRIPT_DIR}/sync-focus-definitions-to-target.sh" || return $?
    echo -e "${GREEN}✓ ${label}: themes + focus definitions synced${NC}"
  done
}

deploy_ui_themes_db_to_staging() {
  sync_ui_themes_and_focus_definitions_db
}

deploy_to_staging_from_local() {
  if $IS_ON_STAGING; then
    echo -e "${YELLOW}Run this deploy action from your local dev machine, not on staging.${NC}"
    return 1
  fi

  if [[ ! -x "${SCRIPT_DIR}/deploy-to-staging.sh" ]]; then
    echo -e "${RED}Missing deploy script: ${SCRIPT_DIR}/deploy-to-staging.sh${NC}"
    return 1
  fi

  echo ""
  echo -e "${BOLD}Deploy to staging (local sync):${NC}"
  echo -e "  ${DIM}Default policy: UI-only paths unless you explicitly pick full stack.${NC}"
  echo -e "  ${GREEN}1)${NC} UI-only — local vite build, then copy into nginx (restarts ui container)"
  echo -e "  ${GREEN}5)${NC} UI hot sync — existing ${DIM}talia-ui/dist${NC} (run ${DIM}npm run build:staging${NC} in talia-ui first for LAN staging; deploy stamps instance label)"
  echo -e "  ${YELLOW}2)${NC} Full stack — GraphQL + UI rebuild + schema guard ${DIM}(only when you mean it)${NC}"
  echo -e "  ${GREEN}3)${NC} Scripts + config only"
  echo -e "  ${GREEN}4)${NC} UI themes + focus definitions → DB (staging / MVP / both; no app deploy)"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r choice

  local mode token timeout_sec label deploy_xtra
  deploy_xtra=""
  case "$choice" in
    1|ui|ui-only)
      mode="--ui-only"
      token="DEPLOY_UI_ONLY"
      timeout_sec="900"
      label="ui-only"
      ;;
    5|ui-hot|hot|hot-sync)
      mode="--ui-hot"
      token="DEPLOY_UI_ONLY"
      timeout_sec="420"
      label="ui-hot-sync"
      ;;
    2|full)
      mode="--full"
      token="DEPLOY_FULL_STACK"
      deploy_xtra="DEPLOY_EXPLICIT_FULL_STACK=1 "
      timeout_sec="1800"
      label="full"
      ;;
    3|scripts|scripts-only|config)
      mode="--scripts-only"
      token="DEPLOY_SCRIPTS_ONLY"
      timeout_sec="300"
      label="scripts+config"
      ;;
    4|themes-db|themes|ui-themes-db|appearance-db)
      deploy_ui_themes_db_to_staging
      return $?
      ;;
    0|back|q|quit|exit)
      return 0
      ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac

  run_command "cd \"${ROOT_DIR}\" && ${deploy_xtra}STAGING_DEPLOY_CONFIRM_TOKEN=${token} ./scripts/deploy-to-staging.sh ${mode}" "Deploy to staging via local sync (${label})" "$timeout_sec"
}

