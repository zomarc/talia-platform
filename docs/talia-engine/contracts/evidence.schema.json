{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talia.local/contracts/science.driver_analysis.v0.schema.json",
  "title": "ScienceEvidence",
  "description": "Advisory (then source) artifact from science.driver_analysis.v0. Must not invent Finding score or recommended_action.",
  "type": "object",
  "required": [
    "evidence_id",
    "task_id",
    "method_version",
    "role",
    "as_of",
    "scope",
    "subject",
    "peerset",
    "prior",
    "decision_moments",
    "material_value",
    "revenue_value",
    "covariate_ranks",
    "forward_now",
    "reasons",
    "diagnostics"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "const": "science.driver_analysis.v0" },
    "method_version": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["advisory", "source"] },
    "as_of": { "type": "string", "format": "date-time" },
    "scope": { "type": "object" },
    "subject": { "type": "object" },
    "peerset": { "type": "object" },
    "prior": { "type": "object" },
    "decision_moments": { "type": "array" },
    "material_value": { "type": "object" },
    "revenue_value": { "type": "object" },
    "covariate_ranks": { "type": "array" },
    "forward_now": { "type": ["object", "null"] },
    "reasons": { "type": "array" },
    "diagnostics": { "type": "object" },
    "run_id": { "type": ["string", "null"] },
    "tenant_id": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
