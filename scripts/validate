  if [[ -z "${MVP_SSH_HOST:-}" ]]; then
    echo -e "${RED}MVP_SSH_HOST is not set (scripts/config/targets.env).${NC}"
    return 1
  fi
  local dc="${MVP_DOCKER_COMPOSE}"
  run_mvp_ssh_command "cd ${MVP_APP_DIR} && ${dc} -f docker-compose.staging.yml stop" \
    "Stop MVP core (Docker compose on ${MVP_SSH_HOST})" "120"
}

_db_disk_sql_b64() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

db_disk_report_local() {
  local c="${LOCAL_SUPABASE_DB_CONTAINER}"
  echo -e "${BOLD}Postgres (local Docker — container ${c})${NC}"
  if ! is_docker_ready; then
    echo -e "${YELLOW}Docker is not reachable.${NC}"
    return 1
  fi
  if ! docker exec "$c" psql -U postgres -d postgres -c "SELECT 1" >/dev/null 2>&1; then
    echo -e "${YELLOW}Cannot run psql in ${c}.${NC}"
    echo -e "${DIM}Start the stack (e.g. docker compose -f docker-compose.staging.yml up -d) or set LOCAL_SUPABASE_DB_CONTAINER.${NC}"
    return 1
  fi
  echo ""
  echo -e "${BOLD}Total size (current database)${NC}"
  docker exec "$c" psql -U postgres -d postgres -t -A -c "SELECT pg_size_pretty(pg_database_size(current_database()));"
  echo ""
  echo -e "${BOLD}Largest public tables (top 5)${NC}"
  docker exec "$c" psql -U postgres -d postgres -c "SELECT relname AS table, pg_size_pretty(pg_total_relation_size(c.oid)) AS total_size FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' AND c.relkind = 'r' ORDER BY pg_total_relation_size(c.oid) DESC LIMIT 5;"
}

db_disk_report_staging_remote() {
  local dc="${STAGING_REMOTE_DOCKER_COMPOSE}"
  local b64_total b64_top
  b64_total=$(_db_disk_sql_b64 "SELECT pg_size_pretty(pg_database_size(current_database()));")
  b64_top=$(_db_disk_sql_b64 "SELECT relname AS table, pg_size_pretty(pg_total_relation_size(c.oid)) AS total_size FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' AND c.relkind = 'r' ORDER BY pg_total_relation_size(c.oid) DESC LIMIT 5;")
  echo -e "${BOLD}Postgres on staging (${STAGING_HOST} — supabase-db)${NC}"
  echo ""
  echo -e "${BOLD}Total size (current database)${NC}"
  run_staging_ssh_command "cd ${STAGING_DIR} && echo ${b64_total} | base64 -d | ${dc} -f docker-compose.staging.yml exec -T supabase-db psql -U postgres -d postgres -t -A -f -" \
    "Staging: database total size" "60"
  echo ""
  echo -e "${BOLD}Largest public tables (top 5)${NC}"
  run_staging_ssh_command "cd ${STAGING_DIR} && echo ${b64_top} | base64 -d | ${dc} -f docker-compose.staging.yml exec -T supabase-db psql -U postgres -d postgres -f -" \
    "Staging: top 5 tables by size" "60"
}

db_disk_report_mvp_remote() {
  if [[ -z "${MVP_SSH_HOST:-}" ]]; then
    echo -e "${RED}MVP_SSH_HOST is not set.${NC}"
    return 1
  fi
  local dc="${MVP_DOCKER_COMPOSE}"
  local b64_total b64_top
  b64_total=$(_db_disk_sql_b64 "SELECT pg_size_pretty(pg_database_size(current_database()));")
  b64_top=$(_db_disk_sql_b64 "SELECT relname AS table, pg_size_pretty(pg_total_relation_size(c.oid)) AS total_size FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' AND c.relkind = 'r' ORDER BY pg_total_relation_size(c.oid) DESC LIMIT 5;")
  echo -e "${BOLD}Postgres on MVP (${MVP_SSH_HOST} — supabase-db)${NC}"
  echo ""
  echo -e "${BOLD}Total size (current database)${NC}"
  run_mvp_ssh_command "cd ${MVP_APP_DIR} && echo ${b64_total} | base64 -d | ${dc} -f docker-compose.staging.yml exec -T supabase-db psql -U postgres -d postgres -t -A -f -" \
    "MVP: database total size" "90"
  echo ""
  echo -e "${BOLD}Largest public tables (top 5)${NC}"
  run_mvp_ssh_command "cd ${MVP_APP_DIR} && echo ${b64_top} | base64 -d | ${dc} -f docker-compose.staging.yml exec -T supabase-db psql -U postgres -d postgres -f -" \
    "MVP: top 5 tables by size" "90"
}

print_database_disk_usage_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo ""
  echo -e "${BOLD}Database disk usage (working target: ${t})${NC}"
  echo -e "${DIM}Shows Postgres database size and largest public tables (read-only).${NC}"
  echo ""
  case "$t" in
    local) db_disk_report_local ;;
    staging) db_disk_report_staging_remote ;;
    mvp) db_disk_report_mvp_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
}

start_external_services() {
  local target="$1"
  case "$target" in
    local)
      start_ngrok_local
      ;;
    staging)
      start_ngrok_staging_remote
      ;;
    all)
      start_ngrok_local
      start_ngrok_staging_remote
      ;;
  esac
}

stop_external_services() {
  local target="$1"
  case "$target" in
    local)
      stop_ngrok_local
      ;;
    staging)
      stop_ngrok_staging_remote
      ;;
    all)
      stop_ngrok_local
      stop_ngrok_staging_remote
      ;;
  esac
}

start_target_external() {
  local target="$1"
  case "$target" in
    local) start_ngrok_local ;;
    staging) start_ngrok_staging_remote ;;
    *) echo -e "${YELLOW}Unknown target: ${target}${NC}"; return 1 ;;
  esac
}

stop_target_external() {
  local target="$1"
  case "$target" in
    local) stop_ngrok_local ;;
    staging) stop_ngrok_staging_remote ;;
    *) echo -e "${YELLOW}Unknown target: ${target}${NC}"; return 1 ;;
  esac
}

apply_target_external() {
  local target="$1"
  local candidate

  if ! is_supported_target "$target"; then
    echo -e "${RED}Invalid target: ${target}${NC}"
    return 1
  fi
  if [[ "$target" == "mvp" ]]; then
    echo -e "${RED}MVP cannot own ${PUBLIC_MAIN_URL} via ngrok in this script.${NC}"
    echo -e "  Use ${BOLD}${MVP_UI_URL}${NC} for Azure MVP."
    return 1
  fi

  # Stop all other targets first, then start selected target.
  # Soft-fail stops so unreachable staging does not block local ngrok start.
  for candidate in local staging; do
    if [[ "$candidate" != "$target" ]]; then
      stop_target_external "$candidate" || true
    fi
  done
  start_target_external "$target"
}

switch_target() {
  echo ""
  echo -e "${BOLD}Switch public presenter (ngrok reserved domain → ${PUBLIC_MAIN_URL}):${NC}"
  echo -e "  ${DIM}Prefer menu D (Start Demo) for laptop → ${PUBLIC_DEV_URL}.${NC}"
  echo -e "  ${GREEN}1)${NC} Local (${PUBLIC_DEV_URL} discuss / preview :${LOCAL_PUBLIC_UI_PORT:-4173}; edit on :${LOCAL_UI_PORT:-5173})"
  echo -e "  ${GREEN}2)${NC} MiniPC (${PUBLIC_MAIN_URL} tunnel → staging Docker prove)"
  echo -e "  ${DIM}Azure UAT is not an option here — use ${MVP_UI_URL:-MVP_UI_URL}${NC}"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Enter target: ${NC}"
  read -r target

  case "$target" in
    1|local)
      echo -e "${CYAN}Switching target to LOCAL...${NC}"
      remember_target "local" || true
      if ! confirm_ngrok_external_start "${PUBLIC_MAIN_URL} → LOCAL (ngrok)"; then
        return 1
      fi
      apply_target_external "local"
      ;;
    2|staging)
      echo -e "${CYAN}Switching target to STAGING...${NC}"
      remember_target "staging" || true
      if ! confirm_ngrok_external_start "${PUBLIC_MAIN_URL} → STAGING (ngrok)"; then
        return 1
      fi
      apply_target_external "staging"
      ;;
    0|back|q|quit|exit)
      return 0
      ;;
    *)
      echo -e "${RED}Invalid target option${NC}"
      return 1
      ;;
  esac

  local new_target
  local new_target_upper
  local checks=0
  while [[ "$checks" -lt 8 ]]; do
    new_target=$(get_current_target)
    if [[ "$new_target" != "none" && "$new_target" != "unknown" && "$new_target" != "orphan" ]]; then
      break
    fi
    checks=$((checks + 1))
    sleep 1
  done
  new_target_upper=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}Current presenter is now:${NC} ${GREEN}${new_target_upper}${NC}"
  if [[ "$new_target" == "orphan" ]]; then
    echo -e "${YELLOW}Public tunnel still live from another host.${NC} Hint: $(infer_public_backend_hint)"
  fi
}

stop_external_everywhere() {
  echo -e "${CYAN}Stopping external access everywhere (local + staging)...${NC}"
  # Local first — immediate; do not wait on MiniPC.
  stop_target_external "local" || true
  stop_target_external "staging" || true
  echo ""
  local remembered_target pub_code gateway
  remembered_target=$(get_remembered_target)
  echo -e "${BOLD}Local ngrok stop completed; staging stop attempted (soft-fail if unreachable).${NC}"
  echo -e "${DIM}Remembered working target preserved: ${remembered_target:-none}${NC}"

  # Brief settle so Cloudflare sees origin down (worker then serves holding page).
  sleep 1
  probe_public_gateway_headers
  pub_code="$PUBLIC_PROBE_CODE"
  gateway="$PUBLIC_PROBE_GATEWAY"

  if public_is_holding_page "$pub_code" "$gateway"; then
    echo -e "${BOLD}External interface status:${NC} ${YELLOW}OFF (HOLDING)${NC}"
    echo -e "${DIM}${PUBLIC_MAIN_URL} → Cloudflare holding page (HTTP ${pub_code}, X-TaliaHub-Gateway: ${gateway}).${NC}"
    echo -e "${DIM}Expected when all ngrok endpoints for the reserved domain are stopped.${NC}"
    return 0
  fi

  if public_tunnel_appears_live; then
    echo -e "${YELLOW}${PUBLIC_MAIN_URL} is still UP (HTTP ${pub_code}, gateway=${gateway}).${NC}"
    echo -e "${DIM}An orphan tunnel still holds the reserved domain (often MiniPC ngrok while SSH is down).${NC}"
    echo -e "${DIM}Hint: $(infer_public_backend_hint)${NC}"
    echo -e "${DIM}Fix: stop the endpoint in the ngrok dashboard, or reach staging LAN/VPN and re-run external-off.${NC}"
    return 0
  fi

  echo -e "${BOLD}External interface status:${NC} ${YELLOW}OFFLINE${NC} (HTTP ${pub_code}, gateway=${gateway})"
  echo -e "${DIM}No live tunnel detected; holding page expected (HTTP 503 + X-TaliaHub-Gateway: fallback).${NC}"
}

enable_remembered_target_external() {
  local remembered_target
  local current_target
  remembered_target=$(get_remembered_target)
  current_target=$(get_current_target)

  if [[ -z "$remembered_target" ]]; then
    if is_supported_target "$current_target"; then
      remembered_target="$current_target"
      remember_target "$remembered_target" || true
    else
      echo -e "${YELLOW}No remembered target found.${NC}"
      echo -e "${YELLOW}Use option 1 to set working target (local or staging) first.${NC}"
      return 1
    fi
  fi

  if [[ "$remembered_target" == "mvp" ]]; then
    echo -e "${RED}Remembered target is MVP — ${PUBLIC_MAIN_URL} is not used for Azure.${NC}"
    echo -e "  Open ${BOLD}${MVP_UI_URL}${NC} or set-target local|staging then external-on."
    return 1
  fi

  echo -e "${CYAN}Enabling external access on remembered target: ${remembered_target}${NC}"
  if ! confirm_ngrok_external_start "${PUBLIC_MAIN_URL} → remembered target ${remembered_target} (ngrok)"; then
    return 1
  fi
  apply_target_external "$remembered_target"

  local new_target
  local new_target_upper
  new_target=$(get_current_target)
  new_target_upper=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}Current target after enable:${NC} ${GREEN}${new_target_upper}${NC}"
}

check_duplicate_dev_servers() {
  local auto_fix="${1:-false}"
  echo -e "${BOLD}Dev Server Instances:${NC}"

  if ! command -v lsof >/dev/null 2>&1; then
    echo -e "  ${YELLOW}⚠️  lsof not available; skipping duplicate checks${NC}"
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"

  # Check for multiple Vite processes (pipefail-safe when none match)
  local vite_count
  vite_count=$( { ps aux | grep -E "[v]ite" | grep -v grep || true; } | wc -l | tr -d ' ')
  local vite_pids
  vite_pids=$( { ps aux | grep -E "[v]ite" | grep -v grep || true; } | awk '{print $2}' | tr '\n' ' ' | xargs)
  local vite_ui_pids=""
  local vite_other_pids=""
  local pid
  for pid in $vite_pids; do
    local cwd
    cwd=$(get_pid_cwd "$pid")
    if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
      vite_ui_pids="${vite_ui_pids} ${pid}"
    else
      vite_other_pids="${vite_other_pids} ${pid}"
    fi
  done

  # Check for processes on dev server ports
  # NOTE: with pipefail, bare `lsof | wc` fails when nothing listens — treat empty as 0.
  local port_5173 port_5174 port_5175
  port_5173=$( { lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null || true; } | wc -l | tr -d ' ')
  port_5174=$( { lsof -nP -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null || true; } | wc -l | tr -d ' ')
  port_5175=$( { lsof -nP -iTCP:5175 -sTCP:LISTEN -t 2>/dev/null || true; } | wc -l | tr -d ' ')
  local fallback_ports=$((port_5174 + port_5175))

  local has_duplicates=false
  local vite_ui_count
  vite_ui_count=$(echo "$vite_ui_pids" | wc -w | tr -d ' ')
  [[ "$vite_ui_count" -gt 1 ]] && has_duplicates=true
  [[ "$port_5173" -gt 1 ]] && has_duplicates=true
  [[ "$fallback_ports" -gt 0 ]] && has_duplicates=true

  if $has_duplicates && [[ "$auto_fix" == "true" ]]; then
    echo -e "  ${YELLOW}⚠️  Duplicate/forbidden UI servers detected. Enforcing single-server rule on 5173...${NC}"
    local port_pids fallback_pids
    port_pids=$(collect_ui_port_pids)
    fallback_pids=$(collect_ui_fallback_port_pids)
    if [[ -n "$fallback_pids" ]]; then
      kill $fallback_pids 2>/dev/null || true
      sleep 1
      kill -9 $fallback_pids 2>/dev/null || true
    fi
    if [[ -n "$port_pids" ]]; then
      kill $port_pids 2>/dev/null || true
      sleep 1
      kill -9 $port_pids 2>/dev/null || true
    fi
    if [[ -n "$vite_ui_pids" ]]; then
      kill $vite_ui_pids 2>/dev/null || true
      sleep 1
      kill -9 $vite_ui_pids 2>/dev/null || true
    fi
    echo -e "  ${GREEN}✓${NC} Stopped all Vite/dev-port processes"
    return 0
  fi

  if [[ "$vite_ui_count" -gt 1 ]]; then
    echo -e "  ${RED}⚠️  Multiple Talia UI Vite processes detected: ${vite_ui_count}${NC}"
    echo -e "  ${YELLOW}   PIDs: ${vite_ui_pids}${NC}"
    echo -e "  ${DIM}   Run: pkill -f 'vite' && cd talia-ui && npm run dev${NC}"
    return 1
  elif [[ "$vite_ui_count" -eq 1 ]]; then
    echo -e "  ${GREEN}✓${NC} Vite processes: ${vite_ui_count} (OK)"
  else
    echo -e "  ${YELLOW}⚠️  No Vite processes found${NC}"
  fi

  if [[ "$port_5173" -gt 1 || "$fallback_ports" -gt 0 ]]; then
    echo -e "  ${RED}⚠️  UI port rule violation: only one server on 5173 is allowed${NC}"
    echo -e "  ${YELLOW}   Port 5173 listeners: ${port_5173}${NC}"
    if [[ "$port_5173" -gt 0 ]]; then
      local pids_5173
      pids_5173=$(lsof -ti:5173 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5173: ${port_5173} process(es) - PIDs: ${pids_5173}${NC}"
    fi
    if [[ "$port_5174" -gt 0 ]]; then
      local pids_5174
      pids_5174=$(lsof -ti:5174 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5174 (forbidden): ${port_5174} process(es) - PIDs: ${pids_5174}${NC}"
    fi
    if [[ "$port_5175" -gt 0 ]]; then
      local pids_5175
      pids_5175=$(lsof -ti:5175 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5175 (forbidden): ${port_5175} process(es) - PIDs: ${pids_5175}${NC}"
    fi
    echo -e "  ${DIM}   Run: lsof -ti:5174,5175 | xargs kill -9${NC}"
    return 1
  elif [[ "$port_5173" -eq 1 ]]; then
    echo -e "  ${GREEN}✓${NC} Dev server ports: single process on port 5173 (OK)"
  else
    echo -e "  ${YELLOW}⚠️  No process on UI port 5173${NC}"
  fi

  return 0
}

check_local_code_origin() {
  local auto_fix="${1:-false}"
  echo -e "${BOLD}Local Code Origin:${NC}"

  if ! command -v lsof >/dev/null 2>&1; then
    echo -e "  ${YELLOW}⚠️  lsof not available; skipping origin checks${NC}"
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"
  local api_dir="${ROOT_DIR}/talia-server"
  local issues=0

  local ui_pids
  ui_pids=$(collect_ui_port_pids)
  if [[ -z "$ui_pids" ]]; then
    echo -e "  ${YELLOW}⚠️  No UI process detected on port 5173${NC}"
  else
    local pid
    for pid in $ui_pids; do
      local cwd
      cwd=$(get_pid_cwd "$pid")
      if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
        echo -e "  ${GREEN}✓${NC} UI PID ${pid} running from ${cwd}"
      else
        echo -e "  ${RED}⚠️  UI PID ${pid} running from ${cwd:-unknown} (expected ${ui_dir})${NC}"
        ((issues++)) || true
        if [[ "$auto_fix" == "true" ]]; then
          kill "$pid" 2>/dev/null || true
          sleep 1
          kill -9 "$pid" 2>/dev/null || true
        fi
      fi
    done
  fi

  local fallback_pids
  fallback_pids=$(collect_ui_fallback_port_pids)
  if [[ -n "$fallback_pids" ]]; then
    echo -e "  ${RED}⚠️  Forbidden fallback UI port process detected (5174/5175): ${fallback_pids}${NC}"
    ((issues++)) || true
    if [[ "$auto_fix" == "true" ]]; then
      kill $fallback_pids 2>/dev/null || true
      sleep 1
      kill -9 $fallback_pids 2>/dev/null || true
      echo -e "  ${GREEN}✓${NC} Stopped fallback-port UI process(es)"
    fi
  fi

  local api_pids
  api_pids=$(lsof -nP -iTCP:4000 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true)
  if [[ -z "$api_pids" ]]; then
    echo -e "  ${YELLOW}⚠️  No API process detected on port 4000${NC}"
  else
    local pid
    for pid in $api_pids; do
      local cwd
      cwd=$(get_pid_cwd "$pid")
      if [[ -n "$cwd" && "$cwd" == "$api_dir"* ]]; then
        echo -e "  ${GREEN}✓${NC} API PID ${pid} running from ${cwd}"
      else
        echo -e "  ${RED}⚠️  API PID ${pid} running from ${cwd:-unknown} (expected ${api_dir})${NC}"
        ((issues++)) || true
        if [[ "$auto_fix" == "true" ]]; then
          kill "$pid" 2>/dev/null || true
          sleep 1
          kill -9 "$pid" 2>/dev/null || true
        fi
      fi
    done
  fi

  if [[ "$auto_fix" == "true" ]] && [[ "$issues" -gt 0 ]]; then
    echo -e "  ${GREEN}✓${NC} Stopped mismatched local processes"
  fi

  return $issues
}

run_comprehensive_check() {
  echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║${NC}${BOLD}                 COMPREHENSIVE VALIDATION                    ${NC}${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""

  echo -e "${BOLD}=== VERSIONS / COMMITS ===${NC}"
  if git -C "$ROOT_DIR" rev-parse HEAD >/dev/null 2>&1; then
    local head
    local status
    head=$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    status=$(git -C "$ROOT_DIR" status --porcelain | wc -l | tr -d ' ')
    echo -e "  ${GREEN}✓${NC} Local repo HEAD ${head} (offline; no remote compare)"
    if [[ "$status" -eq 0 ]]; then
      echo -e "  ${GREEN}✓${NC} Working tree clean"
    else
      echo -e "  ${YELLOW}⚠️${NC} Working tree has ${status} change(s)"
    fi
  else
    echo -e "  ${YELLOW}⚠️${NC} Not a git repository: ${ROOT_DIR}"
  fi

  echo ""
  echo -e "${BOLD}=== STANDARDS CHECKS ===${NC}"
  if [[ -d "${ROOT_DIR}/talia-ui" ]] && command -v npm >/dev/null 2>&1; then
    if (cd "${ROOT_DIR}/talia-ui" && npm run check:standards >/dev/null 2>&1); then
      echo -e "  ${GREEN}✓${NC} UI component standards check passed"
    else
      echo -e "  ${YELLOW}⚠️${NC} UI component standards check reported violations"
      echo -e "  ${DIM}   Run: cd talia-ui && npm run check:standards${NC}"
    fi
  else
    echo -e "  ${YELLOW}⚠️${NC} Skipping standards checks (npm or talia-ui missing)"
  fi

  echo ""
  echo -e "${BOLD}=== CONNECTIVITY / STATUS ===${NC}"
  run_script "validate-staging.sh"
}

restart_all_staging() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ngrok.service >/dev/null 2>&1 || true; sudo systemctl disable ngrok.service >/dev/null 2>&1 || true; sudo systemctl restart protonvpn-openvpn; sleep 5; sudo systemctl restart ${STAGING_NGROK_SERVICE}; sleep 5; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml restart supabase-db supabase-rest supabase-kong; sleep 5; docker compose -f docker-compose.staging.yml restart graphql-server; sleep 5; docker compose -f docker-compose.staging.yml restart ui; docker compose -f docker-compose.staging.yml up -d; sleep 10; docker compose -f docker-compose.staging.yml ps" "Restart ALL staging services"
  else
    run_script "restart-and-check.sh" "staging --restart"
  fi
}

handle_staging_menu_legacy() {
  local choice="$1"
  
  case "$choice" in
    1|local)
      run_script "validate-staging-local.sh"
      ;;
    2|staging)
      run_script "validate-staging-local.sh"
      ;;
    3|all)
      run_script "validate-staging-local.sh"
      ;;
    4|gateway)
      check_external_gateway
      ;;
    5|start-ngrok)
      if confirm_ngrok_external_start "STAGING systemd ngrok (on-host legacy menu)"; then
        run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok tunnel"
      fi
      ;;
    6|start-ngrok-staging)
      if confirm_ngrok_external_start "STAGING systemd ngrok (on-host legacy menu)"; then
        run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok tunnel"
      fi
      ;;
    7|stop-local)
      echo -e "${BOLD}Stopping local staging services:${NC}"
      run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE} || true" "Stop ngrok"
      run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging Docker"
      ;;
    8|stop-staging)
      echo -e "${BOLD}Stopping staging services:${NC}"
      run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE} || true" "Stop ngrok"
      run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging Docker"
      ;;
    9|quick|test)
      echo -e "${BOLD}Quick Connectivity Test${NC}"
      echo ""
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" || "$talia" == "302" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${RED}HTTP $talia${NC}"
      ;;
    10|restart)
      run_command "sudo systemctl restart protonvpn-openvpn && sleep 10 && sudo systemctl restart ${STAGING_NGROK_SERVICE} && sleep 5 && echo 'Services restarted' && curl -s http://localhost:4040/api/tunnels | grep -o '${LOCAL_NGROK_DOMAIN}' && echo ' tunnel active'" "Restart VPN + ngrok"
      ;;
    11|fix)
      run_command "sudo systemctl restart protonvpn-openvpn && sleep 10 && sudo systemctl restart ${STAGING_NGROK_SERVICE} && sleep 5" "Fix staging connectivity (VPN + ngrok)"
      ;;
    12|full)
      echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
      echo -e "${CYAN}║${NC}${BOLD}                    FULL SYSTEM CHECK                        ${NC}${CYAN}║${NC}"
      echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
      echo ""
      
      # Services
      echo -e "${BOLD}=== SERVICES ===${NC}"
      run_script "validate-staging-local.sh"
      
      # Docker detailed
      echo ""
      echo -e "${BOLD}=== DOCKER CONTAINERS (detailed) ===${NC}"
      docker compose -f ${STAGING_DIR}/docker-compose.staging.yml ps
      echo ""
      docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}" 2>/dev/null | head -15 || true
      
      # Network
      echo ""
      echo -e "${BOLD}=== NETWORK ===${NC}"
      echo -n "  VPN IP: "
      curl -s --max-time 5 https://api.ipify.org && echo "" || echo "timeout"
      echo -n "  VPN Interface: "
      ip addr show tun0 2>/dev/null | grep "inet " | awk '{print $2}' || echo "not found"
      echo -n "  ngrok tunnel: "
      curl -s http://localhost:4040/api/tunnels | grep -o '"public_url":"[^"]*"' | head -1 || echo "not active"
      
      # Disk
      echo ""
      echo -e "${BOLD}=== DISK USAGE ===${NC}"
      df -h / /home 2>/dev/null | grep -v "^Filesystem" | awk '{print "  " $6 ": " $3 " used / " $2 " total (" $5 " full)"}'
      
      # Memory
      echo ""
      echo -e "${BOLD}=== MEMORY ===${NC}"
      free -h | grep -E "^(Mem|Swap)" | awk '{print "  " $1 " " $3 " used / " $2 " total"}'
      
      echo ""
      echo -e "${GREEN}✅ Full check complete${NC}"
      ;;
    14|restart-all)
      restart_all_staging
      ;;
    13|comprehensive)
      run_script "validate-staging-local.sh"
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

handle_remote_menu_legacy() {
  local choice="$1"
  
  case "$choice" in
    1|local)
      # Always run local checks when on a local dev machine
      if [[ -f "${SCRIPT_DIR}/validate-staging.sh" ]]; then
        run_script "validate-staging.sh" "local"
      else
        # Fallback to inline local check
        echo -e "${BOLD}Local Environment Check${NC}"
        echo ""
        
        # Check for duplicate dev servers first
        check_duplicate_dev_servers true
        echo ""
        
        echo -n "  GraphQL (localhost:4000): "
        local gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_GRAPHQL_URL%/}" 2>/dev/null || echo "000")
        [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}OK${NC} (HTTP $gql)" || echo -e "${RED}FAIL${NC} (HTTP $gql)"
        
        echo -n "  UI (localhost:5173): "
        local ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_UI_URL%/}/" 2>/dev/null || echo "000")
        [[ "$ui" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}Not running${NC}"
        
        echo -n "  Supabase (localhost:54321): "
        local sb=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:54321/ 2>/dev/null || echo "000")
        [[ "$sb" != "000" ]] && echo -e "${GREEN}OK${NC} (HTTP $sb)" || echo -e "${RED}FAIL${NC}"
        
        echo ""
        echo -e "${BOLD}Docker Containers:${NC}"
        docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | grep -E "(NAMES|supabase_)" || echo "  No Supabase containers"
      fi
      ;;
    2|staging)
      run_script "validate-staging-connectivity.sh"
      ;;
    3|all)
      echo -e "${BOLD}=== LOCAL ===${NC}"
      handle_remote_menu "1"
      echo ""
      echo -e "${BOLD}=== STAGING ===${NC}"
      run_script "validate-staging-connectivity.sh"
      ;;
    4|gateway)
      check_external_gateway
      ;;
    5|start-ngrok)
      if confirm_ngrok_external_start "LOCAL ngrok (legacy menu)"; then start_ngrok_local; fi
      ;;
    6|start-ngrok-staging)
      if confirm_ngrok_external_start "STAGING ngrok systemd (legacy menu)"; then start_ngrok_staging_remote; fi
      ;;
    7|stop-local)
      stop_local_services
      ;;
    8|stop-staging)
      stop_staging_services_remote
      ;;
    9|quick|test)
      echo -e "${BOLD}Quick Connectivity Test${NC}"
      echo ""
      echo -n "  Ping staging (${STAGING_HOST}): "
      ping -c 1 -t 3 ${STAGING_HOST} >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  SSH to staging: "
      ssh -o ConnectTimeout=5 -o BatchMode=yes ${STAGING_SSH_TARGET} "echo ok" >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${RED}HTTP $talia${NC}"
      ;;
    10|restart)
      run_script "restart-staging-tunnel.sh"
      ;;
    11|fix)
      run_script "fix-staging-connectivity.sh"
      ;;
    12|full)
      echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
      echo -e "${CYAN}║${NC}${BOLD}                    FULL SYSTEM CHECK                        ${NC}${CYAN}║${NC}"
      echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
      echo ""
      
      # Local environment
      echo -e "${BOLD}━━━ LOCAL ENVIRONMENT (Mac) ━━━${NC}"
      echo ""
      
      # Check for duplicate dev servers first
      check_duplicate_dev_servers true
      echo ""
      
      echo -e "  ${BOLD}Services:${NC}"
      echo -n "    GraphQL (localhost:4000): "
      local gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_GRAPHQL_URL%/}" 2>/dev/null || echo "000")
      [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}OK${NC} (HTTP $gql)" || echo -e "${RED}FAIL${NC} (HTTP $gql)"
      
      echo -n "    UI (localhost:5173): "
      local ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_UI_URL%/}/" 2>/dev/null || echo "000")
      [[ "$ui" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}Not running${NC}"
      
      echo -n "    Supabase Kong (localhost:54321): "
      local sb=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:54321/ 2>/dev/null || echo "000")
      [[ "$sb" != "000" ]] && echo -e "${GREEN}OK${NC} (HTTP $sb)" || echo -e "${RED}FAIL${NC}"
      
      echo ""
      echo -e "  ${BOLD}Docker Containers:${NC}"
      docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | grep -E "(NAMES|supabase_)" | sed 's/^/    /' || echo "    No Supabase containers"
      
      # Network to staging
      echo ""
      echo -e "${BOLD}━━━ NETWORK TO STAGING ━━━${NC}"
      echo ""
      echo -n "  Ping (${STAGING_HOST}): "
      local ping_result=$(ping -c 3 -q ${STAGING_HOST} 2>/dev/null)
      if [[ $? -eq 0 ]]; then
        local ping_avg=$(echo "$ping_result" | grep "round-trip" | cut -d'/' -f5)
        local ping_loss=$(echo "$ping_result" | grep "packet loss" | grep -oE '[0-9.]+%' | head -1)
        echo -e "${GREEN}OK${NC} (avg ${ping_avg}ms, ${ping_loss} loss)"
      else
        echo -e "${RED}FAIL${NC}"
      fi
      
      echo -n "  SSH connection: "
      ssh -o ConnectTimeout=5 -o BatchMode=yes ${STAGING_SSH_TARGET} "echo ok" >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" ]] && echo -e "${GREEN}OK${NC} (HTTP 200)" || echo -e "${RED}FAIL${NC} (HTTP $talia)"
      
      # Staging environment
      echo ""
      echo -e "${BOLD}━━━ STAGING ENVIRONMENT (MiniPC) ━━━${NC}"
      echo ""
      run_script "validate-staging-connectivity.sh"
      
      # Staging Docker
      echo ""
      echo -e "  ${BOLD}Docker Containers (staging):${NC}"
      ssh ${STAGING_SSH_TARGET} "docker compose -f ${STAGING_DIR}/docker-compose.staging.yml ps --format 'table {{.Name}}\t{{.Status}}'" 2>/dev/null | sed 's/^/    /' || true
      
      # Staging resources
      echo ""
      echo -e "  ${BOLD}Staging Resources:${NC}"
      ssh ${STAGING_SSH_TARGET} "echo -n '    Disk: '; df -h / | tail -1 | awk '{print \$3 \" used / \" \$2 \" (\" \$5 \" full)\"}'; echo -n '    Memory: '; free -h | grep Mem | awk '{print \$3 \" used / \" \$2}'" 2>/dev/null || true
      
      echo ""
      echo -e "${GREEN}✅ Full check complete${NC}"
      ;;
    13|comprehensive)
      run_comprehensive_check
      ;;
    14|restart-all)
      restart_all_staging
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

generate_executive_overview_pdf() {
  run_script "generate-executive-overview-pdf.sh"
}

handle_remote_menu() {
  local choice="$1"

  case "$choice" in
    D|d|demo|start-demo|start_demo)
      start_demo_local
      ;;
    1|set-target|target|switch-target|switch)
      set_working_target_interactive
      ;;
    2|check)
      check_services_for_working_target
      ;;
    3|start|start-core)
      start_core_for_working_target
      ;;
    4|stop|stop-core)
      stop_core_for_working_target
      ;;
    5|enable-external|external-on|restart-external|external-restart|bounce-external)
      start_external_for_working_target
      ;;
    6|stop-external|external-off|offline)
      stop_external_everywhere
      ;;
    7|deploy|deploy-staging)
      deploy_to_staging_from_local
      ;;
    8|deploy-mvp|mvp-deploy|deploy_mvp)
      deploy_to_mvp_from_local
      ;;
    9|db-disk|database-disk|disk|postgres-size)
      print_database_disk_usage_for_working_target
      ;;
    10|refresh-summary|rerun-summary|rescan-summary)
      # Handled in main() so the next loop draws print_full_interactive_header; kept here for direct/CLI parity.
      print_full_interactive_header
      ;;
    11|last-summary|show-last-summary|cached-summary)
      print_cached_quick_targets_summary
      ;;
    12|advanced|complete|full)
      advanced_validate_interactive
      ;;
    13|reboot|reboot-staging)
      reboot_staging_emergency
      ;;
    14|executive-overview|executive-overview-pdf|overview-pdf|generate-executive-overview)
      generate_executive_overview_pdf
      ;;
    # Legacy numeric / names (older validate menu)
    91|remembered-external|enable-remembered-external)
      enable_remembered_target_external
      ;;
    status|summary|total)
      print_quick_targets_summary
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

handle_cli() {
  case "${1:-}" in
    set-target)
      if ! is_supported_target "${2:-}"; then
        echo "Usage: $0 set-target local|staging|mvp"
        echo "  (mvp requires MVP_VALIDATE=1 and MVP_SSH_HOST in scripts/config/targets.env)"
        return 1
      fi
      remember_target "$2"
      echo "Working target saved: $2"
      ;;
    check) check_services_for_working_target ;;
    db-disk|database-disk|postgres-size) print_database_disk_usage_for_working_target ;;
    start-core|start) start_core_for_working_target ;;
    stop-core|stop-core) stop_core_for_working_target ;;
    start-demo|demo|start_demo) start_demo_local ;;
    external-on|enable-external) start_external_for_working_target ;;
    external-off|stop-external) stop_external_everywhere ;;
    deploy|deploy-staging) deploy_to_staging_from_local ;;
    deploy-mvp|deploy-mvp-azure) deploy_to_mvp_from_local ;;
    deploy-themes-db|sync-ui-themes-staging|sync-themes-focus|sync-ui-themes-focus)
      sync_ui_themes_and_focus_definitions_db
      ;;
    reboot-staging|reboot) reboot_staging_emergency ;;
    executive-overview-pdf|executive-overview|overview-pdf|generate-executive-overview)
      generate_executive_overview_pdf
      ;;
    comprehensive) run_comprehensive_check ;;
    status|summary) print_quick_targets_summary ;;
    last-summary|show-last-summary|cached-summary) print_cached_quick_targets_summary ;;
    help|-h|--help)
      cat <<EOF
Talia validate — quick overview by default; heavy checks only from the menu or explicit commands.

  $0                              interactive menu (probe once at start; cached summary atop every menu; 10 = refresh probes)
  $0 set-target local|staging|mvp  persist working target (~/.talia-validate-last-target; mvp needs MVP_* in targets.env)
  $0 check                        deep service check for current target only
  $0 start-core                   UI + GraphQL + Supabase (local) or Docker stack (staging/MVP)
  $0 stop-core                    stop core (ngrok unchanged)
  $0 db-disk                      Postgres size + top 5 public tables for current target
  $0 start-demo                   rebuild preview + publish laptop to ${PUBLIC_DEV_URL:-https://dev.taliahub.com} (TTY: Enter; non-TTY: TALIA_CONFIRM_DEMO=1)
  $0 external-on                  ngrok → local vite preview (:4173) or staging; not MVP (TTY: ENABLE_NGROK_EXTERNAL)
  $0 external-off                 stop local ngrok immediately; soft-fail MiniPC; expect HTTP 503 holding page (or report ORPHAN)
  $0 deploy-staging               local-sync deploy to staging (default UI paths; full stack only if you pick it)
  $0 deploy-mvp                   deploy to MVP (same; wide modes require explicit flags inside the script)
  $0 deploy-themes-db             upsert themes + focus rows from local Supabase → staging and/or MVP (no code deploy)
  $0 reboot-staging               emergency reboot of staging host (confirmation required)
  $0 executive-overview-pdf       regenerate docs/EXECUTIVE-OVERVIEW.pdf from docs/EXECUTIVE-OVERVIEW.html
  $0 comprehensive                full repo validation (slow)
  $0 status                       full probe + transcript; refreshes ~/.talia-validate-last-summary.{txt,state}
  $0 last-summary                 live header + snapshot body (light HTTP on header; run status first for data)
EOF
      ;;
    *)
      echo "Unknown command: ${1:-}. Try: $0 help"
      return 1
      ;;
  esac
}

# Main
main() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
      handle_remote_menu "$1"
    else
      handle_cli "$@"
    fi
    exit $?
  fi

  local validate_menu_full_scan=1
  while true; do
    if [[ "$validate_menu_full_scan" -eq 1 ]]; then
      print_full_interactive_header
      validate_menu_full_scan=0
    else
      print_interactive_header_from_cache
    fi
    print_menu

    echo -n -e "${BOLD}Enter choice: ${NC}"
    read -r choice

    case "$choice" in
      10|refresh|refresh-summary|rerun-summary|rescan|rescan-summary)
        validate_menu_full_scan=1
        continue
        ;;
      11|last-summary|show-last-summary|cached-summary)
        print_cached_quick_targets_summary || true
        wait_for_key
        continue
        ;;
    esac

    handle_remote_menu "$choice" || true

    wait_for_key
  done
}

main "$@"
