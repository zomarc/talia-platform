#!/bin/bash
#
# Interactive Talia Validation Menu
# Calls underlying validation scripts based on user selection
#
# Usage:
#   ./scripts/validate                    # Interactive menu (fast overview, then actions)
#   ./scripts/validate set-target local|staging
#   ./scripts/validate check              # Deep checks for current working target only
#   ./scripts/validate start-core | stop-core
#   ./scripts/validate external-on | external-off
#   ./scripts/validate comprehensive      # Full validate-staging.sh (slow)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPT_VERSION="2026-04-08.1"
CONFIG_FILE="${SCRIPT_DIR}/config/targets.env"
if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

locale_supports_utf8() {
  local lc
  lc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
  [[ "$lc" == *"UTF-8"* || "$lc" == *"utf8"* || "$lc" == *"UTF8"* ]]
}

# Detect environment
HOSTNAME=$(hostname)
IS_ON_STAGING=false
if [[ "$HOSTNAME" == "zomarcsvr" ]] || [[ -f "${STAGING_APP_DIR:-/home/zomarc/talia-docker}/docker-compose.staging.yml" ]]; then
  IS_ON_STAGING=true
fi

# Resolved target variables (configurable for future environments)
STAGING_USER="${STAGING_USER:-${STAGING_SSH_USER:-zomarc}}"
STAGING_HOST="${STAGING_HOST:-${STAGING_SSH_HOST:-192.168.1.120}}"
STAGING_DIR="${STAGING_DIR:-${STAGING_APP_DIR:-/home/${STAGING_USER}/talia-docker}}"
STAGING_NGROK_SERVICE="${STAGING_NGROK_SERVICE:-ngrok-taliahub}"

LOCAL_UI_URL="${LOCAL_UI_URL:-http://${LOCAL_UI_HOST:-127.0.0.1}:${LOCAL_UI_PORT:-5173}}"
LOCAL_GRAPHQL_URL="${LOCAL_GRAPHQL_URL:-http://${LOCAL_GRAPHQL_HOST:-127.0.0.1}:${LOCAL_GRAPHQL_PORT:-4000}/graphql}"
LOCAL_SUPABASE_HOST="${LOCAL_SUPABASE_HOST:-127.0.0.1}"
LOCAL_SUPABASE_KONG_PORT="${LOCAL_SUPABASE_KONG_PORT:-54321}"
LOCAL_SUPABASE_URL="${LOCAL_SUPABASE_URL:-http://${LOCAL_SUPABASE_HOST}:${LOCAL_SUPABASE_KONG_PORT}/}"
STAGING_UI_URL="${STAGING_UI_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_UI_PORT:-5173}}"
STAGING_GRAPHQL_URL="${STAGING_GRAPHQL_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_GRAPHQL_PORT:-4000}/graphql}"
if $IS_ON_STAGING; then
  DEFAULT_STAGING_SUPABASE_KONG_PORT=8000
else
  DEFAULT_STAGING_SUPABASE_KONG_PORT=54321
fi
STAGING_SUPABASE_KONG_PORT="${STAGING_SUPABASE_KONG_PORT:-${DEFAULT_STAGING_SUPABASE_KONG_PORT}}"
STAGING_SUPABASE_URL="${STAGING_SUPABASE_URL:-http://${STAGING_UI_HOST:-${STAGING_HOST}}:${STAGING_SUPABASE_KONG_PORT}/}"

PUBLIC_MAIN_URL="${PUBLIC_MAIN_URL:-https://taliahub.com}"
PUBLIC_SECONDARY_URL="${PUBLIC_SECONDARY_URL:-https://celestyal.taliahub.com}"
NGROK_BASIC_USER="${NGROK_BASIC_USER:-talia}"
NGROK_BASIC_PASS="${NGROK_BASIC_PASS:-dev2025tal}"
STAGING_SSH_TARGET="${STAGING_USER}@${STAGING_HOST}"
STAGING_SSH_BASE_OPTS="${STAGING_SSH_BASE_OPTS:--o ConnectTimeout=5 -o ConnectionAttempts=1 -o ServerAliveInterval=5 -o ServerAliveCountMax=1 -o BatchMode=yes}"
STAGING_SSH_READY_ATTEMPTS="${STAGING_SSH_READY_ATTEMPTS:-5}"
STAGING_REMOTE_CMD_RETRIES="${STAGING_REMOTE_CMD_RETRIES:-2}"
LOCAL_NGROK_DOMAIN="${LOCAL_NGROK_DOMAIN:-${PUBLIC_MAIN_URL#https://}}"
LOCAL_NGROK_DOMAIN="${LOCAL_NGROK_DOMAIN#http://}"

# External target memory (persists across runs)
TARGET_STATE_FILE="${TARGET_STATE_FILE:-${HOME}/.talia-validate-last-target}"

get_http_code() {
  local url="$1"
  curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "$url" 2>/dev/null || echo "000"
}

get_ui_version() {
  local base_url="$1"
  python3 - "$base_url" <<'PY'
import re
import sys
import urllib.request

base = sys.argv[1].rstrip("/")
try:
    html = urllib.request.urlopen(f"{base}/", timeout=4).read().decode("utf-8", "ignore")
except Exception:
    print("UNREACHABLE")
    raise SystemExit(0)

asset_match = re.search(r'assets/index-[^"\']+\.js', html)
if not asset_match:
    print("NO_ASSET")
    raise SystemExit(0)

asset = asset_match.group(0)
try:
    js = urllib.request.urlopen(f"{base}/{asset}", timeout=4).read().decode("utf-8", "ignore")
except Exception:
    print("NO_BUNDLE")
    raise SystemExit(0)

versions = sorted({int(n) for n in re.findall(r'0\.1\.(\d+)', js)}, reverse=True)
if versions:
    print(f"0.1.{versions[0]}")
else:
    print("UNKNOWN")
PY
}

collect_ui_port_pids() {
  if ! command -v lsof >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true
}

collect_ui_fallback_port_pids() {
  if ! command -v lsof >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  { lsof -nP -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null; lsof -nP -iTCP:5175 -sTCP:LISTEN -t 2>/dev/null; } | tr '\n' ' ' | xargs || true
}

get_pid_cwd() {
  local pid="$1"
  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
}

stop_port_processes() {
  local pids="$1"
  local description="$2"
  if [[ -n "$pids" ]]; then
    kill $pids 2>/dev/null || true
    sleep 1
    kill -9 $pids 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} Stopped ${description}"
  else
    echo -e "  ${DIM}No processes for ${description}${NC}"
  fi
}

verify_ui_port_owner() {
  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"
  local pids
  pids=$(lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true)
  [[ -z "$pids" ]] && return 0

  local invalid=0
  local pid
  for pid in $pids; do
    local cwd cmd
    cwd=$(get_pid_cwd "$pid")
    cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
    if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
      continue
    fi
    echo -e "  ${RED}✗ Port 5173 is occupied by non-Talia process${NC}"
    echo -e "  ${YELLOW}  PID:${NC} ${pid}"
    echo -e "  ${YELLOW}  CWD:${NC} ${cwd:-unknown}"
    echo -e "  ${YELLOW}  CMD:${NC} ${cmd:-unknown}"
    invalid=1
  done

  if [[ "$invalid" -eq 1 ]]; then
    echo -e "  ${RED}Refusing to start local UI. Port 5173 must be owned by talia-ui only.${NC}"
    return 1
  fi
  return 0
}

get_local_source_version() {
  python3 - "$ROOT_DIR" <<'PY'
import json
import os
import sys

root = sys.argv[1]
path = os.path.join(root, "talia-ui", "package.json")
try:
    with open(path, "r", encoding="utf-8") as f:
        print(json.load(f).get("version", "UNKNOWN"))
except Exception:
    print("UNKNOWN")
PY
}

get_display_version() {
  local url="$1"
  local version
  version=$(get_ui_version "$url")
  if [[ "$version" == "NO_ASSET" && "$url" == "$LOCAL_UI_URL" ]]; then
    local local_src
    local_src=$(get_local_source_version)
    if [[ "$local_src" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      echo "${local_src} (dev)"
      return 0
    fi
  fi
  echo "$version"
}

is_supported_target() {
  case "$1" in
    local|staging) return 0 ;;
    *) return 1 ;;
  esac
}

get_target_direct_url() {
  case "$1" in
    local) echo "$LOCAL_UI_URL" ;;
    staging) echo "$STAGING_UI_URL" ;;
    *) echo "" ;;
  esac
}

get_target_external_state() {
  local target="$1"
  case "$target" in
    local)
      if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
        echo "active"
      else
        echo "inactive"
      fi
      ;;
    staging)
      if $IS_ON_STAGING; then
        sudo systemctl is-active "$STAGING_NGROK_SERVICE" 2>/dev/null || echo "inactive"
      else
        local status
        # sudo -n avoids a password prompt; outer sleep caps total wait
        status=$(ssh_staging_with_timeout 5 "sudo -n systemctl is-active $STAGING_NGROK_SERVICE 2>/dev/null || echo inactive" | head -n 1)
        [[ -z "$status" ]] && status="unreachable"
        echo "$status"
      fi
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

remember_target() {
  local target="$1"
  if ! is_supported_target "$target"; then
    return 1
  fi
  printf "%s\n" "$target" > "$TARGET_STATE_FILE"
}

get_remembered_target() {
  if [[ ! -f "$TARGET_STATE_FILE" ]]; then
    echo ""
    return 0
  fi
  local saved
  saved=$(tr -d '[:space:]' < "$TARGET_STATE_FILE" 2>/dev/null || true)
  if is_supported_target "$saved"; then
    echo "$saved"
  else
    echo ""
  fi
}

get_current_target() {
  local local_ngrok
  local staging_ngrok
  local presenter

  local_ngrok=$(get_target_external_state "local")
  staging_ngrok=$(get_target_external_state "staging")

  presenter="unknown"
  if [[ "$local_ngrok" == "active" && "$staging_ngrok" != "active" ]]; then
    presenter="local"
  elif [[ "$local_ngrok" != "active" && "$staging_ngrok" == "active" ]]; then
    presenter="staging"
  elif [[ "$local_ngrok" == "active" && "$staging_ngrok" == "active" ]]; then
    presenter="conflict"
  elif [[ "$local_ngrok" != "active" && "$staging_ngrok" != "active" ]]; then
    presenter="none"
  fi

  echo "$presenter"
}

get_effective_working_target() {
  local remembered
  remembered=$(get_remembered_target)
  if [[ -n "$remembered" ]]; then
    echo "$remembered"
    return 0
  fi
  if $IS_ON_STAGING; then
    echo "staging"
  else
    echo "local"
  fi
}

get_http_code_quick() {
  local url="$1"
  local max_time="${2:-2}"
  local out
  out=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time "$max_time" "$url" 2>/dev/null) || true
  if [[ -z "$out" ]]; then
    echo "000"
  else
    echo "$out"
  fi
}

# Run SSH remote command with a hard wall-clock limit (avoids rare hangs).
ssh_staging_with_timeout() {
  local sec="$1"
  shift
  local outf pidf killer
  outf=$(mktemp "${TMPDIR:-/tmp}/talia-ssh-out.XXXXXX")
  pidf=$(mktemp "${TMPDIR:-/tmp}/talia-ssh-pid.XXXXXX")
  ssh $STAGING_SSH_BASE_OPTS "$STAGING_SSH_TARGET" "$@" >"$outf" 2>/dev/null &
  echo $! >"$pidf"
  ( sleep "$sec"; kill "$(cat "$pidf" 2>/dev/null)" 2>/dev/null || true ) &
  killer=$!
  wait "$(cat "$pidf")" 2>/dev/null || true
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
  cat "$outf" 2>/dev/null || true
  rm -f "$outf" "$pidf"
}

check_staging_ssh_ready() {
  if $IS_ON_STAGING; then
    return 0
  fi

  local attempt out cleaned last_error attempts
  attempts="${STAGING_SSH_READY_ATTEMPTS}"
  echo -e "  Checking SSH reachability to ${STAGING_SSH_TARGET}..."
  for ((attempt=1; attempt<=attempts; attempt++)); do
    out=$(ssh_staging_with_timeout 8 "echo ok")
    cleaned=$(echo "$out" | tr -d '\r' | awk 'NF{print; exit}')
    if [[ "$cleaned" == "ok" ]]; then
      echo -e "  ${GREEN}✓${NC} SSH reachable (attempt ${attempt}/${attempts})"
      return 0
    fi
    if [[ -n "$cleaned" ]]; then
      last_error="$cleaned"
      echo -e "  ${DIM}Attempt ${attempt}/${attempts} failed: ${cleaned}${NC}"
    else
      last_error="timeout/no response"
      echo -e "  ${DIM}Attempt ${attempt}/${attempts} failed: timeout/no response${NC}"
    fi
    sleep 1
  done

  echo -e "  ${RED}✗ Cannot reach staging over SSH (${STAGING_SSH_TARGET})${NC}"
  echo -e "  ${YELLOW}Last error:${NC} ${last_error}"
  echo -e "  ${YELLOW}Check VPN/LAN path and SSH service on ${STAGING_HOST}:${NC}22"
  return 1
}

run_staging_ssh_command() {
  local remote_cmd="$1"
  local desc="$2"
  local timeout_sec="${3:-60}"
  local attempt rc retries

  retries="${STAGING_REMOTE_CMD_RETRIES}"
  for ((attempt=1; attempt<=retries; attempt++)); do
    check_staging_ssh_ready || return 1
    echo -e "  ${DIM}Remote attempt ${attempt}/${retries}${NC}"
    run_command "ssh ${STAGING_SSH_BASE_OPTS} ${STAGING_SSH_TARGET} \"$remote_cmd\"" "$desc" "$timeout_sec"
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      return 0
    fi
    if [[ "$attempt" -lt "$retries" ]]; then
      echo -e "  ${YELLOW}Retrying remote command after failure (exit ${rc})...${NC}"
      sleep 2
    fi
  done
  return "$rc"
}

is_quick_up() {
  local code="$1"
  local kind="$2"
  if [[ "$kind" == "gql" ]]; then
    [[ "$code" == "200" || "$code" == "400" ]]
    return $?
  fi
  if [[ "$kind" == "kong" ]]; then
    case "$code" in
      200|301|302|401|403|404) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [[ "$code" == "200" || "$code" == "302" ]]
}

target_status_label() {
  local target="$1"
  local loc_ui="$2" loc_gql="$3" loc_sb="$4"
  local st_ui="$5" st_gql="$6" st_sb="$7"
  if [[ "$target" == "local" ]]; then
    if is_quick_up "$loc_ui" "ui" && is_quick_up "$loc_gql" "gql" && is_quick_up "$loc_sb" "kong" && is_docker_ready; then
      echo -e "${GREEN}UP${NC}"
    else
      echo -e "${YELLOW}DOWN${NC}"
    fi
    return 0
  fi
  if [[ "$target" == "staging" ]]; then
    if is_quick_up "$st_ui" "ui" && is_quick_up "$st_gql" "gql" && is_quick_up "$st_sb" "kong"; then
      echo -e "${GREEN}UP${NC}"
    else
      echo -e "${YELLOW}DOWN${NC}"
    fi
    return 0
  fi
  echo -e "${DIM}UNKNOWN${NC}"
}

target_status_plain() {
  local target="$1"
  local loc_ui="$2" loc_gql="$3" loc_sb="$4"
  local st_ui="$5" st_gql="$6" st_sb="$7"
  if [[ "$target" == "local" ]]; then
    if is_quick_up "$loc_ui" "ui" && is_quick_up "$loc_gql" "gql" && is_quick_up "$loc_sb" "kong" && is_docker_ready; then
      echo "UP"
    else
      echo "DOWN"
    fi
    return 0
  fi
  if [[ "$target" == "staging" ]]; then
    if is_quick_up "$st_ui" "ui" && is_quick_up "$st_gql" "gql" && is_quick_up "$st_sb" "kong"; then
      echo "UP"
    else
      echo "DOWN"
    fi
    return 0
  fi
  echo "UNKNOWN"
}

external_status_label() {
  local presenter="$1"
  local pub_code="$2"
  local gateway="$3"
  local src

  case "$presenter" in
    local|staging) src=$(echo "$presenter" | tr '[:lower:]' '[:upper:]') ;;
    conflict) src="CONFLICT" ;;
    none) src="NONE" ;;
    *) src="UNKNOWN" ;;
  esac

  if [[ "$presenter" == "local" || "$presenter" == "staging" ]]; then
    if [[ "$gateway" == "proxied" ]] || [[ "$pub_code" == "200" || "$pub_code" == "302" || "$pub_code" == "401" || "$pub_code" == "403" ]]; then
      echo -e "${GREEN}UP${NC} (${src})"
      return 0
    fi
  fi
  echo -e "${YELLOW}DOWN${NC} (${src})"
}

external_status_plain() {
  local presenter="$1"
  local pub_code="$2"
  local gateway="$3"
  local src status="DOWN"

  case "$presenter" in
    local|staging) src=$(echo "$presenter" | tr '[:lower:]' '[:upper:]') ;;
    conflict) src="CONFLICT" ;;
    none) src="NONE" ;;
    *) src="UNKNOWN" ;;
  esac

  if [[ "$presenter" == "local" || "$presenter" == "staging" ]]; then
    if [[ "$gateway" == "proxied" ]] || [[ "$pub_code" == "200" || "$pub_code" == "302" || "$pub_code" == "401" || "$pub_code" == "403" ]]; then
      status="UP"
    fi
  fi
  echo "${status} (${src})"
}

print_quick_targets_summary() {
  local work presenter top_level_version
  local loc_ui loc_gql loc_sb st_ui st_gql st_sb pub_code gateway ext_line
  local loc_ui_version st_ui_version pub_ui_version
  local target_status_plain_text ext_status_plain_text
  local local_marker staging_marker
  local header_sep
  work=$(get_effective_working_target)
  presenter=$(get_current_target)

  loc_ui=$(get_http_code_quick "${LOCAL_UI_URL}/" 1)
  loc_gql=$(get_http_code_quick "${LOCAL_GRAPHQL_URL%/}" 1)
  loc_sb=$(get_http_code_quick "${LOCAL_SUPABASE_URL}" 1)

  if $IS_ON_STAGING; then
    st_ui=$(get_http_code_quick "${STAGING_UI_URL}/" 1)
    st_gql=$(get_http_code_quick "${STAGING_GRAPHQL_URL%/}" 1)
    st_sb=$(get_http_code_quick "${STAGING_SUPABASE_URL}" 1)
  else
    st_ui=$(get_http_code_quick "${STAGING_UI_URL}/" 1)
    st_gql=$(get_http_code_quick "${STAGING_GRAPHQL_URL%/}" 1)
    st_sb=$(get_http_code_quick "${STAGING_SUPABASE_URL}" 1)
  fi

  local pub_headers
  pub_headers=$(curl -sS -I --connect-timeout 2 --max-time 2 "${PUBLIC_MAIN_URL}/" 2>/dev/null || true)
  pub_code=$(echo "$pub_headers" | awk 'NR==1{print $2}')
  gateway=$(echo "$pub_headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
  [[ -z "$pub_code" ]] && pub_code="000"
  [[ -z "$gateway" ]] && gateway="n/a"

  loc_ui_version=$(quick_ui_version_label "${LOCAL_UI_URL}" "${loc_ui}" "true")
  st_ui_version=$(quick_ui_version_label "${STAGING_UI_URL}" "${st_ui}" "false")
  pub_ui_version=$(quick_ui_version_label "${PUBLIC_MAIN_URL}" "${pub_code}" "false")

  case "$presenter" in
    local)
      top_level_version="${loc_ui_version} (via local presenter)"
      ;;
    staging)
      top_level_version="${st_ui_version} (via staging presenter)"
      ;;
    conflict)
      top_level_version="CONFLICT (both local and staging presenters active)"
      ;;
    *)
      if [[ "$pub_ui_version" == "n/a (DOWN)" ]]; then
        top_level_version="UNAVAILABLE (public gateway fallback/inactive)"
      else
        top_level_version="${pub_ui_version} (public)"
      fi
      ;;
  esac

  case "$presenter" in
    local) ext_line="${GREEN}active → local${NC}" ;;
    staging) ext_line="${BLUE}active → staging${NC}" ;;
    conflict) ext_line="${RED}CONFLICT (local + staging both on)${NC}" ;;
    none) ext_line="${YELLOW}inactive${NC} (Cloudflare / holding page expected)" ;;
    *) ext_line="${DIM}unknown${NC}" ;;
  esac

  local work_color="$YELLOW"
  local work_u
  work_u=$(echo "$work" | tr '[:lower:]' '[:upper:]')
  [[ "$work" == "local" ]] && work_color="$GREEN"
  [[ "$work" == "staging" ]] && work_color="$BLUE"
  target_status_plain_text=$(target_status_plain "$work" "$loc_ui" "$loc_gql" "$loc_sb" "$st_ui" "$st_gql" "$st_sb")
  ext_status_plain_text=$(external_status_plain "$presenter" "$pub_code" "$gateway")
  local_marker=" "
  staging_marker=" "
  [[ "$work" == "local" ]] && local_marker="▶"
  [[ "$work" == "staging" ]] && staging_marker="▶"

  header_sep=$(printf '%*s' 96 '' | tr ' ' '-')
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${BOLD}TALIA OPS - ${work_u}${NC}"
  echo -e "Version: ${top_level_version}"
  echo -e "Target: ${target_status_plain_text}   External: ${ext_status_plain_text}"
  echo -e "${CYAN}${header_sep}${NC}"
  echo -e "${DIM}Host: ${HOSTNAME} · ${SCRIPT_VERSION} · $(date '+%Y-%m-%d %H:%M:%S')${NC}"
  echo -e "  ${BOLD}Public demo${NC}: ${PUBLIC_MAIN_URL} (${ext_line})"
  local rem_disp
  rem_disp=$(get_remembered_target)
  [[ -z "$rem_disp" ]] && rem_disp="(default by host)"
  echo -e "  ${DIM}Remembered target: ${rem_disp} (${TARGET_STATE_FILE/#$HOME/~})${NC}"
  echo ""
  echo -e "${BOLD}Endpoints${NC}"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "Local" "${LOCAL_UI_HOST}:${LOCAL_UI_PORT} UI" "$(quick_up_label "$loc_ui" "200")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "${LOCAL_GRAPHQL_HOST}:${LOCAL_GRAPHQL_PORT} GraphQL" "$(quick_up_label "$loc_gql" "gql")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "${LOCAL_SUPABASE_HOST}:${LOCAL_SUPABASE_KONG_PORT} Supabase Kong" "$(quick_up_label "$loc_sb" "kong")"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "" "Docker daemon (local)" "$(docker_status_label)"
  echo ""
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "Staging" "${STAGING_UI_HOST:-?}:${STAGING_UI_PORT} UI" "$(quick_up_label "$st_ui" "200")"
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "" "${STAGING_UI_HOST:-?}:${STAGING_GRAPHQL_PORT:-4000} GraphQL" "$(quick_up_label "$st_gql" "gql")"
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "" "${STAGING_UI_HOST:-?}:${STAGING_SUPABASE_KONG_PORT} Kong" "$(quick_up_label "$st_sb" "kong")"
  echo ""
  printf "  %-10s  %-36s  HTTP %s  gateway=%s\n" "External" "${PUBLIC_MAIN_URL}" "${pub_code}" "${gateway}"
  echo ""
  echo -e "${BOLD}Deployed Versions${NC}"
  printf "  %s %-9s  %-36s  %s\n" "$local_marker" "Local" "${LOCAL_UI_URL}" "${loc_ui_version}"
  printf "  %s %-9s  %-36s  %s\n" "$staging_marker" "Staging" "${STAGING_UI_URL}" "${st_ui_version}"
  printf "  %-10s  %-36s  %s\n" "Public" "${PUBLIC_MAIN_URL}" "${pub_ui_version}"
  echo ""
}

quick_up_label() {
  local code="$1"
  local kind="$2"
  if [[ "$kind" == "gql" ]]; then
    if [[ "$code" == "200" || "$code" == "400" ]]; then
      echo -e "${GREEN}UP${NC} (${code})"
    else
      echo -e "${YELLOW}DOWN${NC} (${code})"
    fi
  elif [[ "$kind" == "kong" ]]; then
    case "$code" in
      200|301|302|401|403|404) echo -e "${GREEN}UP${NC} (${code})" ;;
      *) echo -e "${YELLOW}DOWN${NC} (${code})" ;;
    esac
  else
    if [[ "$code" == "200" || "$code" == "302" ]]; then
      echo -e "${GREEN}UP${NC} (${code})"
    else
      echo -e "${YELLOW}DOWN${NC} (${code})"
    fi
  fi
}

docker_status_label() {
  if ! command -v docker >/dev/null 2>&1; then
    echo -e "${YELLOW}MISSING${NC} (docker CLI not found)"
    return 0
  fi
  if docker info >/dev/null 2>&1; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC} (daemon unreachable)"
  fi
}

quick_ui_version_label() {
  local base_url="$1"
  local http_code="$2"
  local use_display="${3:-false}"
  local raw

  case "$http_code" in
    200|302) ;;
    *) echo "n/a (DOWN)"; return 0 ;;
  esac

  if [[ "$use_display" == "true" ]]; then
    raw=$(get_display_version "$base_url")
  else
    raw=$(get_ui_version "$base_url")
  fi

  if [[ "$raw" =~ ^0\.1\.[0-9]+$ ]]; then
    echo "v${raw}"
  elif [[ "$raw" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
    echo "v${raw}"
  else
    echo "$raw"
  fi
}

print_front_page_status() {
  local local_ui_url="$LOCAL_UI_URL"
  local staging_ui_url="$STAGING_UI_URL"
  local public_url="$PUBLIC_MAIN_URL"
  local local_ui_code
  local staging_ui_code
  local public_code
  local local_ui_version
  local staging_ui_version
  local public_version
  local local_ngrok
  local staging_ngrok
  local presenter
  local target_status
  local local_status
  local staging_status
  local headers
  local gateway
  local local_external_label
  local staging_external_label
  local remembered_target

  local_ui_code=$(get_http_code "${local_ui_url}/")
  staging_ui_code=$(get_http_code "${staging_ui_url}/")
  public_code=$(get_http_code "${public_url}/")

  local_ui_version=$(get_display_version "${local_ui_url}")
  staging_ui_version=$(get_display_version "${staging_ui_url}")
  public_version=$(get_ui_version "${public_url}")

  local_ngrok=$(get_target_external_state "local")
  staging_ngrok=$(get_target_external_state "staging")

  headers=$(curl -sS -I --max-time 6 "${public_url}" 2>/dev/null || true)
  gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
  [[ -z "$gateway" ]] && gateway="n/a"

  presenter=$(get_current_target)
  remembered_target=$(get_remembered_target)

  # Public endpoint may hide/reshape assets; infer version from active presenter when needed.
  if [[ ! "$public_version" =~ ^0\.1\.[0-9]+$ ]]; then
    if [[ "$presenter" == "local" ]]; then
      public_version="${local_ui_version} (via local)"
    elif [[ "$presenter" == "staging" ]]; then
      public_version="${staging_ui_version} (via staging)"
    fi
  elif [[ "$public_version" =~ ^0\.1\.[0-9]+$ ]]; then
    public_version="v${public_version}"
  fi

  if [[ "$public_code" == "200" || "$public_code" == "302" ]]; then
    target_status="UP"
  elif [[ "$public_code" == "000" ]]; then
    target_status="DOWN"
  else
    target_status="WARN"
  fi

  if [[ "$local_ui_code" == "200" || "$local_ui_code" == "302" ]]; then
    local_status="UP"
  else
    local_status="DOWN"
  fi

  if [[ "$staging_ui_code" == "200" || "$staging_ui_code" == "302" ]]; then
    staging_status="UP"
  else
    staging_status="DOWN"
  fi

  local_external_label="${PUBLIC_MAIN_URL} (inactive)"
  staging_external_label="${PUBLIC_MAIN_URL} (inactive)"
  if [[ "$presenter" == "local" ]]; then
    local_external_label="${PUBLIC_MAIN_URL} (active)"
  elif [[ "$presenter" == "staging" ]]; then
    staging_external_label="${PUBLIC_MAIN_URL} (active)"
  elif [[ "$presenter" == "conflict" ]]; then
    local_external_label="${PUBLIC_MAIN_URL} (conflict)"
    staging_external_label="${PUBLIC_MAIN_URL} (conflict)"
  fi

  echo -e "  ${BOLD}Front Page Status${NC}"
  echo -e "  1) ${PUBLIC_MAIN_URL} target: ${BOLD}${presenter}${NC} (gateway=${gateway})"
  echo -e "  2) target version: ${public_version}"
  echo -e "  3) target status: ${target_status} (HTTP ${public_code})"
  echo -e "  4) local: ${local_status} (HTTP ${local_ui_code}, v${local_ui_version}) | staging: ${staging_status} (HTTP ${staging_ui_code}, v${staging_ui_version})"
  echo -e "     Remembered target -> ${remembered_target:-none}"
  echo -e "     Local addresses   -> direct: ${local_ui_url} | external: ${local_external_label}"
  echo -e "     Staging addresses -> direct: ${staging_ui_url} | external: ${staging_external_label}"
  echo -e "     External aliases  -> ${PUBLIC_MAIN_URL} | ${PUBLIC_SECONDARY_URL}"
  echo ""
}

print_header() {
  clear
  echo ""
  print_quick_targets_summary
}

print_menu() {
  echo -e "${BOLD}Actions (core)${NC}"
  echo ""

  echo -e "  ${GREEN}1)${NC} Set working target (local / staging)"
  echo -e "  ${GREEN}2)${NC} Check services (deep check, current target only)"
  echo -e "  ${GREEN}3)${NC} Start core services (UI + GraphQL + Supabase stack)"
  echo -e "  ${GREEN}4)${NC} Stop core services"
  echo -e "  ${GREEN}5)${NC} Start external access (${PUBLIC_MAIN_URL#https://} → this target)"
  echo -e "  ${GREEN}6)${NC} Stop external access (ngrok off; Cloudflare shows unavailable)"
  echo ""
  echo -e "${BOLD}Advanced${NC}"
  echo ""
  echo -e "  ${GREEN}7)${NC} Full validation / gateway detail (slower)"
  echo -e "  ${GREEN}8)${NC} Deploy to staging (local sync)"
  echo ""
  echo -e "  ${YELLOW}0)${NC} Exit"
  echo ""
}

run_script() {
  local script="$1"
  local args="${2:-}"
  
  if [[ -f "${SCRIPT_DIR}/${script}" ]]; then
    echo ""
    echo -e "${CYAN}Running: ${script} ${args}${NC}"
    echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
    echo ""
    "${SCRIPT_DIR}/${script}" $args
    local exit_code=$?
    echo ""
    echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
    return $exit_code
  else
    echo -e "${RED}Error: Script not found: ${script}${NC}"
    return 1
  fi
}

run_command() {
  local cmd="$1"
  local desc="$2"
  local timeout_sec="${3:-180}"
  local start_epoch now elapsed exit_code
  local cmd_pid

  echo ""
  echo -e "${CYAN}${desc}${NC}"
  echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
  echo ""
  echo -e "${DIM}Command:${NC} ${cmd}"
  echo ""

  start_epoch=$(date +%s)
  ( eval "$cmd" ) &
  cmd_pid=$!

  while kill -0 "$cmd_pid" 2>/dev/null; do
    now=$(date +%s)
    elapsed=$((now - start_epoch))
    if [[ "$elapsed" -ge "$timeout_sec" ]]; then
      echo -e "  ${RED}✗ Timed out after ${elapsed}s${NC}"
      kill "$cmd_pid" 2>/dev/null || true
      sleep 1
      kill -9 "$cmd_pid" 2>/dev/null || true
      exit_code=124
      break
    fi
    echo -e "  ${DIM}... running (${elapsed}s elapsed)${NC}"
    sleep 3
  done

  if [[ -z "${exit_code:-}" ]]; then
    wait "$cmd_pid"
    exit_code=$?
    now=$(date +%s)
    elapsed=$((now - start_epoch))
  fi

  if [[ "$exit_code" -eq 0 ]]; then
    echo -e "  ${GREEN}✓ Completed in ${elapsed}s${NC}"
  else
    echo -e "  ${RED}✗ Failed in ${elapsed}s (exit ${exit_code})${NC}"
  fi
  echo ""
  echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"
  return "$exit_code"
}

wait_for_key() {
  echo ""
  echo -e "${DIM}Press any key to continue...${NC}"
  read -n 1 -s
}

is_docker_ready() {
  if ! command -v docker >/dev/null 2>&1; then
    return 1
  fi
  docker info >/dev/null 2>&1
}

ensure_docker_runtime_up() {
  local wait_seconds="${1:-60}"
  local elapsed=0
  local startup_attempted=false

  if is_docker_ready; then
    return 0
  fi

  echo -e "  ${YELLOW}Docker daemon is not reachable; attempting to start it...${NC}"

  if [[ "$OSTYPE" == "darwin"* ]]; then
    if command -v open >/dev/null 2>&1; then
      if open -g -a Docker >/dev/null 2>&1; then
        startup_attempted=true
        echo -e "  ${DIM}Requested Docker Desktop startup${NC}"
      elif open -g -a OrbStack >/dev/null 2>&1; then
        startup_attempted=true
        echo -e "  ${DIM}Requested OrbStack startup${NC}"
      fi
    fi
  fi

  if [[ "$startup_attempted" == false ]] && command -v colima >/dev/null 2>&1; then
    if colima start >/dev/null 2>&1; then
      startup_attempted=true
      echo -e "  ${DIM}Requested Colima startup${NC}"
    fi
  fi

  while [[ "$elapsed" -lt "$wait_seconds" ]]; do
    if is_docker_ready; then
      echo -e "  ${GREEN}✓${NC} Docker daemon is ready"
      return 0
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done

  echo -e "  ${RED}✗ Docker daemon did not become ready within ${wait_seconds}s${NC}"
  echo -e "  ${YELLOW}Start Docker Desktop/OrbStack/Colima, then retry.${NC}"
  return 1
}

prompt_target() {
  {
    echo ""
    echo -e "${BOLD}Target:${NC}"
    echo -e "  ${GREEN}1)${NC} Local"
    echo -e "  ${GREEN}2)${NC} Staging"
    echo -e "  ${GREEN}3)${NC} All"
    echo -e "  ${YELLOW}0)${NC} Back"
    echo ""
    echo -n -e "${BOLD}Enter target: ${NC}"
  } >&2
  read -r target
  case "$target" in
    1|local) echo "local" ;;
    2|staging) echo "staging" ;;
    3|all) echo "all" ;;
    0|back|q|quit|exit) echo "back" ;;
    *) echo "invalid" ;;
  esac
}

prompt_service_group() {
  {
    echo ""
    echo -e "${BOLD}Service group:${NC}"
    echo -e "  ${GREEN}1)${NC} Local development (UI + API)"
    echo -e "  ${GREEN}2)${NC} External gateway (ngrok)"
    echo -e "  ${GREEN}3)${NC} Staging services (Docker + ngrok)"
    echo -e "  ${GREEN}4)${NC} All"
    echo -e "  ${YELLOW}0)${NC} Back"
    echo ""
    echo -n -e "${BOLD}Enter group: ${NC}"
  } >&2
  read -r group
  case "$group" in
    1|local) echo "local" ;;
    2|external) echo "external" ;;
    3|staging) echo "staging" ;;
    4|all) echo "all" ;;
    0|back|q|quit|exit) echo "back" ;;
    *) echo "invalid" ;;
  esac
}

check_local_services() {
  local local_ui_health_url="${LOCAL_UI_URL%/}/"
  local local_graphql_health_url="${LOCAL_GRAPHQL_URL%/}"
  local local_ui_graphql_url="${LOCAL_UI_URL%/}/api/graphql"
  echo -e "${BOLD}Local Services:${NC}"
  echo -n "  Docker daemon: "
  if ! command -v docker >/dev/null 2>&1; then
    echo -e "${YELLOW}MISSING${NC} (docker CLI not found)"
  elif docker info >/dev/null 2>&1; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC} (daemon unreachable)"
  fi

  echo -n "  UI (localhost:5173): "
  local ui
  ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_ui_health_url" 2>/dev/null || echo "000")
  [[ "$ui" == "200" ]] && echo -e "${GREEN}UP${NC}" || echo -e "${YELLOW}DOWN${NC} (HTTP $ui)"

  echo -n "  GraphQL (localhost:4000): "
  local gql
  gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_graphql_health_url" 2>/dev/null || echo "000")
  [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}UP${NC} (HTTP $gql)" || echo -e "${YELLOW}DOWN${NC} (HTTP $gql)"

  echo -n "  UI->GraphQL dataflow (master_sail): "
  local master_payload master_ok
  master_payload=$(curl -sS --max-time 10 -X POST "$local_ui_graphql_url" \
    -H 'Content-Type: application/json' \
    -d '{"query":"query V($tableName:String!,$limit:Int,$filters:TableDataFilters){ tableData(tableName:$tableName, limit:$limit, filters:$filters) }","variables":{"tableName":"master_sail","limit":5,"filters":{"include_non_real_sailings":false}}}' 2>/dev/null || true)
  master_ok=0
  if [[ -n "$master_payload" && "$master_payload" == *'"tableData"'* && "$master_payload" != *'"errors"'* ]]; then
    master_ok=1
  fi
  [[ "$master_ok" -eq 1 ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}FAIL${NC} (UI data query failed)"

  echo -n "  UI->GraphQL dataflow (competitorPricing): "
  local comp_payload comp_ok
  comp_payload=$(curl -sS --max-time 15 -X POST "$local_ui_graphql_url" \
    -H 'Content-Type: application/json' \
    -d '{"query":"query C($filters: CompetitorPricingFilters){ competitorPricing(filters:$filters){ id shipCode departureDate } }","variables":{"filters":{"currency":"EUR","isLatest":true}}}' 2>/dev/null || true)
  comp_ok=0
  if [[ -n "$comp_payload" && "$comp_payload" == *'"competitorPricing"'* && "$comp_payload" != *'"errors"'* ]]; then
    comp_ok=1
  fi
  [[ "$comp_ok" -eq 1 ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}FAIL${NC} (competitor query failed)"

  echo -n "  ngrok (local): "
  if [[ "$(get_target_external_state local)" == "active" ]]; then
    echo -e "${GREEN}UP${NC}"
  else
    echo -e "${YELLOW}DOWN${NC}"
  fi

  check_local_code_origin false
}

check_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_script "validate-staging-local.sh"
  else
    run_script "validate-staging-connectivity.sh"
  fi
}

print_front_screen_status() {
  print_front_page_status
}

start_local_services() {
  local local_ui_health_url="${LOCAL_UI_URL%/}/"
  local local_graphql_health_url="${LOCAL_GRAPHQL_URL%/}"
  echo -e "${BOLD}Starting local services:${NC}"

  if [[ ! -d "${ROOT_DIR}/talia-ui" ]] || [[ ! -d "${ROOT_DIR}/talia-server" ]]; then
    echo -e "  ${RED}Local project directories not found under ${ROOT_DIR}${NC}"
    return 1
  fi

  if ! verify_ui_port_owner; then
    return 1
  fi

  check_duplicate_dev_servers true
  check_local_code_origin true

  local ui_code
  ui_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_ui_health_url" 2>/dev/null || echo "000")
  if [[ "$ui_code" == "200" ]]; then
    echo -e "  ${GREEN}✓${NC} UI already running (port 5173)"
  else
    echo -e "  Starting UI (talia-ui)..."
    (cd "${ROOT_DIR}/talia-ui" && nohup npm run dev >/tmp/talia-ui.log 2>&1 & echo $! > .dev-server.pid)
  fi

  local gql_code
  gql_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_graphql_health_url" 2>/dev/null || echo "000")
  if [[ "$gql_code" == "200" || "$gql_code" == "400" ]]; then
    echo -e "  ${GREEN}✓${NC} GraphQL already running (port 4000)"
  else
    echo -e "  Starting GraphQL (talia-server)..."
    (cd "${ROOT_DIR}/talia-server" && nohup npm run start >/tmp/talia-server.log 2>&1 & echo $! > .dev-server.pid)
  fi

  sleep 2
  echo -e "  ${DIM}Logs:${NC} /tmp/talia-ui.log, /tmp/talia-server.log"
}

start_local_supabase_if_needed() {
  if ! ensure_docker_runtime_up 90; then
    return 1
  fi

  local code
  code=$(get_http_code_quick "${LOCAL_SUPABASE_URL}" 2)
  case "$code" in
    200|301|302|401|403|404)
      echo -e "  ${GREEN}✓${NC} Supabase Kong already up (${LOCAL_SUPABASE_URL})"
      return 0
      ;;
  esac
  if command -v supabase >/dev/null 2>&1 && [[ -f "${ROOT_DIR}/talia-server/supabase/config.toml" ]]; then
    echo -e "  Starting Supabase (CLI, background → /tmp/talia-supabase.log)..."
    (cd "${ROOT_DIR}/talia-server" && nohup supabase start >>/tmp/talia-supabase.log 2>&1 &)
  else
    echo -e "  ${YELLOW}Supabase not reachable on ${LOCAL_SUPABASE_URL}; install Supabase CLI or run: cd talia-server && supabase start${NC}"
  fi
}

stop_local_supabase_if_available() {
  if command -v supabase >/dev/null 2>&1 && [[ -f "${ROOT_DIR}/talia-server/supabase/config.toml" ]]; then
    echo -e "${BOLD}Stopping local Supabase (CLI):${NC}"
    (cd "${ROOT_DIR}/talia-server" && supabase stop) || true
  else
    echo -e "  ${DIM}Supabase CLI not configured here; skipped${NC}"
  fi
}

start_local_core() {
  echo -e "${BOLD}Start core (local):${NC}"
  start_local_services
  if ! start_local_supabase_if_needed; then
    return 1
  fi
}

stop_local_core() {
  echo -e "${BOLD}Stop core (local):${NC}"
  stop_local_dev_services
  stop_local_supabase_if_available
}

start_core_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${CYAN}Starting core services for target: ${BOLD}${t}${NC}"
  case "$t" in
    local) start_local_core ;;
    staging) start_staging_core_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
}

stop_core_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${CYAN}Stopping core services for target: ${BOLD}${t}${NC}"
  case "$t" in
    local) stop_local_core ;;
    staging) stop_staging_core_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
}

deploy_to_staging_from_local() {
  if $IS_ON_STAGING; then
    echo -e "${YELLOW}Run this deploy action from your local dev machine, not on staging.${NC}"
    return 1
  fi

  if [[ ! -x "${SCRIPT_DIR}/deploy-to-staging.sh" ]]; then
    echo -e "${RED}Missing deploy script: ${SCRIPT_DIR}/deploy-to-staging.sh${NC}"
    return 1
  fi

  echo ""
  echo -e "${BOLD}Deploy to staging (local sync):${NC}"
  echo -e "  ${GREEN}1)${NC} UI-only (recommended)"
  echo -e "  ${GREEN}2)${NC} Full stack"
  echo -e "  ${GREEN}3)${NC} Scripts + config only"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r choice

  local mode token timeout_sec label
  case "$choice" in
    1|ui|ui-only)
      mode="--ui-only"
      token="DEPLOY_UI_ONLY"
      timeout_sec="900"
      label="ui-only"
      ;;
    2|full)
      mode="--full"
      token="DEPLOY_FULL_STACK"
      timeout_sec="1800"
      label="full"
      ;;
    3|scripts|scripts-only|config)
      mode="--scripts-only"
      token="DEPLOY_SCRIPTS_ONLY"
      timeout_sec="300"
      label="scripts+config"
      ;;
    0|back|q|quit|exit)
      return 0
      ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac

  run_command "cd \"${ROOT_DIR}\" && STAGING_DEPLOY_CONFIRM_TOKEN=${token} ./scripts/deploy-to-staging.sh ${mode}" "Deploy to staging via local sync (${label})" "$timeout_sec"
}

check_services_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${BOLD}Service check (current target: ${t})${NC}"
  echo ""
  case "$t" in
    local) check_local_services ;;
    staging) check_staging_services_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
  echo ""
  check_external_gateway_quick
}

set_working_target_interactive() {
  echo ""
  echo -e "${BOLD}Set working target:${NC}"
  echo -e "  ${GREEN}1)${NC} Local (this machine’s dev stack)"
  echo -e "  ${GREEN}2)${NC} Staging (${STAGING_HOST})"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r t
  case "$t" in
    1|local)
      remember_target "local" || true
      echo -e "${GREEN}Working target saved: LOCAL${NC}"
      ;;
    2|staging)
      remember_target "staging" || true
      echo -e "${GREEN}Working target saved: STAGING${NC}"
      ;;
    0|back|q|quit) return 0 ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac
}

start_external_for_working_target() {
  local t
  t=$(get_effective_working_target)
  remember_target "$t" || true
  echo -e "${CYAN}Starting external access for ${BOLD}${t}${NC}${CYAN} → ${PUBLIC_MAIN_URL}${NC}"
  apply_target_external "$t"
  local new_target new_u
  new_target=$(get_current_target)
  new_u=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}External presenter (ngrok):${NC} ${GREEN}${new_u}${NC}"
}

advanced_validate_interactive() {
  echo ""
  echo -e "${BOLD}Advanced (slower):${NC}"
  echo -e "  ${GREEN}1)${NC} validate-staging.sh local"
  echo -e "  ${GREEN}2)${NC} validate-staging.sh staging"
  echo -e "  ${GREEN}3)${NC} validate-staging.sh (default)"
  echo -e "  ${GREEN}4)${NC} External gateway detail"
  echo -e "  ${GREEN}5)${NC} Comprehensive (git + standards + connectivity)"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r a
  case "$a" in
    1) run_script "validate-staging.sh" "local" ;;
    2) run_script "validate-staging.sh" "staging" ;;
    3) run_script "validate-staging.sh" ;;
    4) check_external_gateway ;;
    5) run_comprehensive_check ;;
    0|back|q|quit) return 0 ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac
}

start_services() {
  local target="$1"
  case "$target" in
    local)
      start_local_services
      ;;
    external)
      local ext_target
      ext_target=$(prompt_target)
      [[ "$ext_target" == "back" || "$ext_target" == "invalid" ]] && return 1
      start_external_services "$ext_target"
      ;;
    staging)
      start_staging_services_remote
      ;;
    all)
      start_local_services
      start_external_services "all"
      start_staging_services_remote
      ;;
  esac
}

stop_services() {
  local target="$1"
  case "$target" in
    local)
      stop_local_dev_services
      ;;
    external)
      local ext_target
      ext_target=$(prompt_target)
      [[ "$ext_target" == "back" || "$ext_target" == "invalid" ]] && return 1
      stop_external_services "$ext_target"
      ;;
    staging)
      stop_staging_services_remote
      ;;
    all)
      stop_local_dev_services
      stop_external_services "all"
      stop_staging_services_remote
      ;;
  esac
}

complete_check() {
  local target="$1"
  case "$target" in
    local)
      if [[ -f "${SCRIPT_DIR}/validate-staging.sh" ]]; then
        run_script "validate-staging.sh" "local"
      else
        check_duplicate_dev_servers true
        check_local_services
      fi
      check_external_gateway
      ;;
    staging)
      check_staging_services_remote
      check_external_gateway
      ;;
    all)
      run_comprehensive_check
      check_external_gateway
      ;;
  esac
}

total_status() {
  echo -e "${BOLD}Total Status:${NC}"
  echo ""
  print_front_screen_status
  check_local_services
  echo ""
  check_staging_services_remote
  echo ""
  check_external_gateway
}

check_external_gateway() {
  echo -e "${BOLD}External Gateway (${PUBLIC_MAIN_URL}):${NC}"
  local urls=("${PUBLIC_MAIN_URL%/}/" "${PUBLIC_SECONDARY_URL%/}/")
  echo -e ""
  printf "  %-34s  %-10s  %-8s  %s\n" "URL" "STATUS" "HTTP" "DETAILS"
  printf "  %-34s  %-10s  %-8s  %s\n" "----------------------------------" "----------" "--------" "----------------------------"
  for url in "${urls[@]}"; do
    local headers
    headers=$(curl -sI --max-time 8 "$url" 2>/dev/null || true)
    local code
    code=$(echo "$headers" | awk 'NR==1{print $2}')
    local gateway
    gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{print $2}')
    local ngrok
    ngrok=$(echo "$headers" | awk -F': ' 'tolower($1)=="ngrok-error-code"{print $2}')
    [[ -z "$code" ]] && code="000"
    local status="WARN"
    local detail="HTTP ${code}"
    if [[ "$code" == "000" ]]; then
      status="DOWN"
      detail="no response"
    elif [[ "$gateway" == "fallback" ]]; then
      status="DOWN"
      detail="holding page"
    elif [[ "$gateway" == "proxied" && ( "$code" == "200" || "$code" == "302" ) ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "200" || "$code" == "302" ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "503" ]]; then
      status="DOWN"
      detail="holding page"
    fi

    local status_color="$YELLOW"
    [[ "$status" == "UP" ]] && status_color="$GREEN"
    [[ "$status" == "DOWN" ]] && status_color="$RED"

    local details=""
    details="$detail"
    [[ -n "$gateway" ]] && details="${details}; gateway=${gateway}"
    [[ -n "$ngrok" ]] && details="${details}; ngrok=${ngrok}"

    printf "  %-34s  ${BOLD}%b%-10s${NC}  %-8s  %s\n" "$url" "$status_color" "$status" "$code" "$details"
  done
  echo ""
  echo -e "${DIM}Next steps:${NC}"
  echo -e "  ${DIM}- If DOWN but you expect UP: start services → External gateway.${NC}"
  echo -e "  ${DIM}- If still DOWN: check UI on localhost:5173 and ngrok status.${NC}"
}

check_external_gateway_quick() {
  echo -e "${BOLD}External gateway (quick):${NC}"
  local urls=("${PUBLIC_MAIN_URL%/}/" "${PUBLIC_SECONDARY_URL%/}/")
  for url in "${urls[@]}"; do
    local headers code gateway status detail
    headers=$(curl -sI --max-time 4 "$url" 2>/dev/null || true)
    code=$(echo "$headers" | awk 'NR==1{print $2}')
    gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
    [[ -z "$code" ]] && code="000"
    status="WARN"
    detail="HTTP ${code}"
    if [[ "$code" == "000" ]]; then
      status="DOWN"
      detail="no response"
    elif [[ "$gateway" == "fallback" ]]; then
      status="DOWN"
      detail="holding page"
    elif [[ "$gateway" == "proxied" && ( "$code" == "200" || "$code" == "302" ) ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "200" || "$code" == "302" ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "503" ]]; then
      status="DOWN"
      detail="holding page"
    fi
    local status_color="$YELLOW"
    [[ "$status" == "UP" ]] && status_color="$GREEN"
    [[ "$status" == "DOWN" ]] && status_color="$RED"
    printf "  %-36s  ${BOLD}%b%-6s${NC}  %s  gateway=%s\n" "$url" "$status_color" "$status" "$detail" "${gateway:-n/a}"
  done
  echo ""
}

start_ngrok_local() {
  local local_ui_health_url="${LOCAL_UI_URL%/}/"
  local local_ui_port="${LOCAL_UI_PORT:-5173}"
  if ! command -v ngrok >/dev/null 2>&1; then
    echo -e "${RED}ngrok not found on PATH. Install from https://ngrok.com/download${NC}"
    return 1
  fi
  echo -n "  UI (localhost:5173): "
  local ui
  ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$local_ui_health_url" 2>/dev/null || echo "000")
  [[ "$ui" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}Not running${NC} (start talia-ui first)"

  if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
    echo -e "  ${YELLOW}ngrok already running for ${LOCAL_NGROK_DOMAIN}${NC}"
  else
    echo -e "  Starting ngrok (${LOCAL_NGROK_DOMAIN} -> ${LOCAL_UI_URL})..."
    nohup ngrok "http" \
      "--url=${LOCAL_NGROK_DOMAIN}" \
      "--basic-auth=${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" \
      "${local_ui_port}" >/tmp/ngrok-taliahub.log 2>&1 &
    sleep 1
  fi

  echo -e "  Tunnel:"
  local tunnel_line=""
  local attempts=0
  while [[ "$attempts" -lt 6 ]]; do
    tunnel_line=$(curl -s http://localhost:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"[^"]*"' | head -1 || true)
    if [[ -n "$tunnel_line" ]]; then
      break
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  if [[ -n "$tunnel_line" ]]; then
    echo "  ${tunnel_line}"
  else
    echo "  Not active"
    if [[ -f /tmp/ngrok-taliahub.log ]]; then
      echo "  See /tmp/ngrok-taliahub.log for details"
    fi
  fi
}

start_ngrok_staging_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok on staging (systemd)"
  else
    run_staging_ssh_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok on staging (systemd)" "45"
  fi
}

stop_ngrok_staging_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}" "Stop ngrok on staging (systemd)"
  else
    run_staging_ssh_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}" "Stop ngrok on staging (systemd)" "45"
  fi
}

start_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl start ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d; docker compose -f docker-compose.staging.yml ps" "Start staging services (ngrok + docker)"
  else
    run_staging_ssh_command "sudo systemctl start ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d; docker compose -f docker-compose.staging.yml ps" "Start staging services (ngrok + docker)" "60"
  fi
}

stop_ngrok_local() {
  if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
    echo -e "  Stopping local ngrok..."
    pkill -f "ngrok .*${LOCAL_NGROK_DOMAIN}" 2>/dev/null || true
  else
    echo -e "  ${DIM}ngrok not running locally${NC}"
  fi
}

stop_local_dev_services() {
  echo -e "${BOLD}Stopping local dev services (UI/API):${NC}"
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids=$(lsof -ti:5173,4000 2>/dev/null | tr '\n' ' ' | xargs)
    stop_port_processes "$pids" "processes on ports 5173/4000"
  else
    echo -e "  ${YELLOW}lsof not available; skipping port-based stop${NC}"
  fi
}

stop_local_services() {
  echo -e "${BOLD}Stopping local services:${NC}"
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids=$(lsof -ti:5173,4000 2>/dev/null | tr '\n' ' ' | xargs)
    stop_port_processes "$pids" "processes on ports 5173/4000"
  else
    echo -e "  ${YELLOW}lsof not available; skipping port-based stop${NC}"
  fi
  stop_ngrok_local
}

stop_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging services (ngrok + docker)"
  else
    run_staging_ssh_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging services (ngrok + docker)" "60"
  fi
}

start_staging_core_remote() {
  if $IS_ON_STAGING; then
    run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d && docker compose -f docker-compose.staging.yml ps" "Start staging core (Docker only, ngrok unchanged)"
  else
    run_staging_ssh_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d && docker compose -f docker-compose.staging.yml ps" "Start staging core (Docker only, ngrok unchanged)" "60"
  fi
}

stop_staging_core_remote() {
  if $IS_ON_STAGING; then
    run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging core (Docker only, ngrok unchanged)"
  else
    run_staging_ssh_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging core (Docker only, ngrok unchanged)" "60"
  fi
}

start_external_services() {
  local target="$1"
  case "$target" in
    local)
      start_ngrok_local
      ;;
    staging)
      start_ngrok_staging_remote
      ;;
    all)
      start_ngrok_local
      start_ngrok_staging_remote
      ;;
  esac
}

stop_external_services() {
  local target="$1"
  case "$target" in
    local)
      stop_ngrok_local
      ;;
    staging)
      stop_ngrok_staging_remote
      ;;
    all)
      stop_ngrok_local
      stop_ngrok_staging_remote
      ;;
  esac
}

start_target_external() {
  local target="$1"
  case "$target" in
    local) start_ngrok_local ;;
    staging) start_ngrok_staging_remote ;;
    *) echo -e "${YELLOW}Unknown target: ${target}${NC}"; return 1 ;;
  esac
}

stop_target_external() {
  local target="$1"
  case "$target" in
    local) stop_ngrok_local ;;
    staging) stop_ngrok_staging_remote ;;
    *) echo -e "${YELLOW}Unknown target: ${target}${NC}"; return 1 ;;
  esac
}

apply_target_external() {
  local target="$1"
  local candidate

  if ! is_supported_target "$target"; then
    echo -e "${RED}Invalid target: ${target}${NC}"
    return 1
  fi

  # Stop all other targets first, then start selected target.
  for candidate in local staging; do
    if [[ "$candidate" != "$target" ]]; then
      stop_target_external "$candidate"
    fi
  done
  start_target_external "$target"
}

switch_target() {
  echo ""
  echo -e "${BOLD}Switch target:${NC}"
  echo -e "  ${GREEN}1)${NC} Local (${PUBLIC_MAIN_URL} -> local)"
  echo -e "  ${GREEN}2)${NC} Staging (${PUBLIC_MAIN_URL} -> staging)"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Enter target: ${NC}"
  read -r target

  case "$target" in
    1|local)
      echo -e "${CYAN}Switching target to LOCAL...${NC}"
      remember_target "local" || true
      apply_target_external "local"
      ;;
    2|staging)
      echo -e "${CYAN}Switching target to STAGING...${NC}"
      remember_target "staging" || true
      apply_target_external "staging"
      ;;
    0|back|q|quit|exit)
      return 0
      ;;
    *)
      echo -e "${RED}Invalid target option${NC}"
      return 1
      ;;
  esac

  local new_target
  local new_target_upper
  local checks=0
  while [[ "$checks" -lt 8 ]]; do
    new_target=$(get_current_target)
    if [[ "$new_target" != "none" && "$new_target" != "unknown" ]]; then
      break
    fi
    checks=$((checks + 1))
    sleep 1
  done
  new_target_upper=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}Current target is now:${NC} ${GREEN}${new_target_upper}${NC}"
}

stop_external_everywhere() {
  echo -e "${CYAN}Stopping external access everywhere (local + staging)...${NC}"
  stop_target_external "local"
  stop_target_external "staging"
  echo ""
  local remembered_target
  remembered_target=$(get_remembered_target)
  echo -e "${BOLD}External interface status:${NC} ${YELLOW}OFFLINE${NC} (no local/staging ngrok target)"
  echo -e "${DIM}Remembered target preserved: ${remembered_target:-none}${NC}"
}

enable_remembered_target_external() {
  local remembered_target
  local current_target
  remembered_target=$(get_remembered_target)
  current_target=$(get_current_target)

  if [[ -z "$remembered_target" ]]; then
    if is_supported_target "$current_target"; then
      remembered_target="$current_target"
      remember_target "$remembered_target" || true
    else
      echo -e "${YELLOW}No remembered target found.${NC}"
      echo -e "${YELLOW}Use option 6 to select local or staging first.${NC}"
      return 1
    fi
  fi

  echo -e "${CYAN}Enabling external access on remembered target: ${remembered_target}${NC}"
  apply_target_external "$remembered_target"

  local new_target
  local new_target_upper
  new_target=$(get_current_target)
  new_target_upper=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}Current target after enable:${NC} ${GREEN}${new_target_upper}${NC}"
}

check_duplicate_dev_servers() {
  local auto_fix="${1:-false}"
  echo -e "${BOLD}Dev Server Instances:${NC}"

  if ! command -v lsof >/dev/null 2>&1; then
    echo -e "  ${YELLOW}⚠️  lsof not available; skipping duplicate checks${NC}"
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"

  # Check for multiple Vite processes
  local vite_count
  vite_count=$(ps aux | grep -E "[v]ite" | grep -v grep | wc -l | tr -d ' ')
  local vite_pids
  vite_pids=$(ps aux | grep -E "[v]ite" | grep -v grep | awk '{print $2}' | tr '\n' ' ' | xargs)
  local vite_ui_pids=""
  local vite_other_pids=""
  local pid
  for pid in $vite_pids; do
    local cwd
    cwd=$(get_pid_cwd "$pid")
    if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
      vite_ui_pids="${vite_ui_pids} ${pid}"
    else
      vite_other_pids="${vite_other_pids} ${pid}"
    fi
  done

  # Check for processes on dev server ports
  local port_5173 port_5174 port_5175
  port_5173=$(lsof -nP -iTCP:5173 -sTCP:LISTEN -t 2>/dev/null | wc -l | tr -d ' ')
  port_5174=$(lsof -nP -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null | wc -l | tr -d ' ')
  port_5175=$(lsof -nP -iTCP:5175 -sTCP:LISTEN -t 2>/dev/null | wc -l | tr -d ' ')
  local fallback_ports=$((port_5174 + port_5175))

  local has_duplicates=false
  local vite_ui_count
  vite_ui_count=$(echo "$vite_ui_pids" | wc -w | tr -d ' ')
  [[ "$vite_ui_count" -gt 1 ]] && has_duplicates=true
  [[ "$port_5173" -gt 1 ]] && has_duplicates=true
  [[ "$fallback_ports" -gt 0 ]] && has_duplicates=true

  if $has_duplicates && [[ "$auto_fix" == "true" ]]; then
    echo -e "  ${YELLOW}⚠️  Duplicate/forbidden UI servers detected. Enforcing single-server rule on 5173...${NC}"
    local port_pids fallback_pids
    port_pids=$(collect_ui_port_pids)
    fallback_pids=$(collect_ui_fallback_port_pids)
    if [[ -n "$fallback_pids" ]]; then
      kill $fallback_pids 2>/dev/null || true
      sleep 1
      kill -9 $fallback_pids 2>/dev/null || true
    fi
    if [[ -n "$port_pids" ]]; then
      kill $port_pids 2>/dev/null || true
      sleep 1
      kill -9 $port_pids 2>/dev/null || true
    fi
    if [[ -n "$vite_ui_pids" ]]; then
      kill $vite_ui_pids 2>/dev/null || true
      sleep 1
      kill -9 $vite_ui_pids 2>/dev/null || true
    fi
    echo -e "  ${GREEN}✓${NC} Stopped all Vite/dev-port processes"
    return 0
  fi

  if [[ "$vite_ui_count" -gt 1 ]]; then
    echo -e "  ${RED}⚠️  Multiple Talia UI Vite processes detected: ${vite_ui_count}${NC}"
    echo -e "  ${YELLOW}   PIDs: ${vite_ui_pids}${NC}"
    echo -e "  ${DIM}   Run: pkill -f 'vite' && cd talia-ui && npm run dev${NC}"
    return 1
  elif [[ "$vite_ui_count" -eq 1 ]]; then
    echo -e "  ${GREEN}✓${NC} Vite processes: ${vite_ui_count} (OK)"
  else
    echo -e "  ${YELLOW}⚠️  No Vite processes found${NC}"
  fi

  if [[ "$port_5173" -gt 1 || "$fallback_ports" -gt 0 ]]; then
    echo -e "  ${RED}⚠️  UI port rule violation: only one server on 5173 is allowed${NC}"
    echo -e "  ${YELLOW}   Port 5173 listeners: ${port_5173}${NC}"
    if [[ "$port_5173" -gt 0 ]]; then
      local pids_5173
      pids_5173=$(lsof -ti:5173 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5173: ${port_5173} process(es) - PIDs: ${pids_5173}${NC}"
    fi
    if [[ "$port_5174" -gt 0 ]]; then
      local pids_5174
      pids_5174=$(lsof -ti:5174 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5174 (forbidden): ${port_5174} process(es) - PIDs: ${pids_5174}${NC}"
    fi
    if [[ "$port_5175" -gt 0 ]]; then
      local pids_5175
      pids_5175=$(lsof -ti:5175 2>/dev/null | tr '\n' ' ' | xargs)
      echo -e "  ${YELLOW}   Port 5175 (forbidden): ${port_5175} process(es) - PIDs: ${pids_5175}${NC}"
    fi
    echo -e "  ${DIM}   Run: lsof -ti:5174,5175 | xargs kill -9${NC}"
    return 1
  elif [[ "$port_5173" -eq 1 ]]; then
    echo -e "  ${GREEN}✓${NC} Dev server ports: single process on port 5173 (OK)"
  else
    echo -e "  ${YELLOW}⚠️  No process on UI port 5173${NC}"
  fi

  return 0
}

check_local_code_origin() {
  local auto_fix="${1:-false}"
  echo -e "${BOLD}Local Code Origin:${NC}"

  if ! command -v lsof >/dev/null 2>&1; then
    echo -e "  ${YELLOW}⚠️  lsof not available; skipping origin checks${NC}"
    return 0
  fi

  local ui_dir="${ROOT_DIR}/talia-ui"
  local api_dir="${ROOT_DIR}/talia-server"
  local issues=0

  local ui_pids
  ui_pids=$(collect_ui_port_pids)
  if [[ -z "$ui_pids" ]]; then
    echo -e "  ${YELLOW}⚠️  No UI process detected on port 5173${NC}"
  else
    local pid
    for pid in $ui_pids; do
      local cwd
      cwd=$(get_pid_cwd "$pid")
      if [[ -n "$cwd" && "$cwd" == "$ui_dir"* ]]; then
        echo -e "  ${GREEN}✓${NC} UI PID ${pid} running from ${cwd}"
      else
        echo -e "  ${RED}⚠️  UI PID ${pid} running from ${cwd:-unknown} (expected ${ui_dir})${NC}"
        ((issues++)) || true
        if [[ "$auto_fix" == "true" ]]; then
          kill "$pid" 2>/dev/null || true
          sleep 1
          kill -9 "$pid" 2>/dev/null || true
        fi
      fi
    done
  fi

  local fallback_pids
  fallback_pids=$(collect_ui_fallback_port_pids)
  if [[ -n "$fallback_pids" ]]; then
    echo -e "  ${RED}⚠️  Forbidden fallback UI port process detected (5174/5175): ${fallback_pids}${NC}"
    ((issues++)) || true
    if [[ "$auto_fix" == "true" ]]; then
      kill $fallback_pids 2>/dev/null || true
      sleep 1
      kill -9 $fallback_pids 2>/dev/null || true
      echo -e "  ${GREEN}✓${NC} Stopped fallback-port UI process(es)"
    fi
  fi

  local api_pids
  api_pids=$(lsof -nP -iTCP:4000 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ' | xargs || true)
  if [[ -z "$api_pids" ]]; then
    echo -e "  ${YELLOW}⚠️  No API process detected on port 4000${NC}"
  else
    local pid
    for pid in $api_pids; do
      local cwd
      cwd=$(get_pid_cwd "$pid")
      if [[ -n "$cwd" && "$cwd" == "$api_dir"* ]]; then
        echo -e "  ${GREEN}✓${NC} API PID ${pid} running from ${cwd}"
      else
        echo -e "  ${RED}⚠️  API PID ${pid} running from ${cwd:-unknown} (expected ${api_dir})${NC}"
        ((issues++)) || true
        if [[ "$auto_fix" == "true" ]]; then
          kill "$pid" 2>/dev/null || true
          sleep 1
          kill -9 "$pid" 2>/dev/null || true
        fi
      fi
    done
  fi

  if [[ "$auto_fix" == "true" ]] && [[ "$issues" -gt 0 ]]; then
    echo -e "  ${GREEN}✓${NC} Stopped mismatched local processes"
  fi

  return $issues
}

run_comprehensive_check() {
  echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║${NC}${BOLD}                 COMPREHENSIVE VALIDATION                    ${NC}${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""

  echo -e "${BOLD}=== VERSIONS / COMMITS ===${NC}"
  if git -C "$ROOT_DIR" rev-parse HEAD >/dev/null 2>&1; then
    git -C "$ROOT_DIR" fetch origin >/dev/null 2>&1 || true
    local head
    local origin
    head=$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    origin=$(git -C "$ROOT_DIR" rev-parse --short origin/main 2>/dev/null || echo "unknown")
    local status
    status=$(git -C "$ROOT_DIR" status --porcelain | wc -l | tr -d ' ')
    if [[ "$head" == "$origin" ]]; then
      echo -e "  ${GREEN}✓${NC} Local HEAD ${head} matches origin/main"
    else
      echo -e "  ${YELLOW}⚠️${NC} Local HEAD ${head}, origin/main ${origin}"
    fi
    if [[ "$status" -eq 0 ]]; then
      echo -e "  ${GREEN}✓${NC} Working tree clean"
    else
      echo -e "  ${YELLOW}⚠️${NC} Working tree has ${status} change(s)"
    fi
  else
    echo -e "  ${YELLOW}⚠️${NC} Not a git repository: ${ROOT_DIR}"
  fi

  echo ""
  echo -e "${BOLD}=== STANDARDS CHECKS ===${NC}"
  if [[ -d "${ROOT_DIR}/talia-ui" ]] && command -v npm >/dev/null 2>&1; then
    if (cd "${ROOT_DIR}/talia-ui" && npm run check:standards >/dev/null 2>&1); then
      echo -e "  ${GREEN}✓${NC} UI component standards check passed"
    else
      echo -e "  ${YELLOW}⚠️${NC} UI component standards check reported violations"
      echo -e "  ${DIM}   Run: cd talia-ui && npm run check:standards${NC}"
    fi
  else
    echo -e "  ${YELLOW}⚠️${NC} Skipping standards checks (npm or talia-ui missing)"
  fi

  echo ""
  echo -e "${BOLD}=== CONNECTIVITY / STATUS ===${NC}"
  run_script "validate-staging.sh"
}

restart_all_staging() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ngrok.service >/dev/null 2>&1 || true; sudo systemctl disable ngrok.service >/dev/null 2>&1 || true; sudo systemctl restart protonvpn-openvpn; sleep 5; sudo systemctl restart ${STAGING_NGROK_SERVICE}; sleep 5; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml restart supabase-db supabase-rest supabase-kong; sleep 5; docker compose -f docker-compose.staging.yml restart graphql-server; sleep 5; docker compose -f docker-compose.staging.yml restart ui; docker compose -f docker-compose.staging.yml up -d; sleep 10; docker compose -f docker-compose.staging.yml ps" "Restart ALL staging services"
  else
    run_script "restart-and-check.sh" "staging --restart"
  fi
}

handle_staging_menu_legacy() {
  local choice="$1"
  
  case "$choice" in
    1|local)
      run_script "validate-staging-local.sh"
      ;;
    2|staging)
      run_script "validate-staging-local.sh"
      ;;
    3|all)
      run_script "validate-staging-local.sh"
      ;;
    4|gateway)
      check_external_gateway
      ;;
    5|start-ngrok)
      run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok tunnel"
      ;;
    6|start-ngrok-staging)
      run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok tunnel"
      ;;
    7|stop-local)
      echo -e "${BOLD}Stopping local staging services:${NC}"
      run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE} || true" "Stop ngrok"
      run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging Docker"
      ;;
    8|stop-staging)
      echo -e "${BOLD}Stopping staging services:${NC}"
      run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE} || true" "Stop ngrok"
      run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging Docker"
      ;;
    9|quick|test)
      echo -e "${BOLD}Quick Connectivity Test${NC}"
      echo ""
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" || "$talia" == "302" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${RED}HTTP $talia${NC}"
      ;;
    10|restart)
      run_command "sudo systemctl restart protonvpn-openvpn && sleep 10 && sudo systemctl restart ${STAGING_NGROK_SERVICE} && sleep 5 && echo 'Services restarted' && curl -s http://localhost:4040/api/tunnels | grep -o '${LOCAL_NGROK_DOMAIN}' && echo ' tunnel active'" "Restart VPN + ngrok"
      ;;
    11|fix)
      run_command "sudo systemctl restart protonvpn-openvpn && sleep 10 && sudo systemctl restart ${STAGING_NGROK_SERVICE} && sleep 5" "Fix staging connectivity (VPN + ngrok)"
      ;;
    12|full)
      echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
      echo -e "${CYAN}║${NC}${BOLD}                    FULL SYSTEM CHECK                        ${NC}${CYAN}║${NC}"
      echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
      echo ""
      
      # Services
      echo -e "${BOLD}=== SERVICES ===${NC}"
      run_script "validate-staging-local.sh"
      
      # Docker detailed
      echo ""
      echo -e "${BOLD}=== DOCKER CONTAINERS (detailed) ===${NC}"
      docker compose -f ${STAGING_DIR}/docker-compose.staging.yml ps
      echo ""
      docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}" 2>/dev/null | head -15 || true
      
      # Network
      echo ""
      echo -e "${BOLD}=== NETWORK ===${NC}"
      echo -n "  VPN IP: "
      curl -s --max-time 5 https://api.ipify.org && echo "" || echo "timeout"
      echo -n "  VPN Interface: "
      ip addr show tun0 2>/dev/null | grep "inet " | awk '{print $2}' || echo "not found"
      echo -n "  ngrok tunnel: "
      curl -s http://localhost:4040/api/tunnels | grep -o '"public_url":"[^"]*"' | head -1 || echo "not active"
      
      # Disk
      echo ""
      echo -e "${BOLD}=== DISK USAGE ===${NC}"
      df -h / /home 2>/dev/null | grep -v "^Filesystem" | awk '{print "  " $6 ": " $3 " used / " $2 " total (" $5 " full)"}'
      
      # Memory
      echo ""
      echo -e "${BOLD}=== MEMORY ===${NC}"
      free -h | grep -E "^(Mem|Swap)" | awk '{print "  " $1 " " $3 " used / " $2 " total"}'
      
      echo ""
      echo -e "${GREEN}✅ Full check complete${NC}"
      ;;
    14|restart-all)
      restart_all_staging
      ;;
    13|comprehensive)
      run_script "validate-staging-local.sh"
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

handle_remote_menu_legacy() {
  local choice="$1"
  
  case "$choice" in
    1|local)
      # Always run local checks when on a local dev machine
      if [[ -f "${SCRIPT_DIR}/validate-staging.sh" ]]; then
        run_script "validate-staging.sh" "local"
      else
        # Fallback to inline local check
        echo -e "${BOLD}Local Environment Check${NC}"
        echo ""
        
        # Check for duplicate dev servers first
        check_duplicate_dev_servers true
        echo ""
        
        echo -n "  GraphQL (localhost:4000): "
        local gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_GRAPHQL_URL%/}" 2>/dev/null || echo "000")
        [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}OK${NC} (HTTP $gql)" || echo -e "${RED}FAIL${NC} (HTTP $gql)"
        
        echo -n "  UI (localhost:5173): "
        local ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_UI_URL%/}/" 2>/dev/null || echo "000")
        [[ "$ui" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}Not running${NC}"
        
        echo -n "  Supabase (localhost:54321): "
        local sb=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:54321/ 2>/dev/null || echo "000")
        [[ "$sb" != "000" ]] && echo -e "${GREEN}OK${NC} (HTTP $sb)" || echo -e "${RED}FAIL${NC}"
        
        echo ""
        echo -e "${BOLD}Docker Containers:${NC}"
        docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | grep -E "(NAMES|supabase_)" || echo "  No Supabase containers"
      fi
      ;;
    2|staging)
      run_script "validate-staging-connectivity.sh"
      ;;
    3|all)
      echo -e "${BOLD}=== LOCAL ===${NC}"
      handle_remote_menu "1"
      echo ""
      echo -e "${BOLD}=== STAGING ===${NC}"
      run_script "validate-staging-connectivity.sh"
      ;;
    4|gateway)
      check_external_gateway
      ;;
    5|start-ngrok)
      start_ngrok_local
      ;;
    6|start-ngrok-staging)
      start_ngrok_staging_remote
      ;;
    7|stop-local)
      stop_local_services
      ;;
    8|stop-staging)
      stop_staging_services_remote
      ;;
    9|quick|test)
      echo -e "${BOLD}Quick Connectivity Test${NC}"
      echo ""
      echo -n "  Ping staging (${STAGING_HOST}): "
      ping -c 1 -t 3 ${STAGING_HOST} >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  SSH to staging: "
      ssh -o ConnectTimeout=5 -o BatchMode=yes ${STAGING_SSH_TARGET} "echo ok" >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${RED}HTTP $talia${NC}"
      ;;
    10|restart)
      run_script "restart-staging-tunnel.sh"
      ;;
    11|fix)
      run_script "fix-staging-connectivity.sh"
      ;;
    12|full)
      echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
      echo -e "${CYAN}║${NC}${BOLD}                    FULL SYSTEM CHECK                        ${NC}${CYAN}║${NC}"
      echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
      echo ""
      
      # Local environment
      echo -e "${BOLD}━━━ LOCAL ENVIRONMENT (Mac) ━━━${NC}"
      echo ""
      
      # Check for duplicate dev servers first
      check_duplicate_dev_servers true
      echo ""
      
      echo -e "  ${BOLD}Services:${NC}"
      echo -n "    GraphQL (localhost:4000): "
      local gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_GRAPHQL_URL%/}" 2>/dev/null || echo "000")
      [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}OK${NC} (HTTP $gql)" || echo -e "${RED}FAIL${NC} (HTTP $gql)"
      
      echo -n "    UI (localhost:5173): "
      local ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "${LOCAL_UI_URL%/}/" 2>/dev/null || echo "000")
      [[ "$ui" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}Not running${NC}"
      
      echo -n "    Supabase Kong (localhost:54321): "
      local sb=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:54321/ 2>/dev/null || echo "000")
      [[ "$sb" != "000" ]] && echo -e "${GREEN}OK${NC} (HTTP $sb)" || echo -e "${RED}FAIL${NC}"
      
      echo ""
      echo -e "  ${BOLD}Docker Containers:${NC}"
      docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | grep -E "(NAMES|supabase_)" | sed 's/^/    /' || echo "    No Supabase containers"
      
      # Network to staging
      echo ""
      echo -e "${BOLD}━━━ NETWORK TO STAGING ━━━${NC}"
      echo ""
      echo -n "  Ping (${STAGING_HOST}): "
      local ping_result=$(ping -c 3 -q ${STAGING_HOST} 2>/dev/null)
      if [[ $? -eq 0 ]]; then
        local ping_avg=$(echo "$ping_result" | grep "round-trip" | cut -d'/' -f5)
        local ping_loss=$(echo "$ping_result" | grep "packet loss" | grep -oE '[0-9.]+%' | head -1)
        echo -e "${GREEN}OK${NC} (avg ${ping_avg}ms, ${ping_loss} loss)"
      else
        echo -e "${RED}FAIL${NC}"
      fi
      
      echo -n "  SSH connection: "
      ssh -o ConnectTimeout=5 -o BatchMode=yes ${STAGING_SSH_TARGET} "echo ok" >/dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${RED}FAIL${NC}"
      
      echo -n "  ${PUBLIC_MAIN_URL} (public): "
      local talia=$(curl -sS --basic -u "${NGROK_BASIC_USER}:${NGROK_BASIC_PASS}" -o /dev/null -w '%{http_code}' --max-time 10 "${PUBLIC_MAIN_URL}" 2>/dev/null || echo "000")
      [[ "$talia" == "200" ]] && echo -e "${GREEN}OK${NC} (HTTP 200)" || echo -e "${RED}FAIL${NC} (HTTP $talia)"
      
      # Staging environment
      echo ""
      echo -e "${BOLD}━━━ STAGING ENVIRONMENT (MiniPC) ━━━${NC}"
      echo ""
      run_script "validate-staging-connectivity.sh"
      
      # Staging Docker
      echo ""
      echo -e "  ${BOLD}Docker Containers (staging):${NC}"
      ssh ${STAGING_SSH_TARGET} "docker compose -f ${STAGING_DIR}/docker-compose.staging.yml ps --format 'table {{.Name}}\t{{.Status}}'" 2>/dev/null | sed 's/^/    /' || true
      
      # Staging resources
      echo ""
      echo -e "  ${BOLD}Staging Resources:${NC}"
      ssh ${STAGING_SSH_TARGET} "echo -n '    Disk: '; df -h / | tail -1 | awk '{print \$3 \" used / \" \$2 \" (\" \$5 \" full)\"}'; echo -n '    Memory: '; free -h | grep Mem | awk '{print \$3 \" used / \" \$2}'" 2>/dev/null || true
      
      echo ""
      echo -e "${GREEN}✅ Full check complete${NC}"
      ;;
    13|comprehensive)
      run_comprehensive_check
      ;;
    14|restart-all)
      restart_all_staging
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

handle_remote_menu() {
  local choice="$1"

  case "$choice" in
    1|set-target|target|switch-target|switch)
      set_working_target_interactive
      ;;
    2|check)
      check_services_for_working_target
      ;;
    3|start|start-core)
      start_core_for_working_target
      ;;
    4|stop|stop-core)
      stop_core_for_working_target
      ;;
    5|enable-external|external-on|restart-external|external-restart|bounce-external)
      start_external_for_working_target
      ;;
    6|stop-external|external-off|offline)
      stop_external_everywhere
      ;;
    7|advanced|complete|full)
      advanced_validate_interactive
      ;;
    8|deploy|deploy-staging)
      deploy_to_staging_from_local
      ;;
    # Legacy numeric / names (older validate menu)
    9)
      enable_remembered_target_external
      ;;
    status|summary|total)
      print_quick_targets_summary
      ;;
    0|q|quit|exit)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option: ${choice}${NC}"
      return 1
      ;;
  esac
}

handle_cli() {
  case "${1:-}" in
    set-target)
      if ! is_supported_target "${2:-}"; then
        echo "Usage: $0 set-target local|staging"
        return 1
      fi
      remember_target "$2"
      echo "Working target saved: $2"
      ;;
    check) check_services_for_working_target ;;
    start-core|start) start_core_for_working_target ;;
    stop-core|stop-core) stop_core_for_working_target ;;
    external-on|enable-external) start_external_for_working_target ;;
    external-off|stop-external) stop_external_everywhere ;;
    deploy|deploy-staging) deploy_to_staging_from_local ;;
    comprehensive) run_comprehensive_check ;;
    status|summary) print_quick_targets_summary ;;
    help|-h|--help)
      cat <<EOF
Talia validate — quick overview by default; heavy checks only from the menu or explicit commands.

  $0                              interactive menu
  $0 set-target local|staging     persist working target (~/.talia-validate-last-target)
  $0 check                        deep service check for current target only
  $0 start-core                   UI + GraphQL + Supabase (local) or Docker stack (staging)
  $0 stop-core                    stop core (ngrok unchanged)
  $0 external-on                  ngrok $PUBLIC_MAIN_URL → current target
  $0 external-off                 stop all ngrok (Cloudflare unavailable page)
  $0 deploy-staging               local-sync deploy to staging (ui/full/scripts prompt)
  $0 comprehensive                full repo validation (slow)
  $0 status                       quick summary lines (no menu)
EOF
      ;;
    *)
      echo "Unknown command: ${1:-}. Try: $0 help"
      return 1
      ;;
  esac
}

# Main
main() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
      handle_remote_menu "$1"
    else
      handle_cli "$@"
    fi
    exit $?
  fi

  while true; do
    print_header
    print_menu

    echo -n -e "${BOLD}Enter choice: ${NC}"
    read -r choice

    handle_remote_menu "$choice" || true

    wait_for_key
  done
}

main "$@"
