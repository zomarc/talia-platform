    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac

  run_command "cd \"${ROOT_DIR}\" && ${deploy_xtra}STAGING_DEPLOY_CONFIRM_TOKEN=${token} ./scripts/deploy-to-mvp.sh ${mode}" "Deploy to MVP via ${SCRIPT_DIR}/deploy-to-mvp.sh (${label})" "$timeout_sec"
}

check_mvp_services_remote() {
  echo -e "${BOLD}MVP (${MVP_UI_HOST:-?}) — quick probes${NC}"
  local ui gql
  ui=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 "${MVP_UI_URL%/}/" 2>/dev/null || echo "000")
  gql=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 "${MVP_GRAPHQL_URL%/}" 2>/dev/null || echo "000")
  echo -n "  UI (${MVP_UI_URL}): "
  [[ "$ui" == "200" || "$ui" == "302" ]] && echo -e "${GREEN}UP${NC} ($ui)" || echo -e "${YELLOW}DOWN${NC} ($ui)"
  echo -n "  GraphQL (${MVP_GRAPHQL_URL}): "
  [[ "$gql" == "200" || "$gql" == "400" ]] && echo -e "${GREEN}UP${NC} ($gql)" || echo -e "${YELLOW}DOWN${NC} ($gql)"
  if check_mvp_ssh_ready 2>/dev/null; then
    echo -e "  SSH ${MVP_SSH_USER}@${MVP_SSH_HOST}: ${GREEN}OK${NC}"
  else
    echo -e "  SSH ${MVP_SSH_USER}@${MVP_SSH_HOST}: ${YELLOW}unreachable${NC}"
  fi
}

check_services_for_working_target() {
  local t
  t=$(get_effective_working_target)
  echo -e "${BOLD}Service check (current target: ${t})${NC}"
  echo ""
  case "$t" in
    local) check_local_services ;;
    staging) check_staging_services_remote ;;
    mvp) check_mvp_services_remote ;;
    *)
      echo -e "${RED}Unknown working target: ${t}${NC}"
      return 1
      ;;
  esac
  echo ""
  check_external_gateway_quick
}

set_working_target_interactive() {
  echo ""
  echo -e "${BOLD}Set working target:${NC}"
  echo -e "  ${DIM}Controls check/start/stop/deploy scope only — not who serves ${PUBLIC_DEV_URL}.${NC}"
  echo -e "  ${DIM}To present: menu D (Start Demo). Menu 5 switches tunnel local ↔ MiniPC.${NC}"
  echo -e "  ${GREEN}1)${NC} Local (this machine’s dev stack)"
  echo -e "  ${GREEN}2)${NC} MiniPC / staging (${STAGING_HOST} — Docker prove)"
  if [[ "$MVP_VALIDATE" == "1" && -n "${MVP_SSH_HOST:-}" ]]; then
    echo -e "  ${GREEN}3)${NC} Azure UAT / MVP prove (${MVP_SSH_HOST} → ${MVP_UI_URL})"
  else
    echo -e "  ${DIM}3)${NC} ${DIM}Azure UAT (set MVP_VALIDATE=1 and MVP_SSH_HOST in targets.env)${NC}"
  fi
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r t
  case "$t" in
    1|local)
      remember_target "local" || true
      echo -e "${GREEN}Working target saved: LOCAL${NC}"
      echo -e "${DIM}Present with menu D (Start Demo) → ${PUBLIC_DEV_URL} (edit stays on :${LOCAL_UI_PORT:-5173}).${NC}"
      ;;
    2|staging)
      remember_target "staging" || true
      echo -e "${GREEN}Working target saved: STAGING (MiniPC)${NC}"
      echo -e "${DIM}Tunnel switch: menu 5 → MiniPC. Discuss URL stays ${PUBLIC_DEV_URL} when laptop owns the tunnel.${NC}"
      ;;
    3|mvp)
      if ! is_supported_target "mvp"; then
        echo -e "${RED}MVP is not configured (MVP_VALIDATE=1 and MVP_SSH_HOST required).${NC}"
        return 1
      fi
      remember_target "mvp" || true
      echo -e "${GREEN}Working target saved: MVP (Azure UAT prove)${NC}"
      echo -e "${YELLOW}Azure is not exposed via ${PUBLIC_DEV_URL}.${NC} Open ${BOLD}${MVP_UI_URL}${NC} directly."
      ;;
    0|back|q|quit) return 0 ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac
}

start_external_for_working_target() {
  local t
  t=$(get_effective_working_target)
  remember_target "$t" || true
  if [[ "$t" == "mvp" ]]; then
    echo -e "${RED}Cannot map ${PUBLIC_MAIN_URL} to MVP via validate ngrok.${NC}"
    echo -e "  MVP is direct Azure access: ${BOLD}${MVP_UI_URL}${NC}"
    echo -e "  ${DIM}Set working target to local or staging, then re-run external-on.${NC}"
    return 1
  fi
  if ! confirm_ngrok_external_start "${PUBLIC_MAIN_URL} → working target ${t} (ngrok)"; then
    return 1
  fi
  echo -e "${CYAN}Starting external access for ${BOLD}${t}${NC}${CYAN} → ${PUBLIC_MAIN_URL}${NC}"
  apply_target_external "$t"
  local new_target new_u
  new_target=$(get_current_target)
  new_u=$(echo "$new_target" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo -e "${BOLD}External presenter (ngrok):${NC} ${GREEN}${new_u}${NC}"
  if [[ "$new_target" == "orphan" || "$new_target" == "none" || "$new_target" == "unknown" ]]; then
    echo -e "${YELLOW}Public URL may still be owned by another ngrok session (reserved domain is single-claim).${NC}"
    echo -e "${DIM}Hint: $(infer_public_backend_hint)${NC}"
  fi
}

advanced_validate_interactive() {
  echo ""
  echo -e "${BOLD}Advanced (slower):${NC}"
  echo -e "  ${GREEN}1)${NC} validate-staging.sh local"
  echo -e "  ${GREEN}2)${NC} validate-staging.sh staging"
  echo -e "  ${GREEN}3)${NC} validate-staging.sh (default)"
  echo -e "  ${GREEN}4)${NC} External gateway detail"
  echo -e "  ${GREEN}5)${NC} Comprehensive (git + standards + connectivity)"
  echo -e "  ${YELLOW}0)${NC} Back"
  echo ""
  echo -n -e "${BOLD}Choice: ${NC}"
  read -r a
  case "$a" in
    1) run_script "validate-staging.sh" "local" ;;
    2) run_script "validate-staging.sh" "staging" ;;
    3) run_script "validate-staging.sh" ;;
    4) check_external_gateway ;;
    5) run_comprehensive_check ;;
    0|back|q|quit) return 0 ;;
    *)
      echo -e "${RED}Invalid choice${NC}"
      return 1
      ;;
  esac
}

start_services() {
  local target="$1"
  case "$target" in
    local)
      start_local_services
      ;;
    external)
      local ext_target
      ext_target=$(prompt_target)
      [[ "$ext_target" == "back" || "$ext_target" == "invalid" ]] && return 1
      start_external_services "$ext_target"
      ;;
    staging)
      start_staging_services_remote
      ;;
    all)
      start_local_services
      start_external_services "all"
      start_staging_services_remote
      ;;
  esac
}

stop_services() {
  local target="$1"
  case "$target" in
    local)
      stop_local_dev_services
      ;;
    external)
      local ext_target
      ext_target=$(prompt_target)
      [[ "$ext_target" == "back" || "$ext_target" == "invalid" ]] && return 1
      stop_external_services "$ext_target"
      ;;
    staging)
      stop_staging_services_remote
      ;;
    all)
      stop_local_dev_services
      stop_external_services "all"
      stop_staging_services_remote
      ;;
  esac
}

complete_check() {
  local target="$1"
  case "$target" in
    local)
      if [[ -f "${SCRIPT_DIR}/validate-staging.sh" ]]; then
        run_script "validate-staging.sh" "local"
      else
        check_duplicate_dev_servers true
        check_local_services
      fi
      check_external_gateway
      ;;
    staging)
      check_staging_services_remote
      check_external_gateway
      ;;
    all)
      run_comprehensive_check
      check_external_gateway
      ;;
  esac
}

total_status() {
  echo -e "${BOLD}Total Status:${NC}"
  echo ""
  print_front_screen_status
  check_local_services
  echo ""
  check_staging_services_remote
  echo ""
  check_external_gateway
}

check_external_gateway() {
  echo -e "${BOLD}External Gateway (discuss ${PUBLIC_DEV_URL}):${NC}"
  local urls=("${PUBLIC_DEV_URL%/}/" "${PUBLIC_MAIN_URL%/}/" "${PUBLIC_SECONDARY_URL%/}/")
  echo -e ""
  echo -e "  ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod${NC}"
  printf "  %-34s  %-10s  %-8s  %s\n" "URL" "STATUS" "HTTP" "DETAILS"
  printf "  %-34s  %-10s  %-8s  %s\n" "----------------------------------" "----------" "--------" "----------------------------"
  for url in "${urls[@]}"; do
    local headers
    headers=$(curl -sI --max-time 8 "$url" 2>/dev/null || true)
    local code
    code=$(echo "$headers" | awk 'NR==1{print $2}')
    local gateway
    gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{print $2}')
    local ngrok
    ngrok=$(echo "$headers" | awk -F': ' 'tolower($1)=="ngrok-error-code"{print $2}')
    [[ -z "$code" ]] && code="000"
    local status="WARN"
    local detail="HTTP ${code}"
    if [[ "$code" == "000" ]]; then
      status="DOWN"
      detail="no response"
    elif [[ "$gateway" == "fallback" ]]; then
      status="HOLDING"
      detail="holding page"
    elif [[ "$gateway" == "proxied" && ( "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ) ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ]]; then
      status="UP"
      detail="app served (auth challenge OK)"
    elif [[ "$code" == "503" ]]; then
      status="HOLDING"
      detail="holding page"
    fi

    local status_color="$YELLOW"
    [[ "$status" == "UP" ]] && status_color="$GREEN"
    [[ "$status" == "DOWN" ]] && status_color="$RED"
    [[ "$status" == "HOLDING" ]] && status_color="$YELLOW"

    local details=""
    details="$detail"
    [[ -n "$gateway" ]] && details="${details}; gateway=${gateway}"
    [[ -n "$ngrok" ]] && details="${details}; ngrok=${ngrok}"

    printf "  %-34s  ${BOLD}%b%-10s${NC}  %-8s  %s\n" "$url" "$status_color" "$status" "$code" "$details"
  done
  echo ""
  echo -e "${DIM}Next steps:${NC}"
  echo -e "  ${DIM}- Prefer Start Demo (menu D / start-demo) → ${PUBLIC_DEV_URL}.${NC}"
  echo -e "  ${DIM}- If DOWN but you expect UP: start-core → Start Demo (or menu 5 for local↔MiniPC).${NC}"
  echo -e "  ${DIM}- Holding page = HTTP 503 + X-TaliaHub-Gateway: fallback (expected after external-off).${NC}"
}

check_external_gateway_quick() {
  echo -e "${BOLD}External gateway (quick — discuss ${PUBLIC_DEV_URL}):${NC}"
  echo -e "  ${DIM}dev = laptop discuss · MiniPC/Azure = prove · not customer prod${NC}"
  local urls=("${PUBLIC_DEV_URL%/}/" "${PUBLIC_MAIN_URL%/}/" "${PUBLIC_SECONDARY_URL%/}/")
  for url in "${urls[@]}"; do
    local headers code gateway status detail
    headers=$(curl -sI --max-time 4 "$url" 2>/dev/null || true)
    code=$(echo "$headers" | awk 'NR==1{print $2}')
    gateway=$(echo "$headers" | awk -F': ' 'tolower($1)=="x-taliahub-gateway"{gsub("\r","",$2); print $2; exit}')
    [[ -z "$code" ]] && code="000"
    status="WARN"
    detail="HTTP ${code}"
    if [[ "$code" == "000" ]]; then
      status="DOWN"
      detail="no response"
    elif [[ "$gateway" == "fallback" ]]; then
      status="HOLDING"
      detail="holding page"
    elif [[ "$gateway" == "proxied" && ( "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ) ]]; then
      status="UP"
      detail="app served"
    elif [[ "$code" == "200" || "$code" == "302" || "$code" == "401" || "$code" == "403" ]]; then
      status="UP"
      detail="app served (auth challenge OK)"
    elif [[ "$code" == "503" ]]; then
      status="HOLDING"
      detail="holding page"
    fi
    local status_color="$YELLOW"
    [[ "$status" == "UP" ]] && status_color="$GREEN"
    [[ "$status" == "DOWN" ]] && status_color="$RED"
    [[ "$status" == "HOLDING" ]] && status_color="$YELLOW"
    printf "  %-36s  ${BOLD}%b%-8s${NC}  %s  gateway=%s\n" "$url" "$status_color" "$status" "$detail" "${gateway:-n/a}"
  done
  echo ""
}

start_local_public_preview() {
  # Bundled vite preview for taliahub.com. Vite-dev module graph over ngrok stalls.
  local public_port="${LOCAL_PUBLIC_UI_PORT:-4173}"
  local public_url="http://${LOCAL_UI_HOST:-127.0.0.1}:${public_port}/"
  local ui_dir="${ROOT_DIR}/talia-ui"
  local dist_html="${ui_dir}/dist/index.html"

  if [[ ! -d "$ui_dir" ]]; then
    echo -e "  ${RED}Missing ${ui_dir}${NC}"
    return 1
  fi

  echo -e "  Building UI for public preview (VITE_ENABLE_DEV_MODE=true)..."
  if ! (cd "$ui_dir" && VITE_ENABLE_DEV_MODE=true npm run build >/tmp/talia-ui-preview-build.log 2>&1); then
    echo -e "  ${RED}UI build failed. See /tmp/talia-ui-preview-build.log${NC}"
    return 1
  fi
  if [[ ! -f "$dist_html" ]]; then
    echo -e "  ${RED}Build succeeded but ${dist_html} is missing${NC}"
    return 1
  fi

  local pids
  pids=$( { lsof -nP -iTCP:"${public_port}" -sTCP:LISTEN -t 2>/dev/null || true; } | tr '\n' ' ')
  if [[ -n "${pids// /}" ]]; then
    echo -e "  Restarting existing preview on :${public_port}..."
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    sleep 1
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
  fi

  echo -e "  Starting vite preview on :${public_port}..."
  # Fully detach so agent/short-lived shells do not reap the preview process.
  /bin/bash -lc "cd \"${ui_dir}\" && exec nohup npx vite preview --port ${public_port} --host --strictPort >/tmp/talia-ui-preview.log 2>&1 </dev/null" &
  local launcher_pid=$!
  sleep 1
  # Prefer the actual listener PID over the launcher
  local listen_pid
  listen_pid=$( { lsof -nP -iTCP:"${public_port}" -sTCP:LISTEN -t 2>/dev/null || true; } | head -1)
  if [[ -n "$listen_pid" ]]; then
    echo "$listen_pid" >/tmp/talia-ui-preview.pid
  elif [[ -n "$launcher_pid" ]]; then
    echo "$launcher_pid" >/tmp/talia-ui-preview.pid
  fi
  disown "$launcher_pid" 2>/dev/null || true

  local attempts=0
  local code="000"
  while [[ "$attempts" -lt 30 ]]; do
    code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$public_url" 2>/dev/null || echo "000")
    if [[ "$code" == "200" ]]; then
      echo -e "  ${GREEN}✓${NC} Public preview UP (${public_url})"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.5
  done
  echo -e "  ${RED}Preview not healthy on :${public_port} (HTTP ${code}). See /tmp/talia-ui-preview.log${NC}"
  return 1
}

ngrok_local_tunnel_addr() {
  curl -sS --max-time 2 http://127.0.0.1:4040/api/tunnels 2>/dev/null \
    | python3 -c '
import sys, json
try:
  d = json.load(sys.stdin)
  for t in d.get("tunnels", []):
    addr = (t.get("config") or {}).get("addr") or ""
    if addr:
      print(addr)
      break
except Exception:
  pass
' 2>/dev/null || true
}

start_ngrok_local() {
  local edit_port="${LOCAL_UI_PORT:-5173}"
  local public_port="${LOCAL_PUBLIC_UI_PORT:-4173}"
  local edit_health_url="${LOCAL_UI_URL%/}/"
  local public_health_url="${LOCAL_PUBLIC_UI_URL%/}/"

  if ! command -v ngrok >/dev/null 2>&1; then
    echo -e "${RED}ngrok not found on PATH. Install from https://ngrok.com/download${NC}"
    return 1
  fi

  echo -e "${BOLD}Local public presenter:${NC} vite preview :${public_port}"
  echo -e "  ${DIM}Discuss URL: ${PUBLIC_DEV_URL} (apex ${PUBLIC_MAIN_URL} shares the same tunnel)${NC}"
  echo -e "  ${DIM}Edit/HMR stays on :${edit_port} — do not tunnel Vite-dev over ngrok.${NC}"

  if ! start_local_public_preview; then
    return 1
  fi

  echo -n "  Edit UI (localhost:${edit_port}): "
  local edit_code
  edit_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$edit_health_url" 2>/dev/null || echo "000")
  if [[ "$edit_code" == "200" ]]; then
    echo -e "${GREEN}OK${NC}"
  else
    echo -e "${YELLOW}Not running${NC} ${DIM}(optional; start-core / npm run dev)${NC}"
  fi

  echo -n "  Public preview (localhost:${public_port}): "
  local preview_code
  preview_code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$public_health_url" 2>/dev/null || echo "000")
  [[ "$preview_code" == "200" ]] && echo -e "${GREEN}OK${NC}" || echo -e "${RED}DOWN${NC} (HTTP $preview_code)"

  local need_start=true
  if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
    local current_addr
    current_addr=$(ngrok_local_tunnel_addr)
    if [[ "$current_addr" == *":${public_port}"* || "$current_addr" == *"localhost:${public_port}"* ]]; then
      echo -e "  ${YELLOW}ngrok already running for ${LOCAL_NGROK_DOMAIN} → :${public_port}${NC}"
      need_start=false
    else
      echo -e "  Retargeting ngrok (${current_addr:-unknown} → :${public_port})..."
      pkill -f "ngrok .*${LOCAL_NGROK_DOMAIN}" 2>/dev/null || true
      sleep 2
    fi
  fi

  if $need_start; then
    echo -e "  Starting ngrok (${LOCAL_NGROK_DOMAIN} -> ${LOCAL_PUBLIC_UI_URL})..."
    # Fully detach so short-lived validate shells do not reap the tunnel.
    /bin/bash -lc "exec nohup ngrok http --url=${LOCAL_NGROK_DOMAIN} --pooling-enabled --basic-auth=${NGROK_BASIC_USER}:${NGROK_BASIC_PASS} ${public_port} >/tmp/ngrok-taliahub.log 2>&1 </dev/null" &
    local ngrok_launcher=$!
    sleep 1
    echo "$ngrok_launcher" >/tmp/ngrok-taliahub.pid
    disown "$ngrok_launcher" 2>/dev/null || true
    sleep 1
  fi

  echo -e "  Tunnel:"
  local tunnel_line=""
  local attempts=0
  while [[ "$attempts" -lt 8 ]]; do
    tunnel_line=$(curl -s http://localhost:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"[^"]*"' | head -1 || true)
    if [[ -n "$tunnel_line" ]]; then
      break
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  if [[ -n "$tunnel_line" ]]; then
    echo "  ${tunnel_line} → :${public_port}"
    local addr
    addr=$(ngrok_local_tunnel_addr)
    [[ -n "$addr" ]] && echo -e "  ${DIM}upstream ${addr}${NC}"
  else
    echo "  Not active"
    if [[ -f /tmp/ngrok-taliahub.log ]]; then
      echo "  See /tmp/ngrok-taliahub.log for details"
    fi
  fi
}

start_ngrok_staging_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok on staging (systemd)"
  else
    run_staging_ssh_command "sudo systemctl start ${STAGING_NGROK_SERVICE} && sleep 2 && sudo systemctl status ${STAGING_NGROK_SERVICE} --no-pager" "Start ngrok on staging (systemd)" "45"
  fi
}

stop_ngrok_staging_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}" "Stop ngrok on staging (systemd)"
    return $?
  fi
  # Soft-fail + short SSH probe: unreachable MiniPC must not abort external-off / local external-on.
  # Bypass check_staging_ssh_ready (multi-attempt) — one 2s probe is enough for remote/VPN.
  local probe
  probe=$(ssh_staging_with_timeout "${STAGING_STATUS_SSH_TIMEOUT_SEC}" "echo ok" | tr -d '\r' | awk 'NF{print; exit}')
  if [[ "$probe" != "ok" ]]; then
    echo -e "  ${YELLOW}Staging ngrok stop skipped — MiniPC SSH unreachable (${STAGING_SSH_TARGET}).${NC}"
    echo -e "  ${DIM}If MiniPC still owns ${LOCAL_NGROK_DOMAIN}, ${PUBLIC_MAIN_URL} stays live until that tunnel stops.${NC}"
    return 0
  fi
  if ssh_staging_with_timeout 8 "sudo -n systemctl stop ${STAGING_NGROK_SERVICE}" >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓${NC} Stopped ngrok on staging (systemd)"
    return 0
  fi
  echo -e "  ${YELLOW}Staging ngrok stop skipped/failed — SSH or remote error.${NC}"
  echo -e "  ${DIM}If MiniPC still owns ${LOCAL_NGROK_DOMAIN}, ${PUBLIC_MAIN_URL} stays live until that tunnel stops.${NC}"
  return 0
}

start_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl start ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d; docker compose -f docker-compose.staging.yml ps" "Start staging services (ngrok + docker)"
  else
    run_staging_ssh_command "sudo systemctl start ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d; docker compose -f docker-compose.staging.yml ps" "Start staging services (ngrok + docker)" "60"
  fi
}

stop_ngrok_local() {
  if pgrep -f "ngrok .*${LOCAL_NGROK_DOMAIN}" >/dev/null 2>&1; then
    echo -e "  Stopping local ngrok..."
    pkill -f "ngrok .*${LOCAL_NGROK_DOMAIN}" 2>/dev/null || true
  else
    echo -e "  ${DIM}ngrok not running locally${NC}"
  fi
}

stop_local_dev_services() {
  echo -e "${BOLD}Stopping local dev services (UI/API):${NC}"
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids=$(lsof -ti:5173,4000 2>/dev/null | tr '\n' ' ' | xargs)
    stop_port_processes "$pids" "processes on ports 5173/4000"
  else
    echo -e "  ${YELLOW}lsof not available; skipping port-based stop${NC}"
  fi
}

stop_local_services() {
  echo -e "${BOLD}Stopping local services:${NC}"
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids=$(lsof -ti:5173,4000 2>/dev/null | tr '\n' ' ' | xargs)
    stop_port_processes "$pids" "processes on ports 5173/4000"
  else
    echo -e "  ${YELLOW}lsof not available; skipping port-based stop${NC}"
  fi
  stop_ngrok_local
}

stop_staging_services_remote() {
  if $IS_ON_STAGING; then
    run_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging services (ngrok + docker)"
  else
    run_staging_ssh_command "sudo systemctl stop ${STAGING_NGROK_SERVICE}; cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging services (ngrok + docker)" "60"
  fi
}

start_staging_core_remote() {
  if $IS_ON_STAGING; then
    run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d && docker compose -f docker-compose.staging.yml ps" "Start staging core (Docker only, ngrok unchanged)"
  else
    run_staging_ssh_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml up -d && docker compose -f docker-compose.staging.yml ps" "Start staging core (Docker only, ngrok unchanged)" "60"
  fi
}

stop_staging_core_remote() {
  if $IS_ON_STAGING; then
    run_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging core (Docker only, ngrok unchanged)"
  else
    run_staging_ssh_command "cd ${STAGING_DIR} && docker compose -f docker-compose.staging.yml stop" "Stop staging core (Docker only, ngrok unchanged)" "60"
  fi
}

