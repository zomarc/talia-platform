{
  "defaultDataset": "sept-dec-2025",
  "tables": {
    "ships": {
      "type": "direct",
      "source": "dwh.Dim_Ship",
      "target": "ship",
      "columns": [
        "Ship_Id",
        "Ship_Code",
        "Ship_Name",
        "Ship_Pax_Capacity",
        "Ship_Length",
        "Ship_Tonnage"
      ],
      "transformKey": "ships",
      "defaultReplace": {
        "strategy": "delete-all",
        "column": "id"
      }
    },
    "cabinAvailability": {
      "type": "direct",
      "source": "dwh.Dim_Cabin_Availability",
      "target": "cabin_availability",
      "columns": [
        "[Snapshot_Date]",
        "[Sail_Code]",
        "[Package_Name]",
        "[Sail_Days]",
        "[Cabin_Category]",
        "[Available_Cabins]",
        "[Total_Cabins]",
        "[Available_Absolute]",
        "[Available_Weighted]",
        "[Availability_Result]",
        "[Nested_Cabins]"
      ],
      "transformKey": "cabinAvailability"
    },
    "reservations": {
      "type": "direct",
      "source": "stg.RES_HEADER",
      "target": "reservation",
      "columns": [
        "[RES_ID]",
        "[RES_STATUS]",
        "[SOURCE_CODE]",
        "[PROBABILITY]",
        "[RES_GUEST_COUNT]",
        "[SAIL_DATE_FROM]",
        "[SAIL_DATE_TO]",
        "[AGENCY_ID]",
        "[SEC_AGENCY_ID]",
        "[SHIP_CODE]",
        "[PACKAGE_TYPE]",
        "[CABIN_CATEGORY]",
        "[GROUP_ID]",
        "[CURRENCY_CODE]",
        "[CURRENCY_RATE]",
        "[LAST_UPDATED_AT]"
      ],
      "transformKey": "reservations",
      "isLargeDataset": true,
      "rowNumberOrder": [
        "[RES_ID]"
      ]
    },
    "publishedRates": {
      "type": "derived",
      "handler": "publishedRates",
      "source": "fou.GQL_PUBLISHED_RATES",
      "target": "published_rates_changes",
      "columns": [
        "[SNAPSHOT_DATE]",
        "[SAIL_CODE]",
        "[SHIP_CODE]",
        "[PACKAGE_NAME]",
        "[REGION]",
        "[RATE_TYPE]",
        "[SAIL_DAYS]",
        "[DEPARTURE_DATE]",
        "[CABIN_CATEGORY]",
        "[PROMO_NAME]",
        "[PROMO_TYPE]",
        "[CURRENCY_CODE]",
        "[FARE_PER_PERSON]",
        "[PORT_TAXES_SERVICES]",
        "[EXTRA_ADULT]",
        "[EXTRA_CHILD]",
        "[DISCOUNT]"
      ],
      "dateColumn": "SNAPSHOT_DATE",
      "supabaseDateColumn": "snapshot_date",
      "rowNumberOrder": [
        "[SNAPSHOT_DATE]",
        "[SAIL_CODE]",
        "[CABIN_CATEGORY]"
      ]
    },
    "sailByCabinOccupancy": {
      "type": "direct",
      "source": "dwh.Dim_Sail_By_Cabin_Occupancy",
      "target": "sail_by_cabin_occupancy",
      "columns": [
        "[Sail_ID]",
        "[Sail_Code]",
        "[Sail_Days]",
        "[Sail_Date_From]",
        "[Master_Voyage]",
        "[Sail_Itinerary_Date]",
        "[Sail_Itinerary_Night]",
        "[Port_Code]",
        "[Ship_Code]",
        "[Ship_name]",
        "[Package_Type]",
        "[Package_Name]",
        "[Geog_Area_Code]",
        "[Season_Code]",
        "[IS_Fake]",
        "[IS_Active]",
        "[IS_Package_Active]",
        "[Cabin_Category]",
        "[Cabin_Capacity]",
        "[Total_Cabins]",
        "[Occupied_Cabins]",
        "[Remaining_Cabins]"
      ],
      "transformKey": "sailByCabinOccupancy"
    },
    "reservationChanges": {
      "type": "derived",
      "handler": "reservationChanges",
      "source": "stg.RES_HEADER_SNAPSHOT",
      "target": "reservation_changes",
      "columns": [
        "Snapshot_Date",
        "RES_ID",
        "SHIP",
        "AGENCY_ID",
        "GROUP_ID",
        "RES_GUEST_COUNT",
        "RES_STATUS",
        "PROBABILITY",
        "CABIN_CATEGORY"
      ],
      "dateColumn": "Snapshot_Date",
      "supabaseDateColumn": "snapshot_date",
      "rowNumberOrder": [
        "[RES_ID]",
        "[Snapshot_Date]"
      ]
    },
    "masterSail": {
      "type": "direct",
      "source": "dwh.Dim_Master_Sail",
      "target": "master_sail",
      "columns": [
        "[Sail_ID]",
        "[Ship_Code]",
        "[Ship_Name]",
        "[Sail_Date_From]",
        "[Port_From]",
        "[Sail_Date_To]",
        "[Port_To]",
        "[Package_ID]",
        "[Package_Type]",
        "[Sail_Code]",
        "[Package_Name]",
        "[Sail_Days]",
        "[Geog_Area_Code]",
        "[Vacation_Date]",
        "[Season_Code]",
        "[IS_Fake]",
        "[IS_Active]",
        "[IS_Package_Active]",
        "[Master_Voyage_Departure_Date]",
        "[Master_Voyage1]",
        "[Master_Voyage1_Length]",
        "[Master_Voyage1_Sail_Days]",
        "[Master_Voyage2]",
        "[Master_Voyage2_Length]",
        "[Master_Voyage2_Sail_Days]",
        "[IS_Main]",
        "[IS_Primary]"
      ],
      "transformKey": "masterSail",
      "defaultReplace": {
        "strategy": "delete-range",
        "column": "sail_date_from"
      }
    },
    "competitor": {
      "type": "derived",
      "handler": "competitor",
      "source": "stg.COMPETITOR",
      "target": "competitor",
      "columns": [
        "Currency",
        "Departure_Date",
        "Duration",
        "Week_Number",
        "Year",
        "Lowest_Price",
        "Lowest_Inside",
        "Lowest_Outside",
        "Lowest_Balcony",
        "Lowest_Suite",
        "Taxes",
        "Cruise_Line",
        "Destination",
        "Cruise_Name",
        "Ship_Name",
        "Ports",
        "Market",
        "Source",
        "Snapshot_Date"
      ],
      "dateColumn": "Snapshot_Date",
      "supabaseDateColumn": "snapshot_date",
      "rowNumberOrder": [
        "[Snapshot_Date]",
        "[Departure_Date]",
        "[Cruise_Line]",
        "[Ship_Name]"
      ]
    },
    "reservationPromotion": {
      "type": "direct",
      "source": "stg.RES_PROMOTION",
      "target": "reservation_promotion",
      "columns": [
        "[RES_PROMO_ID]",
        "[RES_ID]",
        "[GUEST_ID]",
        "[PROMO_CODE]",
        "[IS_EXCLUDED]",
        "[IS_ACTIVE]",
        "[RES_PACKAGE_ID]",
        "[IS_MANUAL]",
        "[PROMO_VALUE]",
        "[PROMO_VALUE_TYPE]",
        "[IS_STATIC]"
      ],
      "transformKey": "reservationPromotion",
      "isLargeDataset": true,
      "rowNumberOrder": [
        "[RES_ID]",
        "[RES_PROMO_ID]"
      ]
    }
  },
  "datasets": {
    "sept-dec-2025": {
      "description": "Core sailing, reservation, and change data for September through December 2025",
      "tableSequence": [
        "ships",
        "masterSail",
        "cabinAvailability",
        "sailByCabinOccupancy",
        "reservations",
        "reservationPromotion",
        "publishedRates",
        "reservationChanges",
        "competitor"
      ],
      "tables": {
        "ships": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "cabinAvailability": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "reservations": {
          "filters": [
            {
              "column": "[SAIL_DATE_FROM]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_from_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "publishedRates": {
          "filters": [
            {
              "column": "[SNAPSHOT_DATE]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ]
        },
        "sailByCabinOccupancy": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "reservationChanges": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "competitor": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "reservationPromotion": {
          "filters": [
            {
              "column": "[RES_ID]",
              "operator": "subquery",
              "subquery": "SELECT RES_ID FROM stg.RES_HEADER WHERE SAIL_DATE_FROM >= '2025-09-01' AND SAIL_DATE_FROM <= '2025-12-31'"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "res_id",
            "joinTable": "reservation",
            "joinColumn": "res_id",
            "dateColumn": "sail_from_date",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        },
        "masterSail": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2025-09-01",
              "to": "2025-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2025-09-01",
            "to": "2025-12-31"
          }
        }
      }
    },
    "sept-dec-2024": {
      "description": "Previous year data for year-over-year comparison (September through December 2024)",
      "tableSequence": [
        "ships",
        "masterSail",
        "reservations",
        "reservationChanges"
      ],
      "tables": {
        "ships": {
          "replace": {
            "strategy": "delete-all",
            "column": "id"
          }
        },
        "reservations": {
          "filters": [
            {
              "column": "[SAIL_DATE_FROM]",
              "operator": "between",
              "from": "2024-09-01",
              "to": "2024-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_from_date",
            "from": "2024-09-01",
            "to": "2024-12-31"
          }
        },
        "reservationChanges": {
          "filters": [
            {
              "column": "[Snapshot_Date]",
              "operator": "between",
              "from": "2024-09-01",
              "to": "2024-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "snapshot_date",
            "from": "2024-09-01",
            "to": "2024-12-31"
          }
        },
        "masterSail": {
          "filters": [
            {
              "column": "[Sail_Date_From]",
              "operator": "between",
              "from": "2024-09-01",
              "to": "2024-12-31"
            }
          ],
          "replace": {
            "strategy": "delete-range",
            "column": "sail_date_from",
            "from": "2024-09-01",
            "to": "2024-12-31"
          }
        }
      }
    }
  }
}

